// Modal progress screen
{
    // Simple popup dialog base
    "simple_popup_dialog_base": {
        "size": ["100%", "100%"],
        "min_size": ["100%", "100%"],
        "max_size": ["100%", "100%"],
        "controls": [
            {
                "dialog@zk_oreui_design__dialogs.oreui_dialog_panel": {
                    "layer": 1,
                    "size": ["50%", "100%c"],
                    "max_size": ["50%", "100% - 16px"],
                    "$dialog_header_content": "progress.simple_popup_dialog_title",
                    "$dialog_body_content": "progress.simple_popup_dialog_body_content",
                    "$dialog_footer_content": "progress.simple_popup_dialog_footer_content",
                    "$show_close_button": false,
                    "$oreui_dialog_style__animate_popup": true
                }
            },
            {
                "black_background": {
                    "type": "image",
                    "texture": "textures/ui/screen_background",
                    "size": ["120%", "120%"],
                    "alpha": "$fill_alpha",
                    "anims": ["@popup_dialog.popup_anim_bg_fade"]
                }
            }
        ]
    },

    // Simple popup dialog title
    "simple_popup_dialog_title": {
        "type": "panel",
        "controls": [
            {
                "dialog_title_label_panel": {
                    "type": "panel",
                    "size": ["100%", 24],
                    "controls": [
                        {
                            "dialog_title": {
                                "type": "label",
                                "color": "$main_header_text_color",
                                "text": "$title_text",
                                "size": ["100% - 16px", "default"],
                                "max_size": ["100% - 16px", 20],
                                "text_alignment": "center"
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Simple popup dialog body content
    "simple_popup_dialog_body_content": {
        "type": "panel",
        "controls": [
            {
                "inner_controls": {
                    "type": "stack_panel",
                    "orientation": "vertical",
                    "size": ["100% - 16px", "100%c"],
                    "controls": [
                        {
                            "top_padding@common.empty_panel": {
                                "size": [8, 8]
                            }
                        },
                        {
                            "description": {
                                "type": "label",
                                "size": ["100%", "default"],
                                "color": "$body_text_color",
                                "text": "$description_text",
                                "text_alignment": "center",
                                "bindings": [
                                    {
                                        "binding_name": "$description_text"
                                    }
                                ]
                            }
                        },
                        {
                            "padding_2": {
                                "type": "panel",
                                "size": [0, 8],
                                "visible": "$has_second_line"
                            }
                        },
                        {
                            "description2": {
                                "type": "label",
                                "size": ["100%", "default"],
                                "color": "$body_text_color",
                                "text": "$description_text2",
                                "text_alignment": "center",
                                "ignored": "(not $has_second_line)",
                                "bindings": [
                                    {
                                        "binding_name": "$description_text2"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Simple popup dialog footer content
    "simple_popup_dialog_footer_content": {
        "type": "panel",
        "controls": [
            {
                "buttons_panel": {
                    "type": "stack_panel",
                    "orientation": "vertical",
                    "size": ["100%", "100%c"],
                    "$button_size": ["100%", 30],
                    "controls": [
                        {
                            "top_optional_button@common_buttons.zk_design:light_text_button": {
                                "visible": "$use_top_button",
                                "enabled": "$use_top_button",
                                "size": "$button_size",
                                "$pressed_button_name": "$top_button_press",
                                "$button_binding_condition": "once",
                                "$button_text_binding_type": "global",
                                "$button_text": "$top_button_text"
                            }
                        },
                        {
                            "padding_4": {
                                "type": "panel",
                                "size": [0, 2],
                                "visible": "$use_top_button"
                            }
                        },
                        {
                            "middle_button@common_buttons.zk_design:light_text_button": {
                                "size": "$button_size",
                                "$pressed_button_name": "$middle_button_press",
                                "$button_binding_condition": "once",
                                "$button_text_binding_type": "global",
                                "$button_text": "$middle_button_text"
                            }
                        },
                        {
                            "padding_5": {
                                "type": "panel",
                                "size": [0, 2]
                            }
                        },
                        {
                            "bottom_button@common_buttons.zk_design:light_text_button": {
                                "size": "$button_size",
                                "$pressed_button_name": "$bottom_button_press",
                                "$button_text": "$bottom_button_text"
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Progress loading bars
    "progress_loading_bars": {
        "disable_anim_fast_forward": true
    },

    // Fancy progress loading bars
    "fancy_progress_loading_bars": {
        "anchor_from": "bottom_middle",
        "anchor_to": "bottom_middle",
        "size": ["100% - 4px", 10],
        "offset": [0, -2],
        "$ignore_percentage_text|default": false,
        "$force_loading_bar_visible|default": false,
        "bindings": [
            {
                "ignored": "$force_loading_bar_visible",
                "binding_name": "#loading_bar_visible",
                "binding_name_override": "#visible"
            }
        ]
    },

    // Progress bar nub
    "progress_bar_nub": {
        "ignored": true
    },

    // Cancel button
    "cancel_button@common_buttons.zk_design:light_text_button": {
        "$pressed_button_name": "button.menu_exit",
        "$button_text": "#cancel_button_text",
        "$button_text_binding_type": "global",
        "size": [66, 26],
        "offset": [0, 0],
        "bindings": [
            {
                "binding_name": "#cancel_visible",
                "binding_name_override": "#visible"
            }
        ]
    },

    // Retry button
    "retry_button@common_buttons.zk_design:light_text_button": {
        "$pressed_button_name": "button.menu_retry",
        "$button_text": "gui.retry",
        "size": [66, 26],
        "offset": [50, 0],
        "bindings": [
            {
                "binding_name": "#retry_and_abort_visible",
                "binding_name_override": "#visible"
            }
        ]
    },

    // Abort button
    "abort_button@common_buttons.zk_design:light_text_button": {
        "$pressed_button_name": "button.menu_exit",
        "$button_text": "gui.cancel",
        "size": [66, 26],
        "offset": [-50, 0],
        "bindings": [
            {
                "binding_name": "#retry_and_abort_visible",
                "binding_name_override": "#visible"
            }
        ]
    },

    // Modal progress panel with cancel
    "modal_progress_panel_with_cancel": {
        "controls": [
            {
                "dialog_content@zk_oreui_design__dialogs.oreui_simple_dialog_panel": {
                    "size": ["100%", "100%cm"],
                    "$child_control": "progress.modal_progress_panel_content"
                }
            }
        ]
    },

    // Modal progress panel content
    "modal_progress_panel_content": {
        "type": "stack_panel",
        "orientation": "vertical",
        "size": ["100% - 8px", "100%c"],
        "controls": [
            {
                "padding_top@common.empty_panel": {
                    "size": [16, 16]
                }
            },
            {
                "title_panel@progress.modal_progress_title_panel": {}
            },
            {
                "loading_spinner_panel@common.empty_panel": {
                    "size": ["100%", "100%c + 8px"],
                    "bindings": [
                        {
                            "binding_name": "#bar_animation_visible",
                            "binding_name_override": "#visible"
                        }
                    ],
                    "controls": [
                        {
                            "progress_loading_spinner@progress.progress_loading_spinner": {
                                "offset": [0, 0],
                                "color": "$title_text_color",
                                "bindings": []
                            }
                        }
                    ]
                }
            },
            {
                "modal_button_panel@progress.modal_button_panel": {
                    "size": ["100%", "100%cm"]
                }
            },
            {
                "padding_bottom@common.empty_panel": {
                    "size": [16, 16]
                }
            }
        ]
    },

    // Modal progress title panel
    "modal_progress_title_panel": {
        "type": "stack_panel",
        "orientation": "vertical",
        "size": ["100%", "100%c"],
        "controls": [
            {
                "progress_title_text@progress.progress_screen_text": {
                    "size": ["100%", "default"],
                    "max_size": ["100%", 32],
                    "text_alignment": "center",
                    "text": "#title_text",
                    "color": "$zk_oreui_design:common_title_text_color",
                    "font_type": "MinecraftTen",
                    "font_scale_factor": 1.5,
                    "bindings": [
                        {
                            "binding_name": "#title_text"
                        }
                    ]
                }
            },
            {
                "padding_middle_0@common.empty_panel": {
                    "size": [6, 6]
                }
            },
            {
                "progress_bar_text@progress.progress_screen_text": {
                    "size": ["100%", "default"],
                    "max_size": ["100%", 30],
                    "text_alignment": "center",
                    "text": "#progress_text",
                    "color": "$zk_oreui_design:common_title_text_color",
                    "bindings": [
                        {
                            "binding_name": "#progress_text"
                        }
                    ]
                }
            },
            {
                "padding_middle_1@common.empty_panel": {
                    "size": [6, 6],
                    "bindings": [
                        {
                            "binding_name": "#loading_bar_visible",
                            "binding_name_override": "#visible"
                        }
                    ]
                }
            },
            {
                "progress_bar_panel@common.empty_panel": {
                    "size": ["100%", "100%c"],
                    "controls": [
                        {
                            "progress_bar@progress.progress_bar": {}
                        }
                    ]
                }
            }
        ]
    },

    // Modal progress screen
    "modal_progress_screen": {
        "$is_full_screen_layout": true
    },

    // Modal button panel with retry
    "modal_button_panel_with_retry": {
        "type": "panel",
        "size": ["100%", 26]
    },

    // Pickaxe animation
    "pick_axe_animation": {
        "anim_type": "flip_book",
        "initial_uv": [0, 0],
        "frame_count": 91,
        "frame_step": 10,
        "fps": 30,
        "reversible": false,
        "easing": "linear"
    },

    // Loading pickaxe icon
    "mine_chop_dig_icon": {
        "type": "image",
        "layer": 1,
        "texture": "textures/ui/mine_chop_dig_animation",
        "size": [30, 30],
        "uv_size": [10, 10],
        "uv": "@progress.pick_axe_animation",
        "color": [1, 1, 1, 1]
    },

    // Realms stories loading screen
    "realms_stories_loading_progress_screen": {
        "$screen_content": "progress.realms_loading_world_modal_progress_screen_content",
        "$screen_bg_content": "progress.realms_loading_background"
    },

    // World saving screen
    "world_saving_progress_screen": {
        "$ignore_percentage_text": true
    },

    // Overworld loading screen
    "overworld_loading_progress_screen": {
        "$force_loading_bar_visible": true,
        "$is_dimension_loading_screen": true
    },

    // Nether loading screen
    "nether_loading_progress_screen": {
        "$force_loading_bar_visible": true,
        "$is_dimension_loading_screen": true
    },

    // The End loading screen
    "theend_loading_progress_screen": {
        "$force_loading_bar_visible": true,
        "$is_dimension_loading_screen": true
    },

    // Title panel
    "title_panel": {
        "modifications": [
            {
                "control_name": "progress_bar",
                "operation": "remove"
            }
        ]
    },

    // Title panel text
    "title_panel/progress_title_text": {
        "font_type": "MinecraftTen",
        "font_scale_factor": 1.5,
        "shadow": true
    },

    // Loading title and status text
    "progress_title_panel": {
        "type": "stack_panel",
        "orientation": "vertical",
        "size": ["100%", "100%c + 8px"],
        "$text_alignment|default": "left",
        "anchor_from": "bottom_left",
        "anchor_to": "bottom_left",
        "controls": [
            {
                "progress_title_text@progress.progress_title_text": {
                    "size": ["100% - 90px", "default"],
                    "max_size": [720, "default"],
                    "text": "#title_text",
                    "text_alignment": "$text_alignment",
                    "font_type": "MinecraftTen",
                    "font_scale_factor": 1.5,
                    "shadow": true,
                    "bindings": [
                        {
                            "binding_name": "#title_text"
                        }
                    ]
                }
            },
            {
                "padding": {
                    "type": "panel",
                    "size": [2, 2]
                }
            },
            {
                "progress_bar_text@progress.progress_bar_text": {
                    "size": ["100% - 90px", "default"],
                    "max_size": [720, "default"],
                    "text": "#progress_text",
                    "text_alignment": "$text_alignment",
                    "shadow": true,
                    "localize": false,
                    "bindings": [
                        {
                            "binding_name": "#progress_text"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(not (#progress_text = ''))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            }
        ]
    },

    // Panel centerer
    "panel_centerer": {
        "type": "panel",
        "size": ["100%", "100%c"]
    },

    // Empty modal buttons
    "modal_button_empty_panel@progress.button_panel": {
        "controls": [
            {
                "panel@common.empty_panel_size_y_0": {}
            }
        ]
    },

    // World loading panel
    "world_modal_progress_panel": {
        "size": ["100%", "100%"],
        "anchor_from": "center",
        "anchor_to": "center",
        "$is_dimension_loading_screen|default": false,
        "$modal_button_panel_type|default": "progress.modal_button_empty_panel",
        "controls": [
            {
                "base_content": {
                    "type": "stack_panel",
                    "orientation": "vertical",
                    "size": ["100% - 32px", "100%c"],
                    "offset": [0, -12],
                    "anchor_from": "bottom_middle",
                    "anchor_to": "bottom_middle",
                    "controls": [
                        {
                            "padding_1": {
                                "type": "panel",
                                "size": [8, 8]
                            }
                        },
                        {
                            "modal_buttons@$modal_button_panel_type": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "size": ["100%", "100%c"]
                            }
                        },
                        {
                            "progress_title@progress.panel_centerer": {
                                "size": ["100%", "100%cm"],
                                "$progress_title_anims|default": [],
                                "variables": [
                                    {
                                        "requires": "($is_on_3p_server and $is_dimension_loading_screen)",
                                        "$progress_title_anims": ["@zk_server_notice.anim_nether_glitch_info_remove_loading_alpha_wait"]
                                    }
                                ],
                                "controls": [
                                    {
                                        "progress_title_panel@progress.progress_title_panel": {
                                            "anims": "$progress_title_anims",
                                            "propagate_alpha": true,
                                            "disable_anim_fast_forward": true
                                        }
                                    },
                                    {
                                        "stuck_loading_notice@zk_server_notice.nether_glitch_info_panel": {}
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "icon@progress.mine_chop_dig_icon": {
                    "anchor_from": "bottom_right",
                    "anchor_to": "bottom_right",
                    "offset": [-16, -16],
                    "bindings": [
                        {
                            "binding_name": "(not #auto_save_animation_visible)",
                            "binding_name_override": "#visible"
                        }
                    ]
                }
            },
            {
                "loading_progress_label": {
                    "type": "panel",
                    "size": ["100%cm", "100%cm"],
                    "anchor_from": "bottom_right",
                    "anchor_to": "bottom_right",
                    "offset": [-46, -24],
                    "$force_loading_bar_visible|default": false,
                    "bindings": [
                        {
                            "ignored": "$force_loading_bar_visible",
                            "binding_name": "#loading_bar_visible",
                            "binding_name_override": "#visible"
                        }
                    ],
                    "controls": [
                        {
                            "loading_progress_label@zk_percentage.progress_percentage_label_template": {
                                "$show_trailing_zeros_in_percentage_labels": true,
                                "$progress_binding_source_control": "loading_progress_data",
                                "$progress_binding_source_property": "#loading_progress_percentage",
                                "$percentage_text_shadow": true,
                                "layer": 2
                            }
                        },
                        {
                            "loading_progress_data": {
                                "type": "panel",
                                "size": [0, 0],
                                "anchor_from": "top_right",
                                "anchor_to": "bottom_right",
                                "bindings": [
                                    {
                                        "binding_name": "#loading_bar_current_amount",
                                        "binding_condition": "always"
                                    },
                                    {
                                        "binding_name": "#loading_bar_total_amount",
                                        "binding_condition": "always"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(1 - (#loading_bar_current_amount / #loading_bar_total_amount))",
                                        "target_property_name": "#loading_progress_percentage"
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "fancy_progress_loading_bars@progress.fancy_progress_loading_bars": {}
            }
        ]
    },

    // World convert loading panel
    "world_convert_modal_progress_screen_content/world_modal_progress_panel": {
        "$modal_button_panel_type": "progress.modal_button_panel"
    },

    // World save loading panel
    "world_save_modal_progress_screen_content/world_modal_progress_panel": {
        "$modal_button_panel_type": "progress.modal_button_panel_with_retry"
    },

    // Progress screen
    "progress_screen": {
        "$screen_bg_content": "progress.progress_gradient_background"
    },

    // Bottom gradient background
    "progress_gradient_background": {
        "type": "panel",
        "controls": [
            {
                "background_gradient": {
                    "ignored": "$is_holographic",
                    "type": "custom",
                    "renderer": "gradient_renderer",
                    "layer": 1,
                    "color1": [0, 0, 0, 0],
                    "color2": [0, 0, 0, 0.7],
                    "size": ["100%", 100],
                    "anchor_from": "bottom_middle",
                    "anchor_to": "bottom_middle"
                }
            }
        ]
    },

    // World save icon
    "world_save_modal_progress_screen_content/save_icon": {
        "anchor_from": "bottom_right",
        "anchor_to": "bottom_right",
        "offset": [-16, -20]
    },

    // Mobile data icon
    "mobile_data_icon": {
        "layer": 2
    }
}

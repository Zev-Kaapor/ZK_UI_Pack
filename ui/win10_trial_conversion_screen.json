// Trial conversion screen hosting the about screen
{
    // Screen
    "win10_trial_conversion_screen": {
        "$screen_content": "zk_about_common.zk_about_content",
        "$use_custom_panorama": "$is_pregame",
        "$screen_panel|default": "$screen_content",
        "$screen_bg_panel|default": "$screen_bg_content",
        "$is_full_screen_layout": true,
        "force_render_below": false,
        "variables": [
            {
                "requires": "(not ($screen_content = 'zk_about_common.zk_about_content'))",
                "$screen_content": "zk_about_common.zk_about_content_multiscreen",
                "$screen_bg_content": "zk_about_common.zk_about_bg_multiscreen",
                "$header_safezone_control": "zk_about_common.zk_about_header_safezone_control_multiscreen",
                "$header_bar_control": "zk_about_common.zk_about_header_bar_control_multiscreen",
                "$force_render_below": false,
                "$store_top_bar_size": ["100%", 23]
            },
            {
                "requires": "($screen_content = 'zk_about_common.zk_about_content')",
                "$header_safezone_control": "common_store.store_top_bar_filler",
                "$header_bar_control": "common_store.store_top_bar",
                "$screen_bg_content": "common.screen_background",
                "$screen_helpers_content": "zk_about_common.dynamic_helpers_content"
            }
        ],
        "button_mappings": [
            {
                "from_button_id": "button.menu_cancel",
                "to_button_id": "button.menu_exit",
                "mapping_type": "global"
            },
            {
                "from_button_id": "button.menu_tab_left",
                "to_button_id": "button.menu_tab_left",
                "mapping_type": "global",
                "scope": "view"
            },
            {
                "from_button_id": "button.menu_tab_right",
                "to_button_id": "button.menu_tab_right",
                "mapping_type": "global",
                "scope": "view"
            }
        ]
    }
}

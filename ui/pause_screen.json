{
  // Skin viewer
  "skin_viewer_panel": {
    "$skin_viewer_panel_offset|default": [ 0, 0 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [ "100%", "150px" ]
  },

  "skin_viewer_panel/paper_doll_panel/paper_doll": {
    "starting_rotation": -30,
    "anchor_from": "center",
    "anchor_to": "center"
  },

  "skin_viewer_panel/paper_doll_name_tag": {
    "anchor_to": "top_middle",
    "offset": [ 0, 0 ]
  },

  // Main buttons
  "pause_button_template@common_buttons.zk_design:light_text_button": {
    "size": [ "100%", 24 ],
    "focus_identifier": "$pressed_button_name",
    "focus_change_right": "$focus_override_right",
    "focus_change_left": "$pressed_button_name"
  },

  "realms_stories_button_panel": {
    "size": [ "100%", 24 ]
  },

  "store_button_panel": {
    "ignored": "(not $is_on_3p_server)",
    "size": [ "100%", 24 ]
  },

  "quit_button": {
    "ignored": "$pause_quit_confirmation_popup_enabled",
    "modifications": [
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": [
          {
            "requires": "$is_on_3p_server",
            "$button_text": "menu.disconnect"
          }
        ]
      }
    ]
  },

  "zk_pause_centering_main_button": {
    "$button_controls|default": "common.empty_panel",
    "type": "panel",
    "size": [ "100%", "100%c + 2px" ],
    "controls": [
      {
        "button@$button_controls": {}
      }
    ]
  },

  "zk_pause_quit_buttons": {
    "type": "panel",
    "size": [ "100%", 24 ],
    "controls": [
      {
        "quit_button@pause.quit_button": {}
      },
      {
        "quit_popup_toggle@zk_pause_quit_confirm.quit_popup_toggle": {
          "size": [ "100%", 24 ],
          "$default_texture": "textures/ui/zk_oreui_design/buttons/button_borderless_red",
          "$hover_texture": "textures/ui/zk_oreui_design/buttons/button_borderless_red",
          "$pressed_texture": "textures/ui/zk_oreui_design/buttons/button_borderless_redhover",
          "$pressed_no_hover_texture": "textures/ui/zk_oreui_design/buttons/button_borderless_redhover",
          "$default_text_color": "$zk_oreui_design:red_button_default_text_color",
          "$hover_text_color": "$zk_oreui_design:red_button_hover_text_color",
          "$default_checked_text_color": "$zk_oreui_design:red_button_default_text_color",
          "$hover_checked_text_color": "$zk_oreui_design:red_button_hover_text_color"
        }
      }
    ]
  },

  "zk_pause_main_buttons": {
    "type": "stack_panel",
    "size": [ "40%", "100%c" ],
    "max_size": [ 275, "100%c" ],
    "controls": [
      {
        "return_to_game_button@pause.zk_pause_centering_main_button": {
          "$button_controls": "pause.return_to_game_button"
        }
      },
      {
        "realms_button_panel@pause.zk_pause_centering_main_button": {
          "$button_controls": "pause.realms_stories_button_panel",
          "bindings": [
            {
              "binding_name": "#realms_stories_button_primary_visible",
              "binding_name_override": "#visible",
              "binding_type": "global"
            }
          ]
        }
      },
      {
        "settings_button@pause.zk_pause_centering_main_button": {
          "$button_controls": "pause.settings_button"
        }
      },
      {
        "store_button_panel@pause.zk_pause_centering_main_button": {
          "$button_controls": "pause.store_button_panel",
          "ignored": "(not $is_on_3p_server)"
        }
      },
      {
        "quit_button_panel@pause.zk_pause_centering_main_button": {
          "$button_controls": "pause.zk_pause_quit_buttons"
        }
      }
    ]
  },

  // Logo
  "zk_pause_logo_panel": {
    "type": "panel",
    "size": [ "100% - 64px", "20%" ],
    "offset": [ 0, "2%" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "controls": [
      {
        "logo@common_art.pause_logo_panel": {}
      }
    ]
  },

  // Icon buttons
  "zk_pause_centering_icon_button": {
    "$button_controls|default": "common.empty_panel",
    "type": "input_panel",
    "size": [ "100%c + 6px", 24 ],
    "controls": [
      {
        "button@$button_controls": {
          "size": [ 24, 24 ]
        }
      }
    ]
  },

  "zk_pause_game_paused_panel": {
    "type": "image",
    "texture": "textures/ui/Black",
    "alpha": 0.55,
    "size": [ "100%c + 12px", 24 ],
    "controls": [
      {
        "text@pause.paused_text": {
          "layer": 2,
          "size": [ "default", 10 ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#pause_annoucement_visible",
        "binding_name_override": "#visible",
        "binding_type": "global"
      }
    ]
  },

  // Show and hide toggle
  "zk_pause_content_toggle@common_toggles.light_content_toggle": {
    "$toggle_name": "zk_pause_content_toggle",
    "$toggle_view_binding_name": "zk_pause_content_toggle",
    "$button_content": "pause.zk_pause_content_toggle_button_content",
    "$toggle_tts_toggle_on_text": "",
    "$toggle_tts_toggle_off_text": "",
    "size": [ 24, 24 ]
  },

  "zk_pause_content_toggle_button_content": {
    "type": "panel",
    "controls": [
      {
        "eye_opened": {
          "ignored": "$pressed_state",
          "type": "image",
          "texture": "textures/ui/eye_opened_glyph",
          "size": [ 12, 12 ]
        }
      },
      {
        "eye_closed": {
          "ignored": "(not $pressed_state)",
          "type": "image",
          "texture": "textures/ui/eye_closed_glyph",
          "size": [ 12, 12 ]
        }
      }
    ]
  },

  "zk_pause_hidden_content": {
    "type": "panel",
    "controls": [
      {
        "status_panel@pause.zk_pause_status_panel": {}
      }
    ]
  },

  // World title
  "zk_pause_world_title_panel": {
    "type": "image",
    "texture": "textures/ui/Black",
    "alpha": 0.55,
    "size": [ "100%c + 12px", 24 ],
    "controls": [
      {
        "title_stack": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%c", "100%" ],
          "use_child_anchors": true,
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "icon_panel": {
                "type": "panel",
                "size": [ 16, 16 ],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "controls": [
                  {
                    "title_icons@zk_pause_title.title_icons": {}
                  }
                ]
              }
            },
            {
              "padding": {
                "type": "panel",
                "size": [ 4, 4 ]
              }
            },
            {
              "world_name": {
                "type": "label",
                "text": "#text",
                "size": [ "default", "default" ],
                "max_size": [ 160, "default" ],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "layer": 2,
                "shadow": true,
                "bindings": [
                  {
                    "binding_name": "#players_list_title"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "('§r' + #players_list_title - '§l')",
                    "target_property_name": "#text"
                  }
                ]
              }
            },
            {
              "info_wrapper": {
                "type": "panel",
                "size": [ "100%c + 4px", "100%" ],
                "controls": [
                  {
                    "info_panels@zk_pause_title.info_panels": {
                      "size": [ "100%cm", "100%c" ],
                      "anchor_from": "top_right",
                      "anchor_to": "top_right"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  // Status
  "zk_pause_status_panel": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ "100%c", 24 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [ -7, -2 ],
    "layer": 2,
    "use_child_anchors": true,
    "controls": [
      {
        "game_paused_panel@pause.zk_pause_game_paused_panel": {
          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": [ 4, 4 ],
          "bindings": [
            {
              "binding_name": "#pause_annoucement_visible",
              "binding_name_override": "#visible",
              "binding_type": "global"
            }
          ]
        }
      },
      {
        "world_title_panel@pause.zk_pause_world_title_panel": {
          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      }
    ]
  },

  "zk_pause_icon_bar": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "layer": 2,
    "size": [ "100% - 8px", "100%cm" ],
    "$achievements_ignored|default": false,
    "controls": [
      {
        "hide_content_spacer": {
          "type": "panel",
          "size": [ 30, 24 ]
        }
      },
      {
        "profile_btn@pause.zk_pause_centering_icon_button": {
          "controls": [
            {
              "profile_button@pause.profile_button": {}
            }
          ],
          "bindings": [
            {
              "binding_name": "#profile_button_a_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "dressing_room_btn@pause.zk_pause_centering_icon_button": {
          "controls": [
            {
              "dressing_room_button@pause.dressing_room_button": {
                "anchor_from": "center",
                "anchor_to": "center",
                "offset": [ 0, 0 ]
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#dressing_room_button_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "achievements_btn@pause.zk_pause_centering_icon_button": {
          "ignored": "$achievements_ignored",
          "$button_controls": "pause.achievements_button_small_with_tooltip",
          "bindings": [
            {
              "binding_name": "#achievements_visible",
              "binding_name_override": "#visible",
              "binding_type": "global"
            }
          ],
          "button_mappings": [
            {
              "from_button_id": "button.controller_secondary_select",
              "to_button_id": "button.menu_achievements",
              "mapping_type": "global",
              "scope": "controller"
            }
          ]
        }
      },
      {
        "take_screenshot_btn": {
          "type": "input_panel",
          "size": [ "100%c + 6px", 24 ],
          "controls": [
            {
              "take_screenshot_button@pause.take_screenshot_button_with_tooltip": {}
            },
            {
              "take_screenshot_gamepad_button@pause.take_screenshot_gamepad_button_with_tooltip": {}
            }
          ],
          "bindings": [
            {
              "binding_name": "#screenshot_button_visible",
              "binding_name_override": "#visible",
              "binding_type": "global"
            }
          ],
          "button_mappings": [
            {
              "from_button_id": "button.controller_secondary_select",
              "to_button_id": "button.screenshot",
              "mapping_type": "global",
              "scope": "controller"
            }
          ]
        }
      },
      {
        "how_to_play_btn@pause.zk_pause_centering_icon_button": {
          "$button_controls": "pause.how_to_play_button_small_with_tooltip",
          "button_mappings": [
            {
              "from_button_id": "button.controller_secondary_select",
              "to_button_id": "button.menu_how_to_play",
              "mapping_type": "global",
              "scope": "controller"
            }
          ]
        }
      },
      {
        "zk_about_btn@pause.zk_pause_centering_icon_button": {
          "$button_controls": "pause.zk_about_icon_button"
        }
      },
      {
        "store_btn@pause.zk_pause_centering_icon_button": {
          "ignored": "($is_on_3p_server or $is_secondary_client or $is_editor_mode_enabled or $is_editor_playtest_roundtrip)",
          "$button_controls": "pause.store_button_small_with_tooltip",
          "bindings": [
            {
              "binding_name": "#store_button_secondary_visible",
              "binding_name_override": "#visible",
              "binding_type": "global"
            }
          ]
        }
      }
    ]
  },

  "zk_pause_icon_bar_panel": {
    "type": "panel",
    "size": [ "100%", "100%c + 4px" ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "controls": [
      {
        "buttons@pause.zk_pause_icon_bar": {}
      }
    ]
  },

  // Trial timer
  "zk_pause_trial_timer": {
    "ignored": "(not $trial)",
    "type": "custom",
    "renderer": "trial_time_renderer",
    "size": [ "default", 10 ],
    "offset": [ 0, 4 ],
    "layer": 3,
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "bindings": [
      {
        "binding_name": "#is_trial_version",
        "binding_name_override": "#visible",
        "binding_type": "global"
      }
    ]
  },

  // Menu content
  "zk_pause_menu_content": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "screen_background@common.screen_background": {
          "$screen_background_alpha": 0.45,
          "size": [ "150%", "150%" ]
        }
      },
      {
        "skin_viewer_holder": {
          "type": "panel",
          "size": [ "30%", "100%" ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "controls": [
            {
              "viewer_panel@pause.skin_viewer_panel": {
                "max_size": [ 130, 150 ]
              }
            }
          ]
        }
      },
      {
        "main_buttons@pause.zk_pause_main_buttons": {}
      },
      {
        "logo_panel@pause.zk_pause_logo_panel": {}
      },
      {
        "icon_buttons@pause.zk_pause_icon_bar_panel": {}
      },
      {
        "status_panel@pause.zk_pause_status_panel": {}
      },
      {
        "trial_timer@pause.zk_pause_trial_timer": {}
      },
      {
        "top_right_panel@pause.top_right_panel": {}
      }
    ]
  },

  "top_right_panel": {
    "modifications": [
      {
        "control_name": "pause_panel",
        "operation": "remove"
      }
    ]
  },

  // About button
  "zk_about_icon": {
    "type": "image",
    "texture": "textures/ui/zk_about_icon",
    "size": [ 16, 16 ],
    "layer": 3,
    "variables": [
      {
        "requires": "$is_zeqa",
        "$tip_label_control": "pause.zk_custom_screen_available_tip_label_switcher_for_zeqa"
      }
    ],
    "controls": [
      {
        "zk_custom_screen_available_panel@zk_common.zk_custom_screen_available_panel": {}
      }
    ]
  },

  "zk_custom_screen_available_tip_label_switcher_for_zeqa": {
    "type": "panel",
    "size": [ "100%cm", "100%cm" ],
    "controls": [
      {
        "default_tip_label": {
          "type": "label",
          "text": "$tooltip_text",
          "color": "$body_text_color",
          "bindings": [
            {
              "binding_name": "#players_list_title"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#players_list_title - 'Zeqa Practice' = #players_list_title) or (#players_list_title - 'Zeqa Network' = #players_list_title))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "zeqa_server_tip_label": {
          "type": "label",
          "text": "zkAbout.customAvailable.zeqa",
          "color": "$body_text_color",
          "bindings": [
            {
              "binding_name": "#players_list_title"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#players_list_title - 'Zeqa Practice' = #players_list_title) or (#players_list_title - 'Zeqa Network' = #players_list_title)))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  "zk_about_button@common_buttons.light_content_button": {
    "size": [ 24, 24 ],
    "$button_content": "pause.zk_about_icon",
    "$pressed_button_name": "button.menu_buy_game"
  },

  "zk_about_icon_button": {
    "type": "panel",
    "$button_tts_header": "zkAbout.about",
    "controls": [
      {
        "zk_about_button@pause.zk_about_button": {}
      }
    ]
  },

  "pause_screen": {
    "$is_full_screen_layout": true,
    "$force_render_below": true,
    "cache_screen": false,
    "$screen_helpers_content": "pause.pause_screen_helpers_content",
    "$fade_to_left_animations|default": [
      "@zk_anims.fade_left_entrance_animation_push_offset",
      "@zk_anims.fade_left_entrance_animation_pop_offset",
      "@zk_anims.fade_left_exit_animation_push_offset",
      "@zk_anims.fade_left_exit_animation_pop_offset"
    ],
    "$fade_to_right_animations|default": [
      "@zk_anims.fade_right_entrance_animation_push_offset",
      "@zk_anims.fade_right_entrance_animation_pop_offset",
      "@zk_anims.fade_right_exit_animation_push_offset",
      "@zk_anims.fade_right_exit_animation_pop_offset"
    ],
    "$fade_to_left_anim_end_point": [ -300, 0 ],
    "$fade_to_right_anim_end_point": [ 300, 0 ],
    "modifications": [
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": [
          {
            "requires": "$zk_ui_troubleshooting_mode",
            "$pause_quit_confirmation_popup_enabled": false
          }
        ]
      }
    ]
  },

  "pause_screen_content": {
    "$pause_quit_confirmation_popup_enabled|default": true,
    "$is_zeqa|default": false,
    "controls": [
      {
        "content@pause.zk_pause_menu_content": {
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "zk_pause_content_toggle",
              "source_property_name": "(not #toggle_state)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "content_hidden@pause.zk_pause_hidden_content": {
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "zk_pause_content_toggle",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "hide_content_toggle@pause.zk_pause_content_toggle": {
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "offset": [ 7, -2 ],
          "layer": 5
        }
      },
      {
        "gamepad_helpers@pause.gamepad_helpers": {}
      },
      {
        "keyboard_helpers@pause.keyboard_helpers": {}
      },
      {
        "debug_drawer_button_panel@pause.debug_drawer_button_panel": {
          "$focus_id": "debug_drawer_button",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [ -50, 3 ]
        }
      },
      {
        "quit_popup@zk_pause_quit_confirm.quit_popup": {
          "ignored": "(not $pause_quit_confirmation_popup_enabled)"
        }
      }
    ]
  },

  "paused_text": {
    "shadow": true
  },

  "pause_screen_helpers_content": {
    "type": "panel",
    "size": [ "100%", "100%cm" ],
    "controls": [
      {
        "left_helpers": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%c", "100%cm" ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "controls": [
            {
              "gamepad_helper_select@common.gamepad_helper_select": {
                "$icon_description_bind": "controller.buttonTip.togglePlayerList"
              }
            }
          ]
        }
      },
      {
        "right_helpers": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%c", "100%cm" ],
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "controls": [
            {
              "gamepad_helper_x_wrapper": {
                "type": "panel",
                "size": [ "100%cm", "100%cm" ],
                "bindings": [
                  {
                    "binding_name": "#gamepad_helper_visible",
                    "binding_name_override": "#visible"
                  }
                ],
                "controls": [
                  {
                    "gamepad_helper_x_dressing_room@common.gamepad_helper_x": {
                      "$icon_description_bind": "profileScreen.header",
                      "bindings": [
                        {
                          "binding_name": "#can_change_skin",
                          "binding_name_override": "#visible"
                        }
                      ]
                    }
                  },
                  {
                    "gamepad_helper_x_profile@common.gamepad_helper_x": {
                      "$icon_description_bind": "profileScreen.header",
                      "bindings": [
                        {
                          "binding_name": "#profile_button_x_icon_visible",
                          "binding_name_override": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "gamepad_helper_y@common.gamepad_helper_y": {
                "ignored": "(not ($win10_edition and $is_holographic))"
              }
            },
            {
              "gamepad_helper_a@common.gamepad_helper_a": {}
            },
            {
              "gamepad_helper_b@common.gamepad_helper_b": {}
            }
          ]
        }
      }
    ]
  }
}

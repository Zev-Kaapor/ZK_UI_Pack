// Trading screen
{

    // Right panel
    "right_panel": {
        "$container_item_mode_supported": true,
        "$button_ref": "zk_container_item_mode.item_button_ref",
        "$default_mode_controls": "common.container_slot_button_prototype",
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_front",
                "value": [
                    {
                        "level_up_target_text@zk_trade2.level_up_target_text": {}
                    },
                    {
                        "hover_fix@zk_hoverFix.button": {}
                    }
                ]
            },
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "container_item_mode_switch_panel@zk_container_item_mode.container_item_mode_switch_panel": {
                            "ignored": "$pocket_screen",
                            "$toggle_panel": "zk_container_item_mode.container_item_mode_switch_right_tab",
                            "$panel_anchor_from": "top_right",
                            "$panel_anchor_to": "top_left",
                            "$panel_offset": [-4, 0],
                            "$hover_text_anchor": "right_middle",
                            "$hover_text_offset": [-8, 2]
                        }
                    },
                    {
                        "container_item_type_switch_holder@zk_container_item_mode.container_item_type_switch_holder": {
                            "ignored": "$pocket_screen",
                            "layer": 10,
                            "$toggle_anchor_from": "bottom_right",
                            "$toggle_anchor_to": "bottom_right",
                            "$toggle_offset": [-8, -80]
                        }
                    }
                ]
            }
        ]
    },

    // Screen stack panel
    "screen_stack_panel": {
        "modifications": [
            {
                "control_name": "left_panel",
                "operation": "replace",
                "value": {
                    "trade_utils_left_panel@zk_trade2.trade_utils_left_panel": {}
                }
            }
        ]
    },

    // Top half stack panel
    "top_half_stack_panel": {
        "modifications": [
            {
                "control_name": "how_to_play_button_holder",
                "operation": "remove"
            }
        ]
    },

    // Top half stack panel trade button holder
    "top_half_stack_panel/trade_button_holder": {
        "size": [48, 18],
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": {
                    "quick_craft_button@zk_trade2.quick_trade_button": {}
                }
            }
        ]
    }
}

// Chest, ender chest, shulker box and barrel screens
{

    // Small chest root panel
    "small_chest_panel/root_panel": {
        "$container_item_mode_supported": true,
        "$button_ref": "zk_container_item_mode.item_button_ref",
        "$default_mode_controls": "common.container_slot_button_prototype",
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "container_item_mode_switch_panel@zk_container_item_mode.container_item_mode_switch_panel": {
                            "ignored": "$pocket_screen",
                            "$toggle_panel": "zk_container_item_mode.container_item_mode_switch_right_tab",
                            "$panel_anchor_from": "top_right",
                            "$panel_anchor_to": "top_left",
                            "$panel_offset": [-4, 0],
                            "$hover_text_anchor": "right_middle",
                            "$hover_text_offset": [-8, 2]
                        }
                    },
                    {
                        "container_item_type_switch_holder@zk_container_item_mode.container_item_type_switch_holder": {
                            "ignored": "$pocket_screen",
                            "layer": 10,
                            "$toggle_anchor_from": "top_right",
                            "$toggle_anchor_to": "top_right",
                            "$toggle_offset": [-22, 9]
                        }
                    },
                    {
                        "bulk_move_tabs@zk_container_bulk_move.bulk_move_tabs": {
                            "ignored": "$pocket_screen"
                        }
                    }
                ]
            }
        ]
    },

    // Small chest panel
    "small_chest_panel": {
        "$zk_item_lore_viewer:container_items_collection_length": 27,
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "item_lore_viewer@zk_item_lore_viewer.item_lore_viewer": {}
                    }
                ]
            }
        ]
    },

    // Large chest root panel
    "large_chest_panel/root_panel": {
        "$container_item_mode_supported": true,
        "$button_ref": "zk_container_item_mode.item_button_ref",
        "$default_mode_controls": "common.container_slot_button_prototype",
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "container_item_mode_switch_panel@zk_container_item_mode.container_item_mode_switch_panel": {
                            "ignored": "$pocket_screen",
                            "$toggle_panel": "zk_container_item_mode.container_item_mode_switch_right_tab",
                            "$panel_anchor_from": "top_right",
                            "$panel_anchor_to": "top_left",
                            "$panel_offset": [-4, 0],
                            "$hover_text_anchor": "right_middle",
                            "$hover_text_offset": [-8, 2]
                        }
                    },
                    {
                        "container_item_type_switch_holder@zk_container_item_mode.container_item_type_switch_holder": {
                            "ignored": "$pocket_screen",
                            "layer": 10,
                            "$toggle_anchor_from": "top_right",
                            "$toggle_anchor_to": "top_right",
                            "$toggle_offset": [-22, 9]
                        }
                    },
                    {
                        "bulk_move_tabs@zk_container_bulk_move.bulk_move_tabs": {
                            "ignored": "$pocket_screen"
                        }
                    }
                ]
            }
        ]
    },

    // Large chest panel
    "large_chest_panel": {
        "$zk_item_lore_viewer:container_items_collection_length": 54,
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "item_lore_viewer@zk_item_lore_viewer.item_lore_viewer": {}
                    }
                ]
            }
        ]
    }
}

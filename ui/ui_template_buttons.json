// Button templates
{
    // Light content anims
    "light_content_anims@common_buttons.light_content_button": {
        "$pressed_button_name": "button.nothin",
        "button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "pressed"
            },
            {
                "to_button_id": "$pressed_button_name",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "focused"
            }
        ]
    },

    // Focus border
    "focus_border": {
        "$focus_border_anchor_from|default": "center",
        "$focus_border_anchor_to|default": "center",
        "anchor_from": "$focus_border_anchor_from",
        "anchor_to": "$focus_border_anchor_to"
    },

    // Light content button
    "light_content_button": {
        "$hide_all_border|default": false,
        "variables": [
            {
                "requires": "$hide_all_border",
                "$default_state_border_visible": false,
                "$hover_state_border_visible": false,
                "$pressed_state_border_visible": false,
                "$locked_state_border_visible": false
            }
        ]
    },

    // New ui binding button label
    "new_ui_binding_button_label": {
        "shadow": "$button_pabel_shadow",
        "$button_pabel_shadow|default": false
    },

    // New ui button panel
    "new_ui_button_panel": {
        "$is_ore_ui_button|default": false,
        "$pressed_state|default": false,
        "$hover_state|default": false,
        "$border_visible|default": true,
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_front",
                "value": {
                    "hover_border": {
                        "ignored": "(not (($hover_state or $pressed_state) and $border_visible and $is_ore_ui_button)",
                        "$of|default": [0, 0],
                        "$sz|default": ["100% + 2px", "100% + 2px"],
                        "type": "image",
                        "texture": "textures/zk_ui/ore_ui/misc/border",
                        "offset": "$of",
                        "size": "$sz",
                        "layer": 4,
                        "allow_clipping": false,
                        "variables": [
                            {
                                "requires": "$pressed_state",
                                "$sz": ["100% + 2px", "100%"],
                                "$of": [0, 1]
                            }
                        ]
                    }
                }
            }
        ]
    },

    // ZK design light text button
    "zk_design:light_text_button@zk_oreui_design__buttons.light_text_button": {
        "button_mappings": "$button_mappings",
        "$button_mappings|default": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "focused"
            }
        ]
    },

    // ZK design red text button
    "zk_design:red_text_button@zk_oreui_design__buttons.red_text_button": {
        "button_mappings": "$button_mappings",
        "$button_mappings|default": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "focused"
            }
        ]
    },

    // ZK design green text button
    "zk_design:green_text_button@zk_oreui_design__buttons.green_text_button": {
        "button_mappings": "$button_mappings",
        "$button_mappings|default": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "focused"
            }
        ]
    }
}

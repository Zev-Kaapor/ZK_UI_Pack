"\u8d87\u13ce\u5ea8\u8461\u5a73\u477a\u4157\u47f2\ucca2\u9a52\ua7d3\u33ac\u0ba3\u44a1\ucd7e\ud068\u5511\u6edf\uab5c\u23a3\uff03\ue47e\u9665\u5fd1"*/"\u0068\u0065\u0061\u0072\u0074\u005f\u0066\u006c\u0061\u0073\u0068\u005f\u0068\u0061\u006c\u0066","\u0024\u0068\u0065\u0061\u006c\u0074\u0068\u005f\u006d\u006f\u0064\u0069\u0066\u0069\u0065\u0072\u0032\u005f\u005f\u0074\u006f\u0074\u0061\u006c\u005f\u0076\u0061\u006c\u0075\u0065":8,"\u0024\u0068\u0065\u0061\u006c\u0074\u0068\u005f\u006d\u006f\u0064\u0069\u0066\u0069\u0065\u0072\u0032\u005f\u005f\u006e\u006f\u0074\u0065":/*"\u8d87\u13ce\u5ea8\u8461\u5a73\u477a\u4157\u47f2\ucca2\u9a52\ua7d3\u33ac\u0ba3\u44a1\ucd7e\ud068\u5511\u6edf\uab5c\u23a3\uff03\ue47e\u9665\u5fd1"*/"\u0061\u0074\u0074\u0072\u0069\u0062\u0075\u0074\u0065\u002e\u006e\u0061\u006d\u0065\u002e\u0074\u006f\u0077\u0061\u0072\u0064\u0073\u0055\u006e\u0064\u0065\u0061\u0064"},"\u0073\u0070\u006c\u0061\u0073\u0068\u005f\u0070\u006f\u0069\u0073\u006f\u006e\u005f\u0070\u006f\u0074\u0069\u006f\u006e\u0040\u007a\u006b\u005f\u0062\u0072\u0065\u0077\u0069\u006e\u0067\u005f\u0067\u0075\u0069\u0064\u0065\u005f\u0069\u0074\u0065\u006d\u0073\u002e\u0073\u0070\u006c\u0061\u0073\u0068\u005f\u0070\u006f\u0074\u0069\u006f\u006e\u005f\u0074\u0065\u006d\u0070\u006c\u0061\u0074\u0065":/*"\ue4b9\ub81b\ua405\u2976\u625b\ufe9a\u1ea7\ua2d7\u2be7\u0aa3\u77b4\uec7f\u803b\ua4e5\u422b\ueccb\ubc33\u038c\udac0\ud40a\uefda\uc95e\u2fae\uc75b\u8c36\u8e6a\u1681\u714d\ue783\u5a60"*/{"\u0024\u0069\u0074\u0065\u006d\u005f\u0069\u0064\u005f\u0064\u0061\u0074\u0061":25,"\u0024\u0070\u006f\u0074\u0069\u006f\u006e\u005f\u0074\u0065\u0078\u0074\u0075\u0072\u0065\u005f\u006e\u0061\u006d\u0065":/*"\u8d87\u13ce\u5ea8\u8461\u5a73\u477a\u4157\u47f2\ucca2\u9a52\ua7d3\u33ac\u0ba3\u44a1\ucd7e\ud068\u5511\u6edf\uab5c\u23a3\uff03\ue47e\u9665\u5fd1"*/"\u0070\u006f\u0069\u0073\u006f\u006e","\u0024\u0070\u006f\u0074\u0069\u006f\u006e\u005f\u006e\u0061\u006d\u0065":/*"\u8d87\u13ce\u5ea8\u8461\u5a73\u477a\u4157\u4
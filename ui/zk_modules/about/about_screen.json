{
  "namespace": "zk_about",

  "zk_about_screen@zk_about_common.dynamic_dialog_screen": {
    "$selector_stack_panel": "zk_about.selector_stack_panel",
    "$section_content_panels": "zk_about.section_content_panels",
    "$header_safezone_control": "common_store.store_top_bar_filler",
    "$header_bar_control": "common_store.store_top_bar",
    "$section_header_panels": "zk_about.section_header_panels",
    "$section_footer_panels": "zk_about.section_footer_panels",
    "$is_full_screen_layout": true
  },

  "selector_stack_panel": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "orientation": "vertical",
    "$default_selector_toggle_index": 0,
    "ttsSectionContainer": true,
    "controls": [
      {
        "zk_about_selector_pane": {
          "type": "stack_panel",
          "controls": [
            {
              "padding_0": {
                "type": "panel",
                "size": [ 0, 4 ]
              }
            },
            {
              "about_button@zk_about.about_button": {
                "$toggle_group_forced_index": 0
              }
            },
            {
              "features_button@zk_about.features_button": {
                "$toggle_group_forced_index": 1
              }
            },
            {
              "credits_button@zk_about.credits_button": {
                "$toggle_group_forced_index": 2
              }
            },
            {
              "usage_button@zk_about.usage_button": {
                "$toggle_group_forced_index": 3
              }
            },
            {
              "validation_button@zk_about.validation_button": {
                "$toggle_group_forced_index": 4
              }
            },
            {
              "changelog_category@zk_about_common.topic_category": {
                "$category": "changelog"
              }
            },
            {
              "changelog100_button@zk_about.changelog100_button": {
                "$toggle_group_forced_index": 5
              }
            },
            {
              "changelog101_button@zk_about.changelog101_button": {
                "$toggle_group_forced_index": 6
              }
            }
          ]
        }
      }
    ]
  },

  "section_title_labels": {
    "type": "panel",
    "size": [ "100%c", "100%c" ],
    "controls": [
      {
        "about@zk_about_common.section_title": {
          "$section_title": "zkAbout.about",
          "$section_topic_control": "about"
        }
      },
      {
        "features@zk_about_common.section_title": {
          "$section_title": "zkAbout.features",
          "$section_topic_control": "features"
        }
      },
      {
        "credits@zk_about_common.section_title": {
          "$section_title": "zkAbout.credits",
          "$section_topic_control": "credits"
        }
      },
      {
        "usage@zk_about_common.section_title": {
          "$section_title": "zkAbout.usage",
          "$section_topic_control": "usage"
        }
      },
      {
        "validation@zk_about_common.section_title": {
          "$section_title": "zkAbout.validation",
          "$section_topic_control": "validation"
        }
      },
      {
        "changelog_100@zk_about_common.section_title_changelog": {
          "$version_label": "zkAbout.changelog100",
          "$section_topic_control": "changelog100"
        }
      },
      {
        "changelog_101@zk_about_common.section_title_changelog": {
          "$version_label": "zkAbout.changelog101",
          "$section_topic_control": "changelog101"
        }
      }
    ]
  },

  "section_content_panels": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ "100% - 6px", "100%c + 5px" ],
    "offset": [ 2, 0 ],
    "controls": [
      {
        "seecret_panel_for_touch": {
          "type": "panel",
          "size": [ "100%", 0 ],
          "controls": [
            {
              "hidden_panel@zk_about_common.section_content_hidden": {}
            }
          ]
        }
      },
      {
        "section_contents_header@zk_about_common.section_contents_header": {}
      },
      {
        "general_sections": {
          "type": "stack_panel",
          "controls": [
            { "about@zk_about.about_section": {} },
            { "features@zk_about.features_section": {} },
            { "credits@zk_about.credits_section": {} },
            { "usage@zk_about.usage_section": {} },
            { "validation@zk_about.validation_section": {} },
            { "changelog100@zk_about.changelog100_section": {} },
            { "changelog101@zk_about.changelog101_section": {} }
          ]
        }
      },
      {
        "section_contents_footer@zk_about_common.section_contents_footer": {}
      }
    ]
  },

  "section_header_panels": {
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ "100% - 6px", "100%c" ],
    "offset": [ 2, 0 ],
    "controls": [
      {
        "header_panel": {
          "type": "stack_panel",
          "controls": []
        }
      }
    ]
  },

  "section_footer_panels": {
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ "100% - 6px", "100%c" ],
    "offset": [ 2, 0 ],
    "controls": [
      {
        "footer_panel": {
          "type": "stack_panel",
          "controls": [
            { "about_footer@zk_about.about_footer": {} }
          ]
        }
      }
    ]
  },

  "about_button@zk_about_common.section_toggle_button": {
    "$section_topic": "about"
  },

  "about_section@zk_about_common.main_sections": {
    "$section_topic_control": "about",
    "controls": [
      {
        "pack_info_stack": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%", 48 ],
          "controls": [
            {
              "pack_icon": {
                "type": "image",
                "texture": "zk_logo_signed",
                "size": [ 48, 48 ],
                "layer": 1
              }
            },
            {
              "padding": {
                "type": "panel",
                "size": [ 4, 4 ]
              }
            },
            {
              "text_panel": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [ "fill", "100%" ],
                "controls": [
                  {
                    "pack_name@zk_about_common.generic_label": {
                      "localize": false,
                      "text": "§eZK UI PACK",
                      "font_type": "MinecraftTen",
                      "font_size": "large"
                    }
                  },
                  {
                    "version_text@zk_about_common.generic_label": {
                      "text": "zkAbout.packVersion"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "label_creator_title@zk_about_common.generic_label": {
          "text": "zkAbout.creatorTitle"
        }
      },
      {
        "label_creator_github@zk_about_common.generic_label": {
          "localize": false,
          "text": "- §bGitHub§r: https://github.com/Zev-kaapor/ZK_UI_Pack"
        }
      },
      {
        "padding_1": {
          "type": "panel",
          "size": [ 0, 18 ]
        }
      },
      { "label_1@$default_label": { "$line": 1 } },
      { "label_2@$default_label": { "$line": 2 } },
      { "label_3@$default_label": { "$line": 3 } },
      { "label_4@$default_label": { "$line": 4 } },
      { "label_5@$default_label": { "$line": 5 } },
      { "label_6@$default_label": { "$line": 6 } },
      {
        "pad_disclaimer": {
          "type": "panel",
          "size": [ 0, 4 ]
        }
      },
      {
        "disclaimer_text@zk_about_common.generic_label": {
          "localize": false,
          "text": "§7This pack is not affiliated with Microsoft or Mojang Studios."
        }
      }
    ]
  },

  "about_footer": {
    "type": "panel",
    "size": [ "100%", "100%c + 4px" ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "about_button_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "stack_panel_texts": {
          "type": "stack_panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              "padding": {
                "type": "panel",
                "size": [ 0, 2 ]
              }
            },
            {
              "help_translation@zk_about_common.generic_label": {
                "text": "zkAbout.translationHelp"
              }
            }
          ]
        }
      }
    ]
  },

  "features_button@zk_about_common.section_toggle_button": {
    "$section_topic": "features"
  },

  "features_section@zk_about_common.main_sections": {
    "$section_topic_control": "features",
    "controls": [
      {
        "title_1@zk_about_common.generic_label": {
          "text": "zkAbout.featuresTitleFeatures",
          "font_type": "MinecraftTen",
          "font_size": "large",
          "size": [ "100%", "24px" ],
          "max_size": [ "100%", "24px" ]
        }
      },
      {
        "small_pad@common.empty_panel": { "size": [ 1, 4 ] }
      },
      {
        "simple_header_bar@common.simple_header_bar": {
          "size": [ "100%", 1 ]
        }
      },
      {
        "content_pad@common.empty_panel": { "size": [ 1, 28 ] }
      },
      { "f_label_1@$default_label": { "$line": "_N_1" } },
      { "f_label_2@$default_label": { "$line": "_N_2" } },
      { "f_label_3@$default_label": { "$line": "_N_3" } },
      { "f_label_5@$default_label": { "$line": "_N_5" } },
      {
        "padding_1": {
          "type": "panel",
          "size": [ 0, 8 ]
        }
      }
    ]
  },

  "credits_button@zk_about_common.section_toggle_button": {
    "$section_topic": "credits"
  },

  "credits_section@zk_about_common.main_sections": {
    "$default_label": "zk_about_common.generic_label",
    "$section_topic_control": "credits",
    "controls": [
      {
        "title@$default_label": {
          "text": "zkAbout.creditsTitle",
          "font_type": "MinecraftTen",
          "font_size": "large"
        }
      },
      {
        "title_pad@common.empty_panel": { "size": [ 1, 8 ] }
      },
      {
        "label_1@$default_label": {
          "localize": false,
          "text": "- Zev Kaapor (Fork Maintainer & Restructure)"
        }
      },
      {
        "label_2@$default_label": {
          "localize": false,
          "text": "- @tlgm2308 (Original UI Core Base)"
        }
      },
      {
        "label_3@$default_label": {
          "localize": false,
          "text": "- Minecraft Vanilla UI and Sounds by © Microsoft and © Mojang Studios"
        }
      }
    ]
  },

  "usage_button@zk_about_common.section_toggle_button": {
    "$section_topic": "usage"
  },

  "usage_section@zk_about_common.main_sections": {
    "$section_topic_control": "usage",
    "controls": [
      {
        "title@zk_about_common.generic_label": {
          "text": "zkAbout.usage",
          "font_type": "MinecraftTen",
          "font_size": "large"
        }
      },
      {
        "title_pad@common.empty_panel": { "size": [ 1, 8 ] }
      },
      { "label_1@$default_label": { "$line": 1 } },
      { "label_2@$default_label": { "$line": 2 } },
      { "label_3@$default_label": { "$line": 3 } },
      { "label_4@$default_label": { "$line": 4 } },
      { "label_5@$default_label": { "$line": 5 } }
    ]
  },

  "validation_button@zk_about_common.section_toggle_button": {
    "$section_topic": "validation"
  },

  "validation_section@zk_about_common.main_sections": {
    "$section_topic_control": "validation",
    "controls": [
      {
        "title@zk_about_common.generic_label": {
          "text": "zkAbout.validation",
          "font_type": "MinecraftTen",
          "font_size": "large"
        }
      },
      {
        "title_pad@common.empty_panel": { "size": [ 1, 8 ] }
      },
      { "label_1@$default_label": { "$line": 1 } },
      {
        "padding_1": {
          "type": "panel",
          "size": [ "100%", 16 ]
        }
      },
      {
        "label_3@zk_about_common.generic_label": {
          "text": "zkAbout.validation.errorList",
          "font_type": "MinecraftTen",
          "font_scale_factor": 1.333
        }
      },
      {
        "validation_panel@zk_ui_validation.zk_ui_validation_stack_system": {}
      }
    ]
  },

  "min_ver_stack_label@zk_about_common.generic_stack_label": {
    "$text1": "zkAbout.minGameVerRequired",
    "$text2": "$min_version_req",
    "$min_version_req|default": "",
    "$enable_localize": true
  },

  "changelog100_button@zk_about_common.section_toggle_button": {
    "$section_topic": "changelog100"
  },

  "cl100_label@zk_about_common.changelog_desc_label": {
    "$ver": 100
  },

  "changelog100_section@zk_about_common.main_sections": {
    "$section_topic_control": "changelog100",
    "$cl_label|default": "zk_about.cl100_label",
    "controls": [
      {
        "title@zk_about_common.generic_label": {
          "text": "zkAbout.changelog100.title",
          "font_type": "MinecraftTen",
          "font_size": "large"
        }
      },
      {
        "title_pad@common.empty_panel": { "size": [ 1, 8 ] }
      },
      {
        "ver_text@zk_about_common.generic_label": {
          "text": "v1.0.0 (ZK UI Pack Initial Release)",
          "localize": false
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": [ 4, 4 ]
        }
      },
      { "label_1@$cl_label": { "$line": 1 } }
    ]
  },

  "changelog101_button@zk_about_common.section_toggle_button": {
    "$section_topic": "changelog101"
  },

  "cl101_label@zk_about_common.changelog_desc_label": {
    "$ver": 101
  },

  "changelog101_section@zk_about_common.main_sections": {
    "$section_topic_control": "changelog101",
    "$cl_label|default": "zk_about.cl101_label",
    "controls": [
      {
        "title@zk_about_common.generic_label": {
          "text": "zkAbout.changelog101.title",
          "font_type": "MinecraftTen",
          "font_size": "large"
        }
      },
      {
        "title_pad@common.empty_panel": { "size": [ 1, 8 ] }
      },
      {
        "ver_text@zk_about_common.generic_label": {
          "text": "v1.0.1 (UI Refinement and Localization Update)",
          "localize": false
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": [ 4, 4 ]
        }
      },
      { "label_1@$cl_label": { "$line": 1 } },
      { "label_2@$cl_label": { "$line": 2 } },
      { "label_3@$cl_label": { "$line": 3 } },
      { "label_4@$cl_label": { "$line": 4 } },
      { "label_5@$cl_label": { "$line": 5 } },
      { "label_6@$cl_label": { "$line": 6 } },
      { "label_7@$cl_label": { "$line": 7 } },
      { "label_8@$cl_label": { "$line": 8 } },
      { "label_9@$cl_label": { "$line": 9 } }
    ]
  },

  "file_validation": { "$valid": true }
}

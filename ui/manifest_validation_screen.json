// Manifest validation screen
{
    "namespace": "manifest_validation",

    // Text label
    "text_label": {
        "color": "$f_color_format",
        "hide_hyphen": true
    },

    // Error content grid
    "error_content_grid": {
        "factory": {
            "name": "pack_error_factory",
            "control_name": "zk_manifestValidation.error_pack_content_layout"
        }
    },

    // Pack error item
    "pack_error_item": {
        "type": "stack_panel",
        "orientation": "vertical",
        "size": ["100%", "100%c"],
        "controls": [
            {
                "padding_01@common.empty_panel": {
                    "size": [0, 4]
                }
            },
            {
                "pack_info_panel@zk_manifestValidation.pack_info_panel": {}
            },
            {
                "padding@common.empty_panel": {
                    "size": [0, 6]
                }
            },
            {
                "header_border": {
                    "type": "image",
                    "texture": "textures/zk_ui/ore_ui/misc/border",
                    "color": "$0_color_format",
                    "size": ["100%", "100%c + 2px"],
                    "controls": [
                        {
                            "pack_error_log_header@zk_manifestValidation.pack_error_log_header": {
                                "size": ["100% - 2px", "100%c + 8px"]
                            }
                        }
                    ]
                }
            },
            {
                "error@manifest_validation.error_content_grid": {}
            }
        ]
    },

    // Manifest validation screen content
    "manifest_validation_screen_content": {
        "type": "panel",
        "size": ["100%", "100%"],
        "max_size": ["100%", "100%"],
        "controls": [
            {
                "stack_content": {
                    "type": "stack_panel",
                    "size": ["100%", "100%"],
                    "layer": 2,
                    "controls": [
                        {
                            "header@zk_common.header_screen_oreui_style": {
                                "$header_content_controls": [
                                    {
                                        "close_button@zk_buttons.close_button": {
                                            "anchor_from": "left_middle",
                                            "anchor_to": "left_middle",
                                            "offset": [4, -1],
                                            "size": [24, 24]
                                        }
                                    },
                                    {
                                        "title_text@zk_common.title_header_oreui_style": {
                                            "text": "manifestvalidation.title"
                                        }
                                    },
                                    {
                                        "show_copy_button@zk_manifestValidation.show_copy_button": {}
                                    }
                                ]
                            }
                        },
                        {
                            "header_line@zk_common.header_line": {}
                        },
                        {
                            "body": {
                                "type": "panel",
                                "size": ["100%", "fill"],
                                "controls": [
                                    {
                                        "content": {
                                            "type": "panel",
                                            "size": ["100%", "100%"],
                                            "max_size": [700, "100%"],
                                            "controls": [
                                                {
                                                    "scrolling_panel@manifest_validation.scrolling_offsets": {
                                                        "$scrolling_content": "manifest_validation.pack_error_item"
                                                    }
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "background@zk_common.screen_background": {}
            }
        ]
    },

    // Manifest validation screen
    "manifest_validation_screen": {
        "force_render_below": false,
        "$is_settings_screen": true,
        "$screen_background_control": "common.empty_panel"
    }
}

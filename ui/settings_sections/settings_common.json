// Settings common elements
{
    // Dynamic dialog screen
    "dynamic_dialog_screen": {
        "$header_safezone_control": "common.empty_panel",
        "$header_bar_control": "common.empty_panel",
        "$is_full_screen_layout": false,
        "$_is_fullscreen_settings": false
    },

    // Dynamic dialog fullscreen
    "dynamic_dialog_fullscreen": {
        "$header_safezone_control": "common.empty_panel",
        "$header_bar_control": "common.empty_panel",
        "$is_full_screen_layout": false,
        "$_is_fullscreen_settings": true
    },

    // Selector group label
    "selector_group_label": {
        "ignored": true,
        "visible": false
    },

    // Option toggle state template
    "option_toggle_state_template": {
        "anchor_from": "right_middle",
        "anchor_to": "right_middle",
        "offset": [-4, 0]
    },

    // Option toggle
    "option_toggle": {
        "$one_line_layout": true
    },

    // Radio with label core
    "radio_with_label_core": {
        "$control_name|default": "empty",
        "$option_radio_dropdown_group_size|default": ["100% - 16px", "100%c"],
        "size": "$option_radio_dropdown_group_size",
        "modifications": [
            {
                "array_name": "variables",
                "operation": "insert_back",
                "value": {
                    "requires": "(not ($control_name = 'empty'))",
                    "$option_radio_dropdown_group_size": ["100%", "100%c"]
                }
            }
        ]
    },

    // Radio visuals checked hover
    "radio_visuals_checked_hover": {
        "$selected": true
    },

    // Radio visuals
    "radio_visuals": {
        "size": ["100%", 18],
        "$alpha|default": 1.0,
        "$radio_label_bindings|default": [],
        "$radio_label_color|default": "$main_header_text_color",
        "$radio_label_font_type|default": "default",
        "$no_label|default": false,
        "$selected|default": false,
        "$hovered|default": false,
        "controls": [
            {
                "radio_image": {
                    "ignored": "(not $selected)",
                    "type": "image",
                    "texture": "textures/ui/listcheck_smaller",
                    "alpha": "$alpha",
                    "anchor_from": "left_middle",
                    "anchor_to": "left_middle",
                    "offset": [2, 0],
                    "size": [10, 10],
                    "layer": 2
                }
            },
            {
                "radio_label": {
                    "ignored": "$no_label",
                    "type": "label",
                    "anchor_from": "left_middle",
                    "anchor_to": "left_middle",
                    "text": "$radio_label_text",
                    "font_type": "$radio_label_font_type",
                    "color": "$radio_label_color",
                    "offset": [16, 0.5],
                    "size": ["100% - 16px", "default"],
                    "alpha": "$alpha",
                    "bindings": "$radio_label_bindings",
                    "layer": 2,
                    "$tts_override_control_value|default": "$radio_label_text",
                    "tts_override_control_value": "$tts_override_control_value"
                }
            },
            {
                "accessibility_selection_highlight": {
                    "type": "image",
                    "$selection_highlight_size|default": ["100% + 6px", "100%"],
                    "size": "$selection_highlight_size",
                    "$selection_highlight_offset|default": [0, 0],
                    "offset": "$selection_highlight_offset",
                    "ignored": "(not $selected and not $hovered)",
                    "$highlight_image|default": "",
                    "texture": "$highlight_image",
                    "tiled": true,
                    "layer": 1
                }
            }
        ]
    },

    // Option generic tooltip hover detection input panel
    "option_generic_tooltip/hover_detection_input_panel": {
        "offset": [-38, 2]
    },

    // Option generic tooltip
    "option_generic_tooltip": {
        "allow_clipping": false
    },

    // Option slider control slider
    "option_slider_control/slider": {
        "size": ["100% - 8px", 10],
        "offset": [2, 0]
    },

    // Action button dark text
    "action_button_dark_text@zk_buttons.light_text": {
        "$pressed_button_name|default": "unset_button_name",
        "$button_text|default": "unset $button_text",
        "size": ["100%", 30],
        "anchor_from": "center",
        "anchor_to": "center"
    },

    // Link button
    "link_button@zk_buttons.oreui_light_text_button": {
        "$pressed_button_name": "button.menu_open_uri",
        "$button_text|default": "unset $button_text",
        "$size_c839|default": ["100% - 24px", 30],
        "size": "$size_c839",
        "$button_size_override": ["100%", "100% + 1px"],
        "anchor_from": "center",
        "anchor_to": "center",
        "property_bag": {
            "#hyperlink": "unset #hyperlink in property_bag"
        }
    },

    // Option generic
    "option_generic": {
        "controls": [
            {
                "background@zk_settings.item_with_bg": {
                    "size": ["100%", "100%c + 6px"],
                    "controls": [
                        {
                            "option_generic_core@settings_common.option_generic_core": {
                                "size": "$size_b949",
                                "offset": [0, 2]
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Option descriptive text two line panel
    "option_descriptive_text_two_line_panel": {
        "ignored": "(not $has_option_description)",
        "type": "panel",
        "size": ["100%", "100%c"],
        "controls": [
            {
                "text": {
                    "type": "label",
                    "text": "$option_description",
                    "color": "$option_description_text_color",
                    "text_alignment": "$option_label_alignment",
                    "font_size": "small",
                    "font_scale_factor": 1.6,
                    "size": ["90%", "default"],
                    "offset": [6, 0],
                    "anchor_from": "bottom_left",
                    "anchor_to": "bottom_left",
                    "visible": "$show_option_label",
                    "locked_alpha": 0.5
                }
            }
        ]
    },

    // Option generic core two line layout
    "option_generic_core/two_line_layout": {
        "modifications": [
            {
                "control_name": "option_description_panel",
                "operation": "replace",
                "value": {
                    "new_option_descriptive_text_0@settings_common.option_descriptive_text_two_line_panel": {}
                }
            }
        ]
    },

    // Option generic core one line layout
    "option_generic_core/one_line_layout": {
        "$label_offset|default": [40, 6]
    },

    // Option generic core one line layout option description panel option descriptive text
    "option_generic_core/one_line_layout/option_description_panel/option_descriptive_text": {
        "font_size": "small",
        "font_scale_factor": 1.6
    },

    // Option generic core two line layout spacer2
    "option_generic_core/two_line_layout/spacer2": {
        "size": [0, 3]
    },

    // Option generic core
    "option_generic_core": {
        "$label_offset": [4, 0],
        "$option_toggle_offset_tootip|default": [0, 2],
        "modifications": [
            {
                "array_name": "variables",
                "operation": "insert_back",
                "value": {
                    "requires": "($control_name = 'settings_common.option_toggle_control')",
                    "$label_offset": [6, 3],
                    "$line_size_tootip": ["100%", "100%c"],
                    "$option_toggle_offset_tootip": [-32, 2]
                }
            }
        ]
    },

    // Option generic core one line layout option label subpanel 02
    "option_generic_core/one_line_layout/option_label_subpanel_02": {
        "$line_size_tootip|default": ["100% - 28px", "100%c"],
        "size": "$line_size_tootip"
    },

    // Option generic core two line layout option label panel option label subpanel 01
    "option_generic_core/two_line_layout/option_label_panel/option_label_subpanel_01": {
        "size": ["100% - 4px", "100%c"]
    },

    // Option generic core two line layout option label panel option label subpanel 02
    "option_generic_core/two_line_layout/option_label_panel/option_label_subpanel_02": {
        "offset": [4, 0]
    },

    // Option text edit control with button
    "option_text_edit_control_with_button": {
        "controls": [
            {
                "text_box@common.text_edit_box": {
                    "size": ["fill", "100%"],
                    "$text_background_default": "zk_common.edit_box_indent",
                    "$text_background_hover": "zk_common.edit_box_indent_hover",
                    "max_length": "$max_text_edit_length",
                    "$text_edit_box_content_binding_name": "$option_binding_name",
                    "$text_edit_box_binding_collection_name": "$option_binding_name",
                    "$text_edit_box_binding_type": "global",
                    "$text_box_enabled_binding_name": "$option_enabled_binding_name",
                    "enabled": "$enabled",
                    "$place_holder_text": "$option_place_holder_text",
                    "$text_box_tts_header": "$option_label",
                    "variables": [
                        {
                            "requires": "(not $option_enabled_binding_name or not $enabled)",
                            "$text_box_enabled_binding_name": "#not_data_bound",
                            "$text_edit_box_enabled_binding_type": "none"
                        }
                    ]
                }
            },
            {
                "button_panel": {
                    "type": "panel",
                    "size": ["100%y + 12px", "100%"],
                    "controls": [
                        {
                            "button@zk_buttons.oreui_light_content_button": {
                                "$button_content": "settings_common.arrow_image",
                                "size": ["100%", "100%"]
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Option text edit control with text button
    "option_text_edit_control_with_text_button": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "$option_text_edit_control_with_button_size|default": ["100%", "30px"],
        "size": "$option_text_edit_control_with_button_size",
        "controls": [
            {
                "text_box@common.text_edit_box": {
                    "$option_text_edit_control_size|default": ["85%", "100%"],
                    "$text_background_default": "zk_common.edit_box_indent",
                    "$text_background_hover": "zk_common.edit_box_indent_hover",
                    "size": "$option_text_edit_control_size",
                    "max_length": "$max_text_edit_length",
                    "$text_edit_box_content_binding_name": "$option_binding_name",
                    "$text_edit_box_binding_collection_name": "$option_binding_name",
                    "$text_edit_box_binding_type": "global",
                    "$text_box_enabled_binding_name": "$option_enabled_binding_name",
                    "enabled": "$enabled",
                    "$place_holder_text": "$option_place_holder_text",
                    "$text_box_tts_header": "$option_label",
                    "variables": [
                        {
                            "requires": "(not $option_enabled_binding_name or not $enabled)",
                            "$text_box_enabled_binding_name": "#not_data_bound",
                            "$text_edit_box_enabled_binding_type": "none"
                        }
                    ]
                }
            },
            {
                "button@zk_buttons.oreui_light_text_button": {
                    "$pressed_button_name|default": "unset_button_name",
                    "$button_text|default": "unset $button_text",
                    "$option_button_control_size|default": ["fill", "100%"],
                    "size": "$option_button_control_size"
                }
            }
        ]
    },

    // Option group label
    "option_group_label": {
        "$font_type|default": "MinecraftTen",
        "$font_scale_factor|default": 1.15
    },

    // Option group label text
    "option_group_label/text": {
        "offset": [8, 4]
    },

    // Option text edit control
    "option_text_edit_control": {
        "$text_background_default": "zk_common.edit_box_indent",
        "$text_background_hover": "zk_common.edit_box_indent_hover"
    },

    // Options dropdown toggle control
    "options_dropdown_toggle_control@zk_toggles.light_template_toggle": {
        "size": ["100%", "100%"],
        "$button_type_panel|default": "settings_common.default_options_dropdown_toggle_button_state_content",
        "enabled": "$enabled",
        "$toggle_enabled_binding_name|default": "$option_enabled_binding_name",
        "$toggle_enabled_binding_type|default": "global",
        "$toggle_binding_type|default": "global",
        "variables": [
            {
                "requires": "(not $option_enabled_binding_name or not $enabled)",
                "$toggle_enabled_binding_name": "#not_data_bound",
                "$toggle_enabled_binding_type": "none"
            }
        ]
    },

    // Default options dropdown toggle button state content
    "default_options_dropdown_toggle_button_state_content": {
        "$text_color": "$oreui_default_text_color"
    },

    // Default options dropdown toggle button state content arrow panel dropdown chevron image
    "default_options_dropdown_toggle_button_state_content/arrow_panel/dropdown_chevron_image": {
        "color": "$oreui_default_text_color"
    },

    // Option dropdown control
    "option_dropdown_control": {
        "$dropdown_background_control|default": "zk_settings.dropdown_background"
    },

    // Option dropdown control dropdown
    "option_dropdown_control/dropdown": {
        "size": ["100% - 8px", "100%"]
    },

    // Radio with label
    "radio_with_label": {
        "size": ["100%", "18px"]
    },

    // Option toggle on
    "option_toggle_on": {
        "texture": "textures/zk_ui/ore_ui/toggles/toggle_on"
    },

    // Option toggle off
    "option_toggle_off": {
        "texture": "textures/zk_ui/ore_ui/toggles/toggle_off"
    },

    // Option toggle on hover
    "option_toggle_on_hover": {
        "texture": "textures/zk_ui/ore_ui/toggles/toggle_on_hover"
    },

    // Option toggle off hover
    "option_toggle_off_hover": {
        "texture": "textures/zk_ui/ore_ui/toggles/toggle_off_hover"
    },

    // Option slider control
    "option_slider_control": {
        "controls": [
            {
                "slider@zk_sliders.oreui_slider": {
                    "size": ["100%-8px", 10],
                    "$slider_box_size": [16, 16],
                    "offset": [1, 0],
                    "$option_label|default": "",
                    "$slider_tts_header": "$option_label",
                    "$slider_tts_header_binding_type": "global",
                    "enabled": "$enabled",
                    "$slider_enabled_binding_name": "$option_enabled_binding_name",
                    "$slider_enabled_binding_type": "global",
                    "variables": [
                        {
                            "requires": "(not $option_enabled_binding_name or not $enabled)",
                            "$slider_enabled_binding_name": "#not_data_bound",
                            "$slider_enabled_binding_type": "none"
                        }
                    ]
                }
            }
        ]
    },

    // Action button
    "action_button@zk_settings.item_with_bg": {
        "size": ["100%", "100%c + 12px"],
        "$size_c273|default": ["100% - 24px", 30],
        "controls": [
            {
                "action_button@zk_buttons.oreui_light_text_button": {
                    "$pressed_button_name|default": "unset_button_name",
                    "$button_text|default": "unset $button_text",
                    "size": "$size_c273"
                }
            }
        ]
    },

    // Action button raw
    "action_button_raw@zk_buttons.oreui_light_text_button": {
        "$pressed_button_name|default": "unset_button_name",
        "$button_text|default": "unset $button_text",
        "size": ["100%", 30]
    },

    // Section toggle base
    "section_toggle_base": {
        "$default_text_color": "$f_color_format",
        "$default_checked_text_color": "$f_color_format",
        "$hover_text_color": "$f_color_format",
        "$hover_checked_text_color": "$f_color_format",
        "$ui_button_panel": "zk_settings.new_ui_button_panel",
        "size": ["100%", "24px"]
    },

    // Header line
    "header_line": {
        "type": "image",
        "texture": "textures/ui/Black",
        "size": ["200%", 1],
        "alpha": 0.45,
        "anchor_from": "top_middle",
        "anchor_to": "top_middle",
        "layer": 8
    },

    // Dialog title label
    "dialog_title_label": {
        "color": "$oreui_default_text_color",
        "font_type": "MinecraftTen",
        "font_scale_factor": 1.15,
        "anchor_from": "left_middle",
        "anchor_to": "left_middle",
        "size": ["default", "default"],
        "offset": [32, -4]
    },

    // Section title label
    "section_title_label": {
        "color": "$oreui_default_text_color",
        "font_type": "MinecraftTen",
        "font_scale_factor": 1.15,
        "anchor_from": "center",
        "anchor_to": "center",
        "size": ["default", "default"],
        "offset": [0, -3]
    },

    // Settings content background
    "settings_content/background": {
        "texture": "textures/ui/Black",
        "size": ["150%", "150%"],
        "alpha": 0.5,
        "anchor_from": "center",
        "anchor_to": "center"
    },

    // Settings content stack panel content panel
    "settings_content/stack_panel/content_panel": {
        "controls": [
            {
                "container": {
                    "type": "panel",
                    "size": ["100%", "100% - 4px"],
                    "max_size": [700, "100% - 4px"],
                    "controls": [
                        {
                            "$dialog_content@$dialog_content": {}
                        }
                    ]
                }
            }
        ]
    },

    // Settings content
    "settings_content": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_front",
                "value": [
                    {
                        "search_settings_content_factory@zk_searchSettings.search_settings_content_factory": {}
                    },
                    {
                        "storage_management_screen_factory@zk_storage.storage_management_screen_factory": {}
                    },
                    {
                        "english_language": {
                            "type": "panel",
                            "size": [0, 0],
                            "visible": false,
                            "bindings": [
                                {
                                    "binding_name": "#language_initial_selected",
                                    "binding_type": "collection",
                                    "binding_collection_name": "languages"
                                }
                            ]
                        }
                    }
                ]
            }
        ]
    },

    // Header content
    "header_content": {
        "type": "panel",
        "size": ["100%", 24],
        "controls": [
            {
                "image": {
                    "type": "image",
                    "texture": "textures/zk_ui/ore_ui/screens/topbar_image",
                    "size": ["150%", "150%"],
                    "anchor_from": "bottom_middle",
                    "anchor_to": "bottom_middle"
                }
            },
            {
                "section_title@settings_common.section_title_label": {
                    "ignored": "(not $_is_fullscreen_settings)",
                    "layer": 4
                }
            },
            {
                "content": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%", 24],
                    "layer": 2,
                    "controls": [
                        {
                            "left": {
                                "type": "panel",
                                "size": ["33%", "100%"],
                                "controls": [
                                    {
                                        "close_button@zk_buttons.close_button": {
                                            "anchor_from": "left_middle",
                                            "anchor_to": "left_middle",
                                            "offset": [2, -2],
                                            "size": [24, 24]
                                        }
                                    },
                                    {
                                        "screen_title@settings_common.dialog_title_label": {
                                            "ignored": "$_is_fullscreen_settings"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "right@zk_defs.variables": {
                                "type": "panel",
                                "size": ["fill", "100%"],
                                "controls": [
                                    {
                                        "section_title@settings_common.section_title_label": {
                                            "ignored": "$_is_fullscreen_settings"
                                        }
                                    },
                                    {
                                        "search_toggle@zk_searchSettings.search_toggle": {
                                            "$default_focus_precedence": -9,
                                            "ignored": "($is_performance_mode or not $include_controls_and_settings_sections)"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Dialog content fullscreen
    "dialog_content_fullscreen@settings_common.dialog_content": {},

    // Dialog content
    "dialog_content": {
        "type": "stack_panel",
        "anchor_from": "top_middle",
        "anchor_to": "top_middle",
        "size": ["100%", "100%"],
        "controls": [
            {
                "header_content@settings_common.header_content": {}
            },
            {
                "stack_content": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%", "fill"],
                    "controls": [
                        {
                            "padding_01@common.empty_panel": {
                                "size": [2, 0]
                            }
                        },
                        {
                            "selector_area@settings_common.selector_area": {}
                        },
                        {
                            "padding_03@common.empty_panel": {
                                "ignored": "$_is_fullscreen_settings",
                                "size": [2, 0]
                            }
                        },
                        {
                            "content_area@settings_common.content_area": {}
                        },
                        {
                            "padding_02@common.empty_panel": {
                                "size": [2, 0]
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Selector area
    "selector_area": {
        "size": "$size_jcod",
        "max_size": ["33% - 8px", "100%"],
        "$size_jcod": ["33% - 8px", "100%"],
        "$use_scrolling_panel_oreui_style": true,
        "$scroll_track_image_control": "common.empty_panel",
        "variables": [
            {
                "requires": "$_is_fullscreen_settings",
                "$size_jcod": [0, 0]
            }
        ],
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "background": {
                            "type": "image",
                            "texture": "textures/ui/Black",
                            "alpha": 0.6,
                            "layer": -1
                        }
                    },
                    {
                        "background_border": {
                            "type": "image",
                            "texture": "textures/zk_ui/ore_ui/misc/border",
                            "color": "$0_color_format",
                            "alpha": 0.9,
                            "layer": -1
                        }
                    }
                ]
            }
        ]
    },

    // Selector area scrolling panel
    "selector_area/scrolling_panel": {
        "size": ["100% - 2px", "100% - 2px"]
    },

    // Content area
    "content_area": {
        "size": ["fill", "100%"],
        "$use_scrolling_panel_oreui_style": true,
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_front",
                "value": [
                    {
                        "header_line@settings_common.header_line": {}
                    },
                    {
                        "background": {
                            "$use_dark_iwbg|default": false,
                            "$texture|default": "bg_option",
                            "type": "image",
                            "texture": "('textures/zk_ui/ore_ui/screens/' + $texture)",
                            "size": ["100%", "100%"],
                            "layer": -1,
                            "variables": [
                                {
                                    "requires": "$use_dark_iwbg",
                                    "$texture": "bg_option_dark"
                                }
                            ]
                        }
                    }
                ]
            }
        ]
    },

    // Content area control
    "content_area/control": {
        "size": ["100% - 2px", "100%"],
        "anchor_from": "center",
        "anchor_to": "center"
    }
}

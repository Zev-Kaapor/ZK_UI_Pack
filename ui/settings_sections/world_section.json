// Settings world section
{
    // Addon section
    "addon_section": {
        "$packs_header_name": "_addon_section"
    },

    // Level texture pack section
    "level_texture_pack_section": {
        "$packs_header_name": "_texture_section"
    },

    // Selector pane content game button
    "selector_pane_content/game_button": {
        "$toggle_group_forced_index": 513
    },

    // Game section world management label
    "game_section/world_management_label": {
        "ignored": false
    },

    // Game section convert to infinite panel
    "game_section/convert_to_infinite_panel": {
        "ignored": false
    },

    // Game section experimental toggles label info
    "game_section/experimental_toggles_label_info": {
        "$font_type": "default",
        "$font_scale_factor": 1
    },

    // Play or create stack bedrock
    "play_or_create_stack_bedrock": {
        "size": ["100%", "100%cm + 8px"],
        "use_child_anchors": true,
        "controls": [
            {
                "create_or_play_button@settings_common.action_button": {
                    "size": ["fill", 30],
                    "$button_text": "menu.play",
                    "default_focus_precedence": 1,
                    "$pressed_button_name": "play_world_button",
                    "$focus_override_up": "FOCUS_OVERRIDE_STOP",
                    "variables": [
                        {
                            "requires": "(not $is_world_edit)",
                            "$button_text": "createWorldScreen.create",
                            "$pressed_button_name": "create_world_button"
                        },
                        {
                            "requires": "($is_world_edit and $is_editor_mode_enabled)",
                            "$button_text": "menu.editor.play"
                        }
                    ]
                }
            },
            {
                "padding@zk_pad.4px_x": {}
            },
            {
                "play_on_realm_button@zk_buttons.oreui_realms_text_button": {
                    "ignored": "(not $is_pregame or $education_edition or $is_editor_mode_enabled)",
                    "size": ["fill", 30],
                    "$button_text_max_size": ["100%", 25],
                    "$button_text": "menu.playOnRealms",
                    "$pressed_button_name": "play_world_on_realm_button",
                    "$focus_override_up": "FOCUS_OVERRIDE_STOP",
                    "variables": [
                        {
                            "requires": "(not $is_world_edit)",
                            "$button_text": "createWorldScreen.createOnRealms",
                            "$pressed_button_name": "create_world_on_realm_button"
                        }
                    ],
                    "bindings": [
                        {
                            "binding_name": "#create_on_realm_visible",
                            "binding_name_override": "#visible"
                        }
                    ]
                }
            },
            {
                "padding2@zk_pad.4px_x": {}
            }
        ]
    },

    // Game section
    "game_section": {
        "modifications": [
            {
                "control_name": "is_hardcore_toggle",
                "operation": "insert_after",
                "value": {
                    "force_spectator_panel@zk_settings.force_spectator_panel": {}
                }
            },
            {
                "control_name": "option_info_label",
                "operation": "replace",
                "value": {
                    "achievment_warning_holder@zk_settings.achievment_warning_holder": {}
                }
            },
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": {
                    "world_management_panel@zk_worldManagement.world_management_panel": {}
                }
            },
            {
                "control_name": "clear_player_data_panel",
                "operation": "remove"
            },
            {
                "control_name": "export_template_panel",
                "operation": "remove"
            },
            {
                "control_name": "copy_world_panel",
                "operation": "remove"
            },
            {
                "control_name": "upload_download_slot_panel",
                "operation": "remove"
            },
            {
                "control_name": "replace_slot_panel",
                "operation": "remove"
            },
            {
                "control_name": "convert_to_infinite_panel",
                "operation": "remove"
            },
            {
                "control_name": "delete_button",
                "operation": "remove"
            }
        ]
    }
}

// Settings general section
{
    // Text filtering toggles panel section panel 1
    "text_filtering_toggles_panel/section_panel_1": {
        "ignored": true
    },

    // Editor toggles panel section panel 1
    "editor_toggles_panel/section_panel_1": {
        "ignored": true
    },

    // Text filtering toggles panel primary panel
    "text_filtering_toggles_panel/primary_panel": {
        "modifications": [
            {
                "control_name": "heading",
                "operation": "replace",
                "value": {
                    "debugText_heading@zk_settings.heading_title_panel": {
                        "$text": "options.creator.debugTextFiltering"
                    }
                }
            },
            {
                "control_name": "spacer",
                "operation": "remove"
            }
        ]
    },

    // Editor toggles panel primary panel
    "editor_toggles_panel/primary_panel": {
        "modifications": [
            {
                "control_name": "content_log_section_label",
                "operation": "replace",
                "value": {
                    "debugText_heading@zk_settings.heading_title_panel": {
                        "$text": "options.creator.editor.heading"
                    }
                }
            },
            {
                "control_name": "content_log_section_label_spacer",
                "operation": "remove"
            }
        ]
    },

    // Debugger toggles panel primary panel
    "debugger_toggles_panel/primary_panel": {
        "modifications": [
            {
                "control_name": "heading",
                "operation": "replace",
                "value": {
                    "debugger_heading@zk_settings.heading_title_panel": {
                        "$text": "options.creator.debuggerHeading"
                    }
                }
            },
            {
                "control_name": "spacer",
                "operation": "remove"
            }
        ]
    },

    // Accessibility section option toggle subtitles
    "accessibility_section/option_toggle_subtitles": {
        "bindings": []
    },

    // Accessibility section option toggle hide own subtitles
    "accessibility_section/option_toggle_hide_own_subtitles": {
        "bindings": []
    },

    // Accessibility section option toggle hide ambient subtitles
    "accessibility_section/option_toggle_hide_ambient_subtitles": {
        "bindings": []
    },

    // Accessibility section subtitle duration slider
    "accessibility_section/subtitle_duration_slider": {
        "bindings": []
    },

    // Accessibility section subtitle position dropdown
    "accessibility_section/subtitle_position_dropdown": {
        "bindings": []
    },

    // Creator toggles panel primary panel
    "creator_toggles_panel/primary_panel": {
        "modifications": [
            {
                "control_name": "content_log_section_label",
                "operation": "replace",
                "value": {
                    "debugger_heading@zk_settings.heading_title_panel": {
                        "$text": "options.creatorTitle"
                    }
                }
            },
            {
                "control_name": "content_log_section_label_spacer",
                "operation": "remove"
            }
        ]
    },

    // View subscriptions section
    "view_subscriptions_section": {
        "size": ["100% - 16px", "100%c"]
    },

    // Video menu customization slider control
    "video_menu_customization_slider_control": {
        "controls": [
            {
                "slider@zk_sliders.oreui_slider": {
                    "size": ["100%-8px", 10],
                    "$slider_box_size": [16, 16],
                    "offset": [1, 0],
                    "$option_label|default": "",
                    "$slider_tts_header": "$option_label",
                    "$slider_tts_header_binding_type": "global",
                    "enabled": "$enabled",
                    "$slider_enabled_binding_name": "$option_enabled_binding_name",
                    "$slider_enabled_binding_type": "global",
                    "variables": [
                        {
                            "requires": "(not $option_enabled_binding_name or not $enabled)",
                            "$slider_enabled_binding_name": "#not_data_bound",
                            "$slider_enabled_binding_type": "none"
                        }
                    ]
                }
            }
        ]
    },

    // Content log location label panel
    "content_log_location_label_panel": {
        "type": "stack_panel",
        "size": ["100%", "100%c + 6px"],
        "controls": [
            {
                "a": {
                    "type": "panel",
                    "size": ["100%", "100%c"],
                    "controls": [
                        {
                            "jf": {
                                "type": "label",
                                "text": "contentlog.logLocationSectionName",
                                "size": ["100% - 16px", "default"],
                                "color": "$f_color_format"
                            }
                        }
                    ]
                }
            },
            {
                "c": {
                    "type": "panel",
                    "size": ["100%", "100%c"],
                    "controls": [
                        {
                            "content_log_location_label": {
                                "type": "label",
                                "text": "#text",
                                "size": ["100% - 16px", "default"],
                                "color": "$f_color_format",
                                "hide_hyphen": true,
                                "bindings": [
                                    {
                                        "binding_name": "#content_log_location_text",
                                        "binding_name_override": "#text"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ],
        "bindings": [
            {
                "binding_name": "#content_log_file_enabled",
                "binding_name_override": "#visible"
            }
        ]
    },

    // Content log button panel
    "content_log_button_panel@zk_settings.item_with_bg": {
        "size": ["100%", "100%c + 16px"],
        "controls": [
            {
                "content_log_buttons": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100% - 24px", 30],
                    "$size_c273": ["100%", 30],
                    "controls": [
                        {
                            "open_content_log_history@settings_common.action_button": {
                                "$pressed_button_name": "button.open_content_log_history",
                                "$button_text": "contentlog.history.title",
                                "size": ["fill", "100%"],
                                "bindings": [
                                    {
                                        "binding_name": "#content_log_gui_option_enabled",
                                        "binding_name_override": "#enabled"
                                    }
                                ]
                            }
                        },
                        {
                            "padding": {
                                "type": "panel",
                                "size": [2, "100%"]
                            }
                        },
                        {
                            "clear_content_log_files@settings_common.action_button": {
                                "$focus_override_down": "FOCUS_OVERRIDE_STOP",
                                "$pressed_button_name": "button.clear_content_log_files",
                                "$button_text": "contentlog.clear_files",
                                "size": ["fill", "100%"],
                                "bindings": [
                                    {
                                        "binding_name": "#allow_content_log_write_to_disk",
                                        "binding_name_override": "#visible"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Diagnostics capture buttons panel
    "diagnostics_capture_buttons_panel@zk_settings.item_with_bg": {
        "size": ["100%", "100%c + 16px"],
        "controls": [
            {
                "diagnostics_capture_buttons": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%", 30],
                    "controls": [
                        {
                            "clear_diagnostics_capture_files@settings_common.action_button": {
                                "$focus_override_down": "FOCUS_OVERRIDE_STOP",
                                "$pressed_button_name": "button.clear_diagnostics_captures",
                                "$button_text": "options.creator.diagnosticsClearCaptures",
                                "size": ["100%", "100%"]
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Sign out panel
    "sign_out_panel@zk_settings.item_with_bg": {
        "size": ["100%", "100%c + 12px"],
        "controls": [
            {
                "sign_out@zk_buttons.oreui_light_content_button": {
                    "size": ["100% - 8px", 30],
                    "enabled": "$is_pregame",
                    "$button_size_override": ["100%", "100% - 4px"],
                    "$button_content": "general_section.sign_out_button_content",
                    "$pressed_button_name": "button.sign_out"
                }
            }
        ]
    },

    // Switch accounts panel
    "switch_accounts_panel@zk_settings.item_with_bg": {
        "size": ["100%", "100%c + 12px"],
        "controls": [
            {
                "name_label": {
                    "type": "label",
                    "color": "$main_header_text_color",
                    "localize": false,
                    "text": "#ad_account_name",
                    "size": ["100% - 8px", "default"],
                    "bindings": [
                        {
                            "binding_name": "#ad_account_name"
                        }
                    ]
                }
            },
            {
                "paddingSwitchAccounts": {
                    "type": "panel",
                    "size": [0, 4]
                }
            },
            {
                "switch_accounts": {
                    "type": "panel",
                    "size": ["100%", 30],
                    "controls": [
                        {
                            "switch_accounts@zk_buttons.oreui_light_content_button": {
                                "size": ["100% - 8px", "100%"],
                                "enabled": "$is_pregame",
                                "$button_size_override": ["100%", "100% - 4px"],
                                "$button_content": "general_section.switch_accounts_button_content",
                                "$pressed_button_name": "button.switch_accounts"
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Advanced graphics options section
    "advanced_graphics_options_section": {
        "modifications": [
            {
                "control_name": "spacer_0",
                "operation": "remove"
            }
        ]
    },

    // Max framerate slider
    "max_framerate_slider": {
        "controls": [
            {
                "background@zk_settings.item_with_bg": {
                    "controls": [
                        {
                            "option_generic_core@settings_common.option_generic_core": {
                                "size": ["100% - 12px", "100%c"],
                                "offset": [0, 2]
                            }
                        }
                    ]
                }
            }
        ],
        "bindings": []

                                        "network_info_label": {
                                            "type": "label",
                                            "color": "$body_text_color",
                                            "size": ["100%", "default"],
                                            "text": "#network_info",
                                            "bindings": [
                                                {
                                                    "binding_name": "#network_info"
                                                },
                                                {
                                                    "binding_name": "#network_info_visible",
                                                    "binding_name_override": "#visible"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "protocol_version_label": {
                                            "type": "label",
                                            "color": "$body_text_color",
                                            "size": ["100%", "default"],
                                            "text": "#protocol_version",
                                            "bindings": [
                                                {
                                                    "binding_name": "#protocol_version"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "treatment_ids_label": {
                                            "visible": "(not $education_edition)",
                                            "type": "label",
                                            "color": "$body_text_color",
                                            "size": ["100%", "default"],
                                            "text": "#treatment_ids",
                                            "bindings": [
                                                {
                                                    "binding_name": "#treatment_ids"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "build_date_label": {
                                            "type": "label",
                                            "color": "$body_text_color",
                                            "size": ["100%", "default"],
                                            "text": "#build_date",
                                            "bindings": [
                                                {
                                                    "binding_name": "#build_date"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "world_converter_label": {
                                            "type": "label",
                                            "color": "$body_text_color",
                                            "size": ["100%", "default"],
                                            "text": "#world_conversion_version",

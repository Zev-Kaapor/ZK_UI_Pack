
{
  "screen": {
    "$fill_alpha": "$fill_alpha",
    "$screen_animations": [
      "@zk_oreui_design__anims.oreui_dialog_entrance_animation_fade",
      "@zk_oreui_design__anims.oreui_dialog_entrance_animation_pop_fade",
      "@zk_oreui_design__anims.oreui_dialog_exit_animation_push_fade",
      "@zk_oreui_design__anims.oreui_dialog_exit_animation_pop_fade"
    ]
  },

  "main_screen_content": {
    "size": [ "100% - 20px", "100% - 40px" ],
    "max_size": [ 420, 360 ],
    "$oreui_dialog_style__animate_dialog": true
  },

  "scrolling_content": {
    "use_child_anchors": true
  },

  "scrolling_content/generated_form": {
    "size": [ "100% - 8px", "100%c" ]
  }
}

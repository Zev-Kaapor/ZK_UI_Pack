// File made and modified by @tlgm2308 (Twitter).
// Please respect my works ;-;, and do not use my code without permissions!

// This file will help you create your own custom panorama
// (both still and UV panoramas), and even your own theme.
// I know the file is extremely complicated, but I explained
// all variables in this file for you to easier understand

// NOTE: Do not delete any double slashes (//) and any commas in codes

{
  // Magic version number, do not change
  "zk_theme_metadata": {
    "$format_version": 110
  },

  // ================================================
  // CUSTOM PANORAMA
  "custom_panorama": {
    "$format_version": 1,

    // Use Custom Panorama or not (set this to true to use custom panorama)
    "$use_customizable_panorama": false,

    // Custom Panorama atlas/spritesheet/flipbook texture location
    "$panorama_texture": "textures/custom_panorama",

    // Bilinear Effect
    "$use_bilinear_effect": true,

    // ---------------------------------------
    // ANIMATED PANORAMA SETTINGS
    // ---------------------------------------
    // Set this to true if you have animated panorama
    // Note: the texture must be an atlas or a flipbook texture
    // and file must be PNG, not GIF!
    "$use_animated_panorama_uv": false,

    // [BETA] Enable this if you use Aseprite Spritesheets (requires $use_animated_panorama_uv set to true)
    // (tutorial can be found here: https://wiki.bedrock.dev/json-ui/aseprite-animations.html#creating-an-animation-in-aseprite)
    // If you enable this, you don't need to fill anything in the frame properties section or frame offsets section)
    // Make sure both the sprite file and the JSON file Aseprite created must have same name but different extensions
    "$use_aseprite_flipbook_anim_format": false,

    // Sprite Initial UV if you enable $use_aseprite_flipbook_anim_format
    "$sprite_initial_uv": [ 0, 0 ],

    // ---------------------------------------
    // FRAME PROPERTIES
    // ---------------------------------------

    // UV Frame Size
    "$uv_frame_size": [ 740, 416 ],

    // Start Frame Control (don't change this if you don't know what this is)
    // Syntax: "@<namespace_id>.<prefix>_<frame_number>"
    "$start_uv_frame": "@zk_custom_theme.pano_uv_1",

    // Anim Namespace ID: the key after "@"
    // and before ".<prefix>" in "$start_uv_frame"
    "$namespace_id": "zk_custom_theme",

    // Prefix: the key after "@<namespace_id>."
    // and before "_<frame_number>" in "$start_uv_frame"
    "$anim_control_prefix": "pano_uv",

    // Animated Panorama' Duration for each frame
    // accepted value: any positive real numbers except 0
    // Tip: frame_duration = 1/panorama_fps
    "$frame_duration": 0.04,

    // Total Frames: how many frames your custom panorama texture have,
    // accepted value: any natural numbers from 1-500
    "$total_frames": 23,

    // [Advanced] Custom Panorama Child Controls
    // You can add more controls for panorama here (like custom animated particles, or flipbooks...)
    "$custom_panorama_child_controls": []
  },

  // ================================================
  // THEME METADATA
  "theme_metadata": {

    // Leave "$author" and "$name" fields empty if you don't want to show Metadata button in Start Screen
    // Use \n if you want to add another text row!
    // Note: Make this as short as possible, don't too long!

    // Name of the Theme
    "$name": "",

    // Author
    "$author": "",

    // Attribution (required if this theme pack is public)
    "$attribution": "",

    // Metadata Info (Description, may include all attribution info)
    "$metadata_info": "",

    // Custom Attribution Button Icon
    "$button_icon_texture": "textures/ui/infobulb"
  },


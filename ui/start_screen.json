// Start screen
{
    // Gear icon
    "gear_icon": {
        "type": "image",
        "texture": "textures/ui/gear",
        "size": [14, 14]
    },

    // Settings gear button
    "settings_gear_button@common_buttons.light_content_button": {
        "$pressed_button_name": "button.menu_settings",
        "$button_tts_header": "menu.settings",
        "size": [24, 24],
        "$button_content": "start.gear_icon",
        "$focus_id": "settings_button",
        "$focus_override_left": "FOCUS_OVERRIDE_STOP",
        "$focus_override_right": "play_button"
    },

    // Play button content
    "play_button_content": {
        "type": "panel",
        "controls": [
            {
                "play_icon": {
                    "type": "image",
                    "texture": "textures/ui/icon_recipe_nature",
                    "size": [17, 17],
                    "anchor_from": "left_middle",
                    "anchor_to": "left_middle",
                    "offset": [11, 0],
                    "layer": 1
                }
            },
            {
                "play_button_label": {
                    "type": "label",
                    "text": "$button_text",
                    "color": "$text_color",
                    "font_type": "MinecraftTen",
                    "backup_font_type": "default",
                    "font_scale_factor": 1.2,
                    "max_size": ["100% - 48px", 16],
                    "offset": [0, -1],
                    "layer": 1
                }
            }
        ]
    },

    // ZK play button
    "zk_play_button@common_buttons.zk_design:green_content_button": {
        "size": ["100% - 2px", "100% - 2px"],
        "$button_focus_precedence": 100,
        "default_focus_precedence": 1,
        "$pressed_button_name": "$play_button_target",
        "$button_text": "menu.play",
        "$focus_id": "play_button",
        "$focus_override_left": "sidebar_button",
        "$button_content": "start.play_button_content",
        "button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "pressed"
            },
            {
                "to_button_id": "play_button.is_hovered",
                "mapping_type": "pressed"
            }
        ]
    },

    // Secondary button content
    "zk_secondary_button_content": {
        "type": "panel",
        "controls": [
            {
                "icon": {
                    "type": "image",
                    "texture": "$zk_button_icon",
                    "$zk_button_icon_size|default": [24, 24],
                    "$zk_button_icon_offset|default": [8, -1],
                    "size": "$zk_button_icon_size",
                    "anchor_from": "left_middle",
                    "anchor_to": "left_middle",
                    "offset": "$zk_button_icon_offset",
                    "layer": 1
                }
            },
            {
                "label": {
                    "type": "label",
                    "text": "$button_text",
                    "color": "$text_color",
                    "max_size": ["100% - 48px", 10],
                    "layer": 1
                }
            }
        ]
    },

    // Servers button
    "zk_servers_button@zk_oreui_design__buttons.light_content_button": {
        "size": ["100% - 2px", "100% - 2px"],
        "$pressed_button_name": "button.menu_servers",
        "$button_text": "menu.servers",
        "$zk_button_icon": "textures/ui/servers",
        "$zk_button_icon_size": [15, 15],
        "$zk_button_icon_offset": [12, 0],
        "$focus_id": "servers_button",
        "$button_content": "start.zk_secondary_button_content",
        "button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "pressed"
            }
        ]
    },

    // Servers button stack
    "zk_servers_stack@start.stacked_row": {
        "size": ["100%", 28],
        "controls": [
            {
                "servers_button@start.zk_servers_button": {}
            }
        ]
    },

    // Play button stack
    "play_button_stack": {
        "size": ["100%", 30],
        "modifications": [
            {
                "control_name": "play_button",
                "operation": "replace",
                "value": {
                    "play_button@start.zk_play_button": {}
                }
            }
        ]
    },

    // Store button stack
    "store_button_stack": {
        "size": ["100%", 28]
    },

    // Main buttons panel
    "main_buttons_panel": {
        "size": [160, "100%c"]
    },

    // Space below the main buttons
    "main_buttons_stack_panel/padding_fill_2": {
        "size": ["100%", "8%"]
    },

    // Space above the title
    "main_buttons_stack_panel/title_offset_padding": {
        "size": ["100%", "5%"]
    },

    // Main buttons panel stacked rows
    "main_buttons_panel/stacked_rows": {
        "modifications": [
            {
                "control_name": "play",
                "operation": "insert_after",
                "value": [
                    {
                        "servers@start.zk_servers_stack": {
                            "ignored": "(not $play_button_visible)"
                        }
                    }
                ]
            },
            {
                "control_name": "settings_and_editions_panel",
                "operation": "remove"
            },
            {
                "control_name": "settings",
                "operation": "remove"
            },
            {
                "control_name": "realms",
                "operation": "remove"
            },
            {
                "control_name": "launch_editions",
                "operation": "remove"
            }
        ]
    },

    // Skin panel
    "skin_panel": {
        "size": ["30%", 160],
        "offset": [0, "-8%"]
    },

    // Skin bottom area
    "skin_panel/centering_panel": {
        "size": ["100%", 0]
    },

    // Skin change button
    "skin_panel/centering_panel/change_profile_or_skin": {
        "ignored": true
    },

    // Upper online buttons panel
    "upper_online_buttons_panel": {
        "ignored": true
    },

    // Lower online buttons panel
    "lower_online_buttons_panel": {
        "ignored": true
    },

    // Event panel position
    "start_screen_content/online_button_stack": {
        "offset": [0, "-8% - 5px"]
    },

    // Event button
    "gathering_button": {
        "size": [56, 15]
    },

    // Event badge
    "gathering_badge": {
        "size": [56, "100%"]
    },

    // Event animated badge
    "gathering_badge_gif": {
        "size": [56, "100%"]
    },

    // Event badge area
    "badge_and_caption/badge_and_padding": {
        "size": ["100%", 17]
    },

    // Event countdown text
    "gathering_caption/countdown_text": {
        "size": [50, "default"],
        "font_scale_factor": 0.6
    },

    // Footer label
    "zk_footer_label": {
        "type": "label",
        "color": "$main_header_text_color",
        "size": ["default", 10],
        "anchor_from": "right_middle",
        "anchor_to": "right_middle",
        "layer": 1
    },

    // Footer
    "zk_footer": {
        "type": "image",
        "texture": "textures/ui/hud_tip_text_background",
        "alpha": 0.5,
        "size": ["100%c + 8px", "100%c + 4px"],
        "anchor_from": "bottom_right",
        "anchor_to": "bottom_right",
        "offset": [-2, -2],
        "controls": [
            {
                "lines": {
                    "type": "stack_panel",
                    "size": ["100%cm", "100%c"],
                    "use_child_anchors": true,
                    "controls": [
                        {
                            "version_line": {
                                "type": "panel",
                                "size": ["100%cm", 10],
                                "anchor_from": "right_middle",
                                "anchor_to": "right_middle",
                                "controls": [
                                    {
                                        "version@start.zk_footer_label": {
                                            "text": "#version",
                                            "bindings": [
                                                {
                                                    "binding_name": "#version"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "credits_line": {
                                "type": "panel",
                                "size": ["100%cm", 10],
                                "anchor_from": "right_middle",
                                "anchor_to": "right_middle",
                                "controls": [
                                    {
                                        "credits@start.zk_footer_label": {
                                            "text": "©Mojang AB - ZK UI"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Text panel
    "text_panel": {
        "modifications": [
            {
                "control_name": "copyright",
                "operation": "remove"
            },
            {
                "control_name": "version",
                "operation": "replace",
                "value": {
                    "version@start.zk_footer": {}
                }
            }
        ]
    },

    // Start screen
    "start_screen": {
        "$screen_content": "start.toggleable_start_screen_content"
    },

    // Toggleable start screen content
    "toggleable_start_screen_content": {
        "type": "panel",
        "size": ["100%", "100%"],
        "bindings": [
            {
                "binding_name": "(not #screen_needs_rebuild)",
                "binding_name_override": "#visible"
            }
        ],
        "controls": [
            {
                "content@start.start_screen_content": {
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "start_screen_content_toggle_show",
                            "source_property_name": "#toggle_state",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "content_hidden@start.start_screen_hidden_content": {
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "start_screen_content_toggle_show",
                            "source_property_name": "(not #toggle_state)",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            }
        ]
    },

    // Content visibility toggle
    "start_screen_content_toggle@common_toggles.light_content_toggle": {
        "$toggle_name": "start_screen_content_toggle",
        "$button_content": "start.start_screen_content_toggle_button_content",
        "$radio_toggle_group": true,
        "$toggle_group_default_selected": 0,
        "size": [24, 24],
        "$toggle_tts_toggle_on_text": "",
        "$toggle_tts_toggle_off_text": "",
        "$ignore_cancel_mapping|default": true,
        "$button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "button.menu_select",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "button.menu_ok",
                "mapping_type": "focused",
                "input_mode_condition": "not_gamepad"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "button.toggle_screen_content",
                "mapping_type": "focused",
                "input_mode_condition": "gamepad_and_not_gaze"
            },
            {
                "ignored": "$ignore_cancel_mapping",
                "from_button_id": "button.menu_cancel",
                "to_button_id": "button.menu_select",
                "mapping_type": "global"
            },
            {
                "from_button_id": "button.controller_back",
                "to_button_id": "button.toggle_screen_content",
                "mapping_type": "global"
            }
        ]
    },

    // Hide content toggle
    "start_screen_content_toggle_hide@start.start_screen_content_toggle": {
        "$toggle_view_binding_name": "start_screen_content_toggle_hide",
        "$toggle_icon": "textures/zk_ui/icons/eye_opened",
        "$toggle_group_forced_index": 1,
        "$toggle_tts_header": "zk.start.hideInterface",
        "$focus_override_left": "FOCUS_OVERRIDE_STOP"
    },

    // Show content toggle
    "start_screen_content_toggle_show@start.start_screen_content_toggle": {
        "$toggle_view_binding_name": "start_screen_content_toggle_show",
        "$toggle_icon": "textures/zk_ui/icons/eye_closed",
        "$default_toggle_state": true,
        "$toggle_group_forced_index": 0,
        "$toggle_tts_header": "zk.start.showInterface",
        "$ignore_cancel_mapping": false
    },

    // Content toggle icon
    "start_screen_content_toggle_button_content": {
        "type": "panel",
        "$toggle_icon|default": "textures/zk_ui/icons/eye_opened",
        "controls": [
            {
                "icon": {
                    "type": "image",
                    "texture": "$toggle_icon",
                    "size": [12, 12]
                }
            }
        ]
    },

    // Hidden start screen content
    "start_screen_hidden_content": {
        "type": "panel",
        "controls": [
            {
                "show_content_toggle@start.start_screen_content_toggle_show": {
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "offset": [2, 2],
                    "layer": 3
                }
            }
        ]
    },

    // Start screen content
    "start_screen_content": {
        "$sidebar_size|default": [142, "100%"],
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "sidebar@zk_start_sidebar.start_sidebar_panel": {}
                    },
                    {
                        "top_left_buttons@zk_start_sidebar.top_left_buttons": {
                            "animation_reset_name": "screen_animation_reset",
                            "anims": [
                                "@zk_start_sidebar.start_sidebar_exit_animation_push_offset",
                                "@zk_start_sidebar.start_sidebar_exit_animation_pop_offset",
                                "@zk_start_sidebar.start_sidebar_entrance_animation_push_offset",
                                "@zk_start_sidebar.start_sidebar_entrance_animation_pop_offset"
                            ]
                        }
                    }
                ]
            }
        ]
    }
}

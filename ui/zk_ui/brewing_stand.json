    // Fuel text panel
    "fuel_text_panel": {
        "type": "label",
        "text": "#text",
        "size": ["default", "default"],
        "color": "$title_text_color",
        "anchor_from": "bottom_left",
        "anchor_to": "top_left",
        "offset": [0, 1],
        "layer": 9,
        "font_scale_factor": 0.8,
        "$c": "brewing_fuel_item",
        "bindings": [
            {
                "binding_type": "collection_details",
                "binding_collection_name": "$c"
            },
            {
                "binding_name": "#inventory_stack_count",
                "binding_type": "collection",
                "binding_collection_name": "$c"
            },
            {
                "binding_name": "#item_id_aux",
                "binding_type": "collection",
                "binding_collection_name": "$c"
            },
            {
                "binding_type": "view",
                "source_property_name": "((0 + #inventory_stack_count) + (not (#item_id_aux = -1) * (#inventory_stack_count < 2)))",
                "target_property_name": "#stack_count"
            },
            {
                "binding_name": "#brewing_fuel_ratio",
                "binding_condition": "always",
                "binding_type": "global"
            },
            {
                "binding_type": "view",
                "source_property_name": "(100 - #brewing_fuel_ratio * 100)",
                "target_property_name": "#fuel_ratio"
            },
            {
                "binding_type": "view",
                "source_property_name": "(1 * ((#fuel_ratio > 4) + (#fuel_ratio > 9) + (#fuel_ratio > 14) + (#fuel_ratio > 19) + (#fuel_ratio > 24) + (#fuel_ratio > 29) + (#fuel_ratio > 34) + (#fuel_ratio > 39) + (#fuel_ratio > 44) + (#fuel_ratio > 49) + (#fuel_ratio > 54) + (#fuel_ratio > 59) + (#fuel_ratio > 64) + (#fuel_ratio > 69) + (#fuel_ratio > 74) + (#fuel_ratio > 79) + (#fuel_ratio > 84) + (#fuel_ratio > 89) + (#fuel_ratio > 94) + (#fuel_ratio > 99))",
                "target_property_name": "#total_ratio"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#total_ratio + (#stack_count * 20))",
                "target_property_name": "#total_value"
            },
            {
                "binding_type": "view",
                "source_property_name": "('§z' + #total_value + 'x')",
                "target_property_name": "#text"
            }
        ]
    },


            {
                "binding_type": "view",
                "source_property_name": "((#val > 0) + (#val > 1) + (#val > 2) + (#val > 3) + (#val > 4) + (#val > 5) + (#val > 6) + (#val > 7) + (#val > 8) + (#val > 9) + (#val > 10) + (#val > 11) + (#val > 12) + (#val > 13) + (#val > 14) + (#val > 15) + (#val > 16) + (#val > 17) + (#val > 18) + (#val > 19))",
                "target_property_name": "#second"
            },
            {
                "binding_type": "view",
                "source_property_name": "('§z' + #second + 's')",

// ZK brewing stand
{
    "namespace": "zk_brewing",

    // Potion container item
    "potion_container_item@zk_common.guide_container_item": {
        "$item_texture": "('potion_bottle_' + $potion_tex)",
        "$text_label": "$potion_level",
        "$potion_tex|default": "$potion_item_name"
    },

    // Clock icon
    "clock_icon": {
        "type": "image",
        "texture": "textures/items/clock_item",
        "layer": 4,
        "anchor_from": "top_right",
        "anchor_to": "top_right",
        "size": [8, 8]
    },

    // Plus icon
    "plus_icon@zk_common.container_item_holder": {
        "controls": [
            {
                "plus@anvil.plus_sign_icon": {}
            }
        ]
    },

    // Potion cell image default
    "potion_cell_image_default": {
        "type": "panel",
        "$additional_control|default": "common.empty_panel",
        "$cell_texture|default": "textures/ui/recipe_book_item_bg",
        "$show_item_texture|default": true,
        "$is_hover_state|default": false,
        "$hover_text|default": "text",
        "controls": [
            {
                "bg": {
                    "type": "image",
                    "texture": "$cell_texture",
                    "layer": 1
                }
            },
            {
                "item_texture": {
                    "ignored": "(not $show_item_texture)",
                    "type": "image",
                    "texture": "('textures/items/potion_bottle_' + $potion_tex)",
                    "size": [16, 16],
                    "layer": 2
                }
            },
            {
                "hover_text": {
                    "type": "panel",
                    "controls": [
                        {
                            "_hover_text": {
                                "type": "button",
                                "size": [1, 1],
                                "follows_cursor": false,
                                "offset": [-2, 14],
                                "allow_clipping": false,
                                "ignored": "(not $is_hover_state)",
                                "controls": [
                                    {
                                        "hoverText": {
                                            "type": "image",
                                            "texture": "textures/ui/purpleBorder",
                                            "allow_clipping": false,
                                            "layer": 512,
                                            "size": ["100%c + 8px", "100%c + 8px"],
                                            "anchor_to": "top_left",
                                            "offset": [6, 6],
                                            "controls": [
                                                {
                                                    "text": {
                                                        "type": "label",
                                                        "text": "('%potion.' + $potion_item_name + '.name')",
                                                        "size": ["default", "default"],
                                                        "layer": 513,
                                                        "color": "$f_color_format"
                                                    }
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "additional_control@$additional_control": {}
            }
        ],
        "$potion_tex|default": "$potion_item_name"
    },

    // Potion cell image hover
    "potion_cell_image_hover@zk_brewing.potion_cell_image_default": {
        "$cell_texture": "textures/ui/slot_enabled_hover",
        "$is_hover_state": true
    },

    // Potion container item tog
    "potion_container_item_tog@zk_common.raw_toggle": {
        "size": [18, 18],
        "$radio_toggle_group": true,
        "$toggle_group_forced_index": 2,
        "$unchecked_control": "zk_brewing.potion_cell_image_default",
        "$checked_control": "zk_brewing.potion_cell_image_default",
        "$unchecked_hover_control": "zk_brewing.potion_cell_image_hover",
        "$checked_hover_control": "zk_brewing.potion_cell_image_hover",
        "$toggle_name": "('p_' + $potion_item_name)",
        "$toggle_view_binding_name": "($potion_item_name + '_tog')"
    },

    // Potion expand back tog hover
    "potion_expand_back_tog_hover@zk_brewing.potion_expand_back_tog_default": {
        "$is_hover": true
    },

    // Potion expand back tog default
    "potion_expand_back_tog_default": {
        "$is_hover|default": false,
        "type": "panel",
        "controls": [
            {
                "text": {
                    "type": "label",
                    "text": "< %gui.back",
                    "size": ["default", "default"],
                    "anchor_from": "left_middle",
                    "anchor_to": "left_middle",
                    "color": "$title_text_color",
                    "controls": [
                        {
                            "hover": {
                                "ignored": "(not $is_hover)",
                                "type": "image",
                                "texture": "textures/ui/Black",
                                "size": ["100% + 4px", "100% + 2px"],
                                "alpha": 0.2,
                                "layer": -1
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Pot ext cont content
    "pot_ext_cont_content": {
        "type": "stack_panel",
        "size": ["100%cm", "100%c"],
        "anchor_from": "top_middle",
        "anchor_to": "top_middle",
        "offset": [0, 2],
        "$has_additional_row|default": false,
        "$can_be_extent|default": true,
        "$can_be_double|default": true,
        "$clr_2|default": "§9",
        "$clr|default": "§9",
        "$2_potion_duration|default": " (3:00)",
        "$potion_item_name_": "$potion_item_name",
        "$2_potion_item_name|default": "$potion_item_name",
        "$potion_level|default": "%enchantment.level.2",
        "$potion_duration|default": " (3:00)",
        "$potion_duration_db|default": " (8:00)",
        "$potion_duration_ii|default": " (1:30)",
        "$add_hover_text|default": "",
        "$add_hover_text_ii|default": "",
        "$add_hover_text_db|default": "",
        "$2_potion_level|default": "",
        "controls": [
            {
                "stackver": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%c", 18],
                    "controls": [
                        {
                            "water_bottle@zk_brewing.potion_container_item": {
                                "$item_texture": "potion_bottle_absorption",
                                "$hover_text": "potion.emptyPotion.name"
                            }
                        },
                        {
                            "plus_icon@zk_brewing.plus_icon": {}
                        },
                        {
                            "nether_wart@zk_common.guide_container_item": {
                                "$item_texture": "nether_wart",
                                "$hover_text": "item.nether_wart.name"
                            }
                        },
                        {
                            "arrow_holder": {
                                "type": "panel",
                                "size": [24, "100%"],
                                "controls": [
                                    {
                                        "arrow_icon@cartography.arrow_icon": {}
                                    }
                                ]
                            }
                        },
                        {
                            "awkward_potion@zk_brewing.potion_container_item": {
                                "$item_texture": "potion_bottle_absorption",
                                "$hover_text": "potion.awkward.name"
                            }
                        }
                    ]
                }
            },
            {
                "arrow_down_holder": {
                    "ignored": "$has_additional_row",
                    "type": "panel",
                    "size": ["100%sm", 9],
                    "controls": [
                        {
                            "arrow_down": {
                                "type": "image",
                                "texture": "textures/ui/arrow_down_small",
                                "size": [13, 9]
                            }
                        }
                    ]
                }
            },
            {
                "stackver_2": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%c", 18],
                    "$ingredient_hover_text|default": "a",
                    "$ingredient_item_texture|default": "a",
                    "controls": [
                        {
                            "awkward_potion@zk_brewing.potion_container_item": {
                                "$item_texture": "potion_bottle_absorption",
                                "$hover_text": "potion.awkward.name"
                            }
                        },
                        {
                            "plus_icon@zk_brewing.plus_icon": {}
                        },
                        {
                            "ingredient@zk_common.guide_container_item": {
                                "$i_use_item_renderer|default": false,
                                "$i_item_id_aux|default": 0,
                                "$a_texture|default": "('textures/items/' + $ingredient_item_texture)",
                                "$i_texture": "$a_texture",
                                "$hover_text": "$ingredient_hover_text",
                                "$use_item_renderer": "$i_use_item_renderer",
                                "$item_id_aux": "$i_item_id_aux"
                            }
                        },
                        {
                            "arrow_holder": {
                                "type": "panel",
                                "size": [24, "100%"],
                                "controls": [
                                    {
                                        "arrow_icon@cartography.arrow_icon": {}
                                    }
                                ]
                            }
                        },
                        {
                            "potion@zk_brewing.potion_container_item": {
                                "$item_texture": "('potion_bottle_' + $potion_tex)",
                                "$hover_text": "('%potion.' + $2_potion_item_name + '.name\n' + $clr + '%potion.' + $2_potion_item_name + $2_potion_level + $2_potion_duration + $add_hover_text)"
                            }
                        }
                    ]
                }
            },
            {
                "stackver_22": {
                    "ignored": "(not $has_additional_row)",
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%c", 18],
                    "controls": [
                        {
                            "potion@zk_brewing.potion_container_item": {
                                "$item_texture": "('potion_bottle_' + $potion_tex)",
                                "$hover_text": "('%potion.' + $2_potion_item_name + '.name\n' + $clr + '%potion.' + $2_potion_item_name + $2_potion_level + $2_potion_duration + $add_hover_text)"
                            }
                        },
                        {
                            "plus_icon@zk_brewing.plus_icon": {}
                        },
                        {
                            "spider_eye_fermented@zk_common.guide_container_item": {
                                "$item_texture": "spider_eye_fermented",
                                "$hover_text": "item.fermented_spider_eye.name"
                            }
                        },
                        {
                            "arrow_holder": {
                                "type": "panel",
                                "size": [24, "100%"],
                                "controls": [
                                    {
                                        "arrow_icon@cartography.arrow_icon": {}
                                    }
                                ]
                            }
                        },
                        {
                            "potion@zk_brewing.potion_container_item": {
                                "$hover_text": "('%potion.' + $potion_item_name + '.name\n' + $clr_2 + '%potion.' + $potion_item_name + $potion_duration + $add_hover_text)"
                            }
                        }
                    ]
                }
            },
            {
                "divider_holder": {
                    "type": "panel",
                    "size": "$size",
                    "$size|default": ["100%sm", 18],
                    "variables": [
                        {
                            "requires": "$has_additional_row",
                            "$size": ["100%sm", 8]
                        }
                    ],
                    "controls": [
                        {
                            "divider": {
                                "type": "image",
                                "texture": "textures/ui/White",
                                "size": ["100% + 8px", 1],
                                "color": "$title_text_color"
                            }
                        }
                    ]
                }
            },
            {
                "stackver_3": {
                    "ignored": "(not $can_be_double)",
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%c", 18],
                    "controls": [
                        {
                            "potion@zk_brewing.potion_container_item": {
                                "$hover_text": "('%potion.' + $potion_item_name + '.name\n' + $clr_2 + '%potion.' + $potion_item_name + $2_potion_level + $potion_duration + $add_hover_text)"
                            }
                        },
                        {
                            "plus_icon@zk_brewing.plus_icon": {}
                        },
                        {
                            "glowstone_dust@zk_common.guide_container_item": {
                                "$item_texture": "glowstone_dust",
                                "$hover_text": "item.glowstone_dust.name"
                            }
                        },
                        {
                            "arrow_holder": {
                                "type": "panel",
                                "size": [24, "100%"],
                                "controls": [
                                    {
                                        "arrow_icon@cartography.arrow_icon": {}
                                    }
                                ]
                            }
                        },
                        {
                            "potion@zk_brewing.potion_container_item": {
                                "$hover_text": "('%potion.' + $potion_item_name + '.name\n' + $clr_2 + '%potion.' + $potion_item_name + ' ' + $potion_level + $potion_duration_ii + $add_hover_text_ii)",
                                "$show_text_label": true,
                                "$text_label_anchor": "top_right",
                                "$text_label_offset": [0, -1]
                            }
                        }
                    ]
                }
            },
            {
                "stackver_4": {
                    "ignored": "(not $can_be_extent)",
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%c", 18],
                    "controls": [
                        {
                            "potion@zk_brewing.potion_container_item": {
                                "$hover_text": "('%potion.' + $potion_item_name + '.name\n' + $clr_2 + '%potion.' + $potion_item_name + $2_potion_level + $potion_duration + $add_hover_text)"
                            }
                        },
                        {
                            "plus_icon@zk_brewing.plus_icon": {}
                        },
                        {
                            "redstone_dust@zk_common.guide_container_item": {
                                "$item_texture": "redstone_dust",
                                "$hover_text": "item.redstone.name"
                            }
                        },
                        {
                            "arrow_holder": {
                                "type": "panel",
                                "size": [24, "100%"],
                                "controls": [
                                    {
                                        "arrow_icon@cartography.arrow_icon": {}
                                    }
                                ]
                            }
                        },
                        {
                            "potion@zk_brewing.potion_container_item": {
                                "$hover_text": "('%potion.' + $potion_item_name + '.name\n' + $clr_2 + '%potion.' + $potion_item_name + $2_potion_level + $potion_duration_db + $add_hover_text_db)",
                                "$additional_control": "zk_brewing.clock_icon"
                            }
                        }
                    ]
                }
            },
            {
                "stackver_4": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%c", 18],
                    "controls": [
                        {
                            "potion@zk_brewing.potion_container_item": {
                                "$hover_text": "('%potion.' + $potion_item_name + '.name')"
                            }
                        },
                        {
                            "plus_icon@zk_brewing.plus_icon": {}
                        },
                        {
                            "gunpowder@zk_common.guide_container_item": {
                                "$item_texture": "gunpowder",
                                "$hover_text": "item.gunpowder.name"
                            }
                        },
                        {
                            "arrow_holder": {
                                "type": "panel",
                                "size": [24, "100%"],
                                "controls": [
                                    {
                                        "arrow_icon@cartography.arrow_icon": {}
                                    }
                                ]
                            }
                        },
                        {
                            "potion@zk_brewing.potion_container_item": {
                                "$item_texture": "('potion_bottle_splash_' + $potion_tex)",
                                "$hover_text": "('%potion.' + $potion_item_name + '.splash.name')"
                            }
                        }
                    ]
                }
            },
            {
                "stackver_4": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%c", 18],
                    "controls": [
                        {
                            "potion@zk_brewing.potion_container_item": {
                                "$item_texture": "('potion_bottle_splash_' + $potion_tex)",
                                "$hover_text": "('%potion.' + $potion_item_name + '.splash.name')"
                            }
                        },
                        {
                            "plus_icon@zk_brewing.plus_icon": {}
                        },
                        {
                            "dragons_breath@zk_common.guide_container_item": {
                                "$item_texture": "dragons_breath",
                                "$hover_text": "item.dragon_breath.name"
                            }
                        },
                        {
                            "arrow_holder": {
                                "type": "panel",
                                "size": [24, "100%"],
                                "controls": [
                                    {
                                        "arrow_icon@cartography.arrow_icon": {}
                                    }
                                ]
                            }
                        },
                        {
                            "potion@zk_brewing.potion_container_item": {
                                "$item_texture": "('potion_bottle_lingering_' + $potion_tex)",
                                "$hover_text": "('%potion.' + $potion_item_name + '.linger.name')"
                            }
                        }
                    ]
                }
            }
        ],
        "$potion_tex|default": "$potion_item_name"
    },

    // Potion expanded panel
    "potion_expanded_panel": {
        "type": "panel",
        "size": [146, 166],
        "controls": [
            {
                "tab_content": {
                    "type": "panel",
                    "layer": 1,
                    "size": ["100%", "100%"],
                    "controls": [
                        {
                            "content": {
                                "type": "stack_panel",
                                "size": ["100% - 12px", "100% - 12px"],
                                "orientation": "vertical",
                                "controls": [
                                    {
                                        "padding_1@common.empty_panel": {
                                            "size": ["100%", 2]
                                        }
                                    },
                                    {
                                        "container_guide_title_panel": {
                                            "type": "panel",
                                            "size": ["100%", 10],
                                            "controls": [
                                                {
                                                    "back_toggle@zk_common.raw_toggle": {
                                                        "size": [52, "100%"],
                                                        "anchor_from": "left_middle",
                                                        "anchor_to": "left_middle",
                                                        "$radio_toggle_group": true,
                                                        "$toggle_default_state": true,
                                                        "$toggle_group_forced_index": 1,
                                                        "$toggle_name": "('p_' + $potion_item_name)",
                                                        "$unchecked_control": "zk_brewing.potion_expand_back_tog_default",
                                                        "$unchecked_hover_control": "zk_brewing.potion_expand_back_tog_hover"
                                                    }
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "padding_3@common.empty_panel": {
                                            "size": ["100%", 2]
                                        }
                                    },
                                    {
                                        "content_control": {
                                            "type": "panel",
                                            "size": ["100%", "fill"],
                                            "$pot_ext_cont_content|default": "zk_brewing.pot_ext_cont_content",
                                            "controls": [
                                                {
                                                    "content@$pot_ext_cont_content": {}
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Brewing guide scrolling content
    "brewing_guide_scrolling_content": {
        "type": "panel",
        "controls": [
            {
                "stacking": {
                    "type": "stack_panel",
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "size": ["100%", "100%c"],
                    "controls": [
                        {
                            "column_1": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "size": ["100%c", "100%cm"],
                                "controls": [
                                    {
                                        "swiftness@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "moveSpeed"
                                        }
                                    },
                                    {
                                        "moveSlowdown@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "moveSlowdown"
                                        }
                                    },
                                    {
                                        "jump@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "jump"
                                        }
                                    },
                                    {
                                        "heal@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "heal"
                                        }
                                    },
                                    {
                                        "harm@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "harm"
                                        }
                                    },
                                    {
                                        "poison@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "poison"
                                        }
                                    },
                                    {
                                        "regeneration@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "regeneration"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "column_2": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "size": ["100%c", "100%cm"],
                                "controls": [
                                    {
                                        "fireResistance@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "fireResistance"
                                        }
                                    },
                                    {
                                        "damageBoost@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "damageBoost"
                                        }
                                    },
                                    {
                                        "waterBreathing@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "waterBreathing"
                                        }
                                    },
                                    {
                                        "nightVision@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "nightVision"
                                        }
                                    },
                                    {
                                        "invisibility@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "invisibility"
                                        }
                                    },
                                    {
                                        "turtleMaster@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "turtleMaster"
                                        }
                                    },
                                    {
                                        "slowFalling@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "slowFalling",
                                            "$potion_tex": "slowFall"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "column_3": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "size": ["100%c", "100%cm"],
                                "controls": [
                                    {
                                        "weakness@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "weakness"
                                        }
                                    },
                                    {
                                        "windCharged@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "windCharged"
                                        }
                                    },
                                    {
                                        "weaving@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "weaving"
                                        }
                                    },
                                    {
                                        "oozing@zk_brewing.potion_container_item_tog": {
                                            "$potion_item_name": "oozing"
                                        }
                                    },
                                    {
                                        "infested@zk_common.guide_container_item": {
                                            "$background_images": "zk_brewing.bg_jsj",
                                            "$item_texture": "potion_bottle_infested",
                                            "$hover_text": "('§d%potion.infested.name\n§e%potion.awkward.name §7+ §a%tile.stone.stone.name §7→ §d%potion.infested.name\n§6%zk.infested.splash§7: §d%potion.infested.name §7+ §8%item.gunpowder.name §7→ §d%potion.infested.splash.name\n§6%zk.infested.lingering§7: §d%potion.infested.splash.name §7+ §5%item.dragon_breath.name §7→ §d%potion.infested.linger.name\n§8%zk.infested.note')"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Speed p expand
    "speed_p_expand@zk_brewing.potion_expanded_panel": {
        "$potion_item_name": "moveSpeed",
        "$ingredient_hover_text": "item.sugar.name",
        "$ingredient_item_texture": "sugar"
    },


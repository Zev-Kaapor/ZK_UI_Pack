    // Accurate exp progress stack
    "accurate_exp_progress_stack": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "size": ["100%c", "100%cm"],
        "controls": [
            {
                "accurate_exp_progress_label_content": {
                    "type": "label",

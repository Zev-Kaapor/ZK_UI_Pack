// ZK HUD toggleables
{
    "namespace": "zk_hud_toggleables",

    // Main layout panel
    "main_layout_panel@zk_subpack_settings.hud_modules_settings": {
        "type": "panel",
        "size": ["100%", "100%"],
        "$zk_hud_modules_toggle_size|default": [18, 18],
        "$zk_hud_modules_toggle_anchor_from|default": "top_middle",
        "$zk_hud_modules_toggle_anchor_to|default": "top_right",
        "$zk_hud_modules_toggle_offset|default": [-30, 2],
        "$zk_hud_modules_toggle_alpha|default": 1,
        "$zk_hud_modules_disable_tooltip|default": false,
        "bindings": [
            {
                "binding_name": "#hud_visible",
                "binding_type": "global"
            },
            {
                "binding_name": "#layout_customization_main_panel_visible"
            },
            {
                "binding_name": "#layout_customization_sub_panel_visible"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#hud_visible and not (#lcmp_visible or #lcsp_visible))",
                "target_property_name": "#visible"
            },
            {
                "binding_name": "#hud_alpha",
                "binding_name_override": "#alpha",
                "binding_type": "global"
            },
            {
                "binding_name": "#hud_propagate_alpha",
                "binding_name_override": "#propagateAlpha",
                "binding_type": "global"
            }
        ],
        "controls": [
            {
                "hud_toggles_menu_panels@zk_hud_toggleables.hud_toggles_menu_panels": {
                    "bindings": [
                        {
                            "binding_name": "(not #is_using_gamepad)",
                            "binding_name_override": "#visible"
                        }
                    ]
                }
            },
            {
                "hud_toggles_menu_tooltip_panel@zk_hud_toggleables.hud_toggles_menu_tooltip_panel": {}
            }
        ]
    },

    // Hud toggles menu panels
    "hud_toggles_menu_panels": {
        "type": "panel",
        "size": ["100%", "100%"],
        "layer": 0,
        "controls": [
            {
                "hud_toggles_hover_mode": {
                    "ignored": "$touch",
                    "type": "button",
                    "size": ["100%", "100%"],
                    "default_control": "empty",
                    "hover_control": "empty",
                    "pressed_control": "menu",
                    "sound_name": "random.modal_hide",
                    "sound_volume": 1,
                    "sound_pitch": 1,
                    "button_mappings": [
                        {
                            "from_button_id": "button.scoreboard",
                            "to_button_id": "button.peek_hud_toggles_menu",
                            "mapping_type": "global"
                        }
                    ],
                    "bindings": [],
                    "controls": [
                        {
                            "empty@common.empty_panel": {}
                        },
                        {
                            "menu@zk_hud_toggleables.hud_toggles_main_menu_panel": {}
                        }
                    ]
                }
            },
            {
                "hud_toggles_touch_mode": {
                    "ignored": "(not $touch)",
                    "type": "panel",
                    "size": ["100%", "100%"],
                    "controls": [
                        {
                            "menu@zk_hud_toggleables.hud_toggles_menu_toggle_panel": {}
                        },
                        {
                            "content@zk_hud_toggleables.hud_toggles_touch_onscreen_menu": {}
                        },
                        {
                            "hud_list_scoreboard@zk_hud_toggleables.hud_list_scoreboard": {
                                "bindings": [
                                    {
                                        "binding_type": "view",
                                        "source_control_name": "hud_toggles_touch_mode__scoreboard_list",
                                        "source_property_name": "#toggle_state",
                                        "target_property_name": "#visible"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Hud toggles menu tooltip panel
    "hud_toggles_menu_tooltip_panel@common.tooltip_background": {
        "ignored": "($touch or $zk_hud_modules_disable_tooltip)",
        "size": ["100%cm + 10px", "100%cm + 10px"],
        "anchor_from": "bottom_left",
        "anchor_to": "bottom_left",
        "offset": [4, -4],
        "layer": 120,
        "propagate_alpha": true,
        "anims": [
            "@zk_hud_toggleables.anim_hud_toggles_menu_tooltip_wait",
            "@zk_hud_toggleables.anim_hud_toggles_menu_tooltip_destroy"
        ],
        "bindings": [
            {
                "binding_name": "(not #is_using_gamepad)",
                "binding_name_override": "#visible"
            }
        ],
        "controls": [
            {
                "content_tip_1": {
                    "type": "label",
                    "size": ["default", "default"],
                    "max_size": [280, "default"],
                    "text": "hudScreen.toggleables.tooltip",
                    "layer": 1
                }
            }
        ]
    },

    // Anim hud toggles menu tooltip wait
    "anim_hud_toggles_menu_tooltip_wait": {
        "anim_type": "wait",
        "duration": 10,
        "next": "@zk_hud_toggleables.anim_hud_toggles_menu_tooltip_alpha"
    },

    // Anim hud toggles menu tooltip alpha
    "anim_hud_toggles_menu_tooltip_alpha": {
        "anim_type": "alpha",
        "easing": "in_expo",
        "scale_from_starting_alpha": true,
        "duration": 0.6,
        "from": 1,
        "to": 0,
        "destroy_at_end": "hud_toggles_menu_tooltip_panel"
    },

    // Anim hud toggles menu tooltip destroy
    "anim_hud_toggles_menu_tooltip_destroy@zk_hud_toggleables.anim_hud_toggles_menu_tooltip_alpha": {
        "easing": "out_expo",
        "duration": 0.2,
        "play_event": "button.peek_hud_toggles_menu"
    },

    // Anim peek hud players list offset
    "anim_peek_hud_players_list_offset": {
        "anim_type": "offset",
        "easing": "out_expo",
        "duration": 0.3,
        "from": "$anim_from",
        "to": [0, 0],
        "reset_event": "button.peek_hud_toggles_menu",
        "$anim_from": [0, "-50%"],
        "variables": [
            {
                "requires": "$enable_reduced_motion_mode",
                "$anim_from": [0, 0]
            }
        ]
    },

    // Anim peek hud toggles menu list offset
    "anim_peek_hud_toggles_menu_list_offset": {
        "anim_type": "offset",
        "easing": "out_expo",
        "duration": 0.3,
        "from": "$anim_from",
        "to": [0, 0],
        "reset_event": "button.peek_hud_toggles_menu",
        "$anim_from": [0, "25%"],
        "variables": [
            {
                "requires": "$enable_reduced_motion_mode",
                "$anim_from": [0, 0]
            }
        ]
    },

    // Anim peek hud toggles menu alpha
    "anim_peek_hud_toggles_menu_alpha": {
        "anim_type": "alpha",
        "easing": "out_expo",
        "scale_from_starting_alpha": true,
        "duration": 0.3,
        "from": 0,
        "to": 1,
        "reset_event": "button.peek_hud_toggles_menu"
    },

    // Hud toggles menu toggle panel
    "hud_toggles_menu_toggle_panel": {
        "type": "input_panel",
        "size": "$zk_hud_modules_toggle_size",
        "prevent_touch_input": true,
        "propagate_alpha": true,
        "anchor_from": "$zk_hud_modules_toggle_anchor_from",
        "anchor_to": "$zk_hud_modules_toggle_anchor_to",
        "offset": "$zk_hud_modules_toggle_offset",
        "alpha": "$zk_hud_modules_toggle_alpha",
        "layer": 210,
        "controls": [
            {
                "hud_toggles_menu_toggle@common_toggles.transparent_content_toggle": {
                    "size": "$zk_hud_modules_toggle_size",
                    "$toggle_view_binding_name": "hud_toggles_touch_menu_toggle",
                    "$toggle_name": "hud_toggles_touch_menu_toggle",
                    "$radio_toggle_group": true,
                    "$toggle_group_forced_index": 1,
                    "$button_content": "zk_hud_toggleables.hud_toggles_menu_toggle_content",
                    "$default_border_visible": false,
                    "$hover_border_visible": false
                }
            }
        ]
    },

    // Hud toggles menu toggle content
    "hud_toggles_menu_toggle_content": {
        "type": "image",
        "texture": "textures/zk_ui/hud/hud_toggles_button_icon",
        "size": "$zk_hud_modules_toggle_size"
    },

    // Hud toggles touch onscreen menu
    "hud_toggles_touch_onscreen_menu": {
        "type": "input_panel",
        "size": ["100%", "100%"],
        "prevent_touch_input": true,
        "layer": 200,
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "hud_toggles_touch_menu_toggle",
                "source_property_name": "#toggle_state",
                "target_property_name": "#visible_state_a"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#visible_state_a)",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "onscreen_menu_content": {
                    "type": "panel",
                    "size": ["100%c", "100%c"],
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [0, 24],
                    "layer": 10,
                    "controls": [
                        {
                            "background@common.dialog_background_opaque": {
                                "size": ["100%c + 8px", "100%c + 8px"],
                                "controls": [
                                    {
                                        "content_stack@zk_hud_toggleables.hud_toggles_touch_onscreen_menu_content": {}
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "hud_toggles_touch_menu_toggle_off@common_toggles.light_template_toggle": {
                    "size": ["100%", "100%"],
                    "$unchecked_control": "common.empty_panel",
                    "$checked_control": "common.empty_panel",
                    "$unchecked_hover_control": "common.empty_panel",
                    "$checked_hover_control": "common.empty_panel",
                    "$unchecked_locked_control": "common.empty_panel",
                    "$checked_locked_control": "common.empty_panel",
                    "$unchecked_locked_hover_control": "common.empty_panel",
                    "$checked_locked_hover_control": "common.empty_panel",
                    "$toggle_name": "hud_toggles_touch_menu_toggle",
                    "$toggle_group_forced_index": 0,
                    "$radio_toggle_group": true,
                    "$toggle_focus_enabled": false,
                    "sound_volume": 0,
                    "$ignore_tts_enabled_bind": true,
                    "layer": 1
                }
            }
        ]
    },

    // Hud toggles touch onscreen menu content
    "hud_toggles_touch_onscreen_menu_content": {
        "type": "stack_panel",
        "orientation": "vertical",
        "size": ["100%cm", "100%c"],
        "controls": [
            {
                "row_0@zk_hud_toggleables.hud_toggles_touch_onscreen_menu_toggles_content": {}
            }
        ]
    },

    // Hud toggles touch onscreen menu toggles content
    "hud_toggles_touch_onscreen_menu_toggles_content": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "size": ["100%c", "100%cm"],
        "$enable_hover_event_mapping": true,
        "$toggle_hover_event_mapping": "button.hud_toggles_item_on_hover",
        "$button_content": "zk_hud_toggleables.hud_toggles_touch_menu_toggle_content",
        "controls": [
            {
                "menu__toggle_sb_list@common_toggles.light_content_toggle_one_button_state": {
                    "size": [24, 24],
                    "$toggle_name": "hud_toggles_touch_mode__scoreboard_list",
                    "$toggle_view_binding_name": "hud_toggles_touch_mode__scoreboard_list",
                    "$button_icon_texture": "textures/zk_ui/hud/hud_toggles_sb_list",
                    "$button_text": "hudScreen.toggleables.scoreboardList"
                }
            },
            {
                "padding_0@common.empty_panel": {
                    "size": [4, 0],
                    "bindings": [
                        {
                            "binding_name": "#scoreboard_sidebar_visible",
                            "binding_name_override": "#visible"
                        }
                    ]
                }
            },
            {
                "menu__toggle_scoreboard_sidebar@common_toggles.light_content_toggle_one_button_state": {
                    "size": [24, 24],
                    "$toggle_name": "toggle_scoreboard_sidebar",
                    "$toggle_view_binding_name": "toggle_scoreboard_sidebar",
                    "$toggle_default_state": true,
                    "$button_icon_texture": "textures/zk_ui/hud/hud_toggles_sb_sidebar",
                    "$button_text": "hudScreen.toggleables.scoreboardSidebar",
                    "bindings": [
                        {
                            "binding_name": "#scoreboard_sidebar_visible",
                            "binding_name_override": "#visible"
                        }
                    ]
                }
            },
            {
                "padding_2@common.empty_panel": {
                    "size": [4, 0]
                }
            },
            {
                "hide_hud_button@common_buttons.light_content_button": {
                    "$pressed_button_name": "button.hide_gui_all",
                    "$button_icon_texture": "textures/zk_ui/hud/hud_toggles_hide_hud",
                    "$button_text": "options.hidehud",
                    "size": [24, 24],
                    "$ignore_cross_image": true,
                    "$is_button": true,
                    "button_mappings": [
                        {
                            "from_button_id": "button.menu_select",
                            "to_button_id": "$pressed_button_name",
                            "mapping_type": "pressed"
                        },
                        {
                            "from_button_id": "button.menu_ok",
                            "to_button_id": "$pressed_button_name",
                            "mapping_type": "focused"
                        },
                        {
                            "to_button_id": "$toggle_hover_event_mapping",
                            "mapping_type": "pressed"
                        }
                    ]
                }
            }
        ]
    },

    // Hud toggles touch menu toggle content
    "hud_toggles_touch_menu_toggle_content": {
        "type": "panel",
        "$button_icon_texture|default": "",
        "$tooltip_text|default": "",
        "$ignore_cross_image|default": false,
        "$is_button|default": false,
        "controls": [
            {
                "button_icon": {
                    "type": "image",
                    "texture": "$button_icon_texture",
                    "size": [16, 16],
                    "color": "$text_color"
                }
            },
            {
                "cross_overlay": {
                    "ignored": "($pressed_state or $ignore_cross_image)",
                    "type": "image",
                    "texture": "textures/ui/crossout",
                    "size": [15, 15],
                    "layer": 1
                }
            },
            {
                "hover_content": {
                    "ignored": "(not $hover_state)",
                    "type": "panel",
                    "size": ["100%", "100%"],
                    "allow_clipping": false,
                    "controls": [
                        {
                            "hover_tooltip": {
                                "type": "image",
                                "texture": "textures/ui/greyBorder",
                                "layer": 40,
                                "size": ["100%cm + 12px", "100%cm + 5px"],
                                "offset": [0, 18],
                                "anchor_from": "bottom_middle",
                                "anchor_to": "top_middle",
                                "animation_reset_name": "button.hud_toggles_item_on_hover",
                                "disable_anim_fast_forward": true,
                                "propagate_alpha": true,
                                "anims": [
                                    "@zk_anims.anim_hud_toggles_touch_menu_tooltip_hover_offset",
                                    "@zk_anims.anim_hud_toggles_touch_menu_tooltip_hover_alpha"
                                ],
                                "controls": [
                                    {
                                        "tooltip_label": {
                                            "ignored": "$is_button",
                                            "type": "label",
                                            "text": "#text",
                                            "color": "$body_text_color",
                                            "layer": 4,
                                            "bindings": [
                                                {
                                                    "binding_type": "view",
                                                    "source_control_name": "$toggle_view_binding_name",
                                                    "source_property_name": "#toggle_state",
                                                    "target_property_name": "#toggle_state"
                                                },
                                                {
                                                    "binding_type": "view",
                                                    "source_property_name": "($button_text + (#toggle_state + ':.hide') + ((not #toggle_state) + ':.show') - 'false:.hide' - 'false:.show' - 'true:')",
                                                    "target_property_name": "#text"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "tooltip_label_button": {
                                            "ignored": "(not $is_button)",
                                            "type": "label",
                                            "text": "$button_text",
                                            "color": "$body_text_color",
                                            "layer": 4
                                        }
                                    },
                                    {
                                        "chevron": {
                                            "type": "image",
                                            "texture": "textures/ui/tooltip_inverted_chevron",
                                            "layer": 1,
                                            "size": [19, 13],
                                            "offset": [0, 4],
                                            "anchor_from": "top_middle",
                                            "anchor_to": "bottom_middle"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Hud toggles main menu panel
    "hud_toggles_main_menu_panel": {
        "type": "panel",
        "size": ["100%", "100%"],
        "layer": 80,
        "propagate_alpha": true,
        "animation_reset_name": "button.peek_hud_toggles_menu",
        "anims": ["@zk_hud_toggleables.anim_peek_hud_toggles_menu_alpha"],
        "controls": [
            {
                "menu_panel@zk_hud_common.dynamic_helpers_template": {
                    "$dynamic_helpers_content": "zk_hud_toggleables.hud_toggles_main_menu",
                    "$show_helper_background": true,
                    "animation_reset_name": "button.peek_hud_toggles_menu",
                    "anims": ["@zk_hud_toggleables.anim_peek_hud_toggles_menu_list_offset"]
                }
            },
            {
                "hud_list_scoreboard@zk_hud_toggleables.hud_list_scoreboard": {}
            }
        ]
    },

    // Hud toggles main menu
    "hud_toggles_main_menu": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "size": ["100%c", "100%cm"],
        "anchor_from": "bottom_left",
        "anchor_to": "bottom_left",
        "$grid_item|default": "zk_hud_toggleables.hud_toggle_main_menu_item",
        "bindings": [
            {
                "binding_name": "(not #emote_tips_visible)",
                "binding_name_override": "#visible",
                "binding_type": "global"
            }
        ],
        "controls": [
            {
                "toggle_scoreboard_sidebar_tooltip@zk_hud_toggleables.toggle_with_tooltip": {
                    "$toggle_name": "toggle_scoreboard_sidebar",
                    "$toggle_view_binding_name": "toggle_scoreboard_sidebar",
                    "$from_button_id": "button.slot1",
                    "$toggle_default_state": true,
                    "$keyboard_key_label": "keyboard.keyName.1",
                    "$tooltip_description": "hudScreen.toggleables.scoreboardSidebar",
                    "bindings": [
                        {
                            "binding_name": "#scoreboard_sidebar_visible",
                            "binding_name_override": "#visible"
                        }
                    ]
                }
            }
        ]
    },

    // Mixed toggleable keyboard description
    "mixed_toggleable_keyboard_description@common.keyboard_helper_description": {
        "text": "#text",
        "$reverse_output_string|default": false,
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "$toggle_view_binding_name",
                "source_property_name": "#toggle_state",
                "target_property_name": "#toggle_state"
            },
            {
                "ignored": "$reverse_output_string",
                "binding_type": "view",
                "source_property_name": "($description_bind + (#toggle_state + ':.hide') + ((not #toggle_state) + ':.show') - 'false:.hide' - 'false:.show' - 'true:')",
                "target_property_name": "#text"
            },
            {
                "ignored": "(not $reverse_output_string)",
                "binding_type": "view",
                "source_property_name": "($description_bind + (#toggle_state + ':.show') + ((not #toggle_state) + ':.hide') - 'false:.hide' - 'false:.show' - 'true:')",
                "target_property_name": "#text"
            }
        ]
    },

    // Mixed tooltip helper
    "mixed_tooltip_helper": {
        "type": "panel",
        "size": ["100%cm", "100%cm"],
        "anchor_from": "bottom_middle",
        "anchor_to": "bottom_middle",
        "controls": [
            {
                "keyboard_tooltip@common.keyboard_helper_keys": {
                    "anchor_from": "bottom_middle",
                    "anchor_to": "bottom_middle",
                    "offset": [-2, 1],
                    "$icon_size_panel": [17, "100%"],
                    "$keyboard_helper_size": ["100%c", 24],
                    "$text_color": "$generic_button_text_color",
                    "$keyboard_description": "zk_hud_toggleables.mixed_toggleable_keyboard_description",
                    "$description_bind": "$tooltip_description",
                    "$keyboard_character": "$keyboard_key_label"
                }
            }
        ]
    },

    // Hud toggle main menu item
    "hud_toggle_main_menu_item": {
        "type": "image",
        "texture": "textures/ui/hud_tip_text_background",
        "alpha": 0.8,
        "size": [20, 20]
    },

    // Toggle with tooltip
    "toggle_with_tooltip@common_toggles.transparent_horizontal_form_fitting_content_toggle": {
        "size": ["100%c + 8px", 26],
        "$button_content": "zk_hud_toggleables.mixed_tooltip_helper",
        "$from_button_id|default": "button.slot0",
        "$default_border_visible": false,
        "$hover_border_visible": false,
        "$button_mappings": [
            {
                "from_button_id": "$from_button_id",
                "to_button_id": "button.menu_select",
                "mapping_type": "global"
            }
        ]
    },

    // Scoreboard background
    "scoreboard_background": {
        "type": "image",
        "texture": "textures/ui/Black",
        "size": ["100%", 14],
        "alpha": 0.6
    },

    // Hud list scoreboard
    "hud_list_scoreboard": {
        "type": "stack_panel",
        "orientation": "vertical",
        "size": ["55%", "100%"],
        "layer": 95,
        "animation_reset_name": "button.peek_hud_toggles_menu",
        "anims": ["@zk_hud_toggleables.anim_peek_hud_players_list_offset"],
        "controls": [
            {
                "top_padding@common.empty_panel": {
                    "$padding_size|default": ["100%", 8],
                    "size": "$padding_size",
                    "variables": [
                        {
                            "requires": "$touch",
                            "$padding_size": ["100%", 24]
                        }
                    ]
                }
            },
            {
                "list_objective_label_panel@zk_hud_toggleables.scoreboard_background": {
                    "controls": [
                        {
                            "list_objective_label": {
                                "type": "label",
                                "text": "#text",
                                "shadow": true,
                                "size": ["100% - 100px", 10],
                                "text_alignment": "center",
                                "layer": 2,
                                "bindings": [
                                    {
                                        "binding_name": "#player_list_title",
                                        "binding_name_override": "#text"
                                    }
                                ]
                            }
                        },
                        {
                            "player_count_label_panel": {
                                "type": "panel",
                                "size": [52, 12],
                                "anchor_from": "left_middle",
                                "anchor_to": "left_middle",
                                "offset": [2, 0],
                                "controls": [
                                    {
                                        "online_icon": {
                                            "type": "image",
                                            "texture": "textures/zk_ui/hud/player_online_icon",
                                            "size": [12, 12],
                                            "anchor_from": "left_middle",
                                            "anchor_to": "left_middle",
                                            "offset": [0, -1]
                                        }
                                    },
                                    {
                                        "grid_clip": {
                                            "type": "panel",
                                            "size": [40, 10],
                                            "clips_children": true,

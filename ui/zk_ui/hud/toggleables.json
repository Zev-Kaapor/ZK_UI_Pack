                    "size": ["default", "default"],
                    "color": "$experience_text_color",
                    "shadow": true,
                    "layer": 1,
                    "bindings": [
                        {
                            "binding_name": "#exp_progress",
                            "binding_type": "global",
                            "binding_condition": "visible"
                        },
                        {
                            "binding_name": "#level_number",
                            "binding_type": "global"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#level_number * 1)",
                            "target_property_name": "#lvl"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "((#lvl > 15) * 1 + (#lvl > 30) * 1)",
                            "target_property_name": "#lvl_tier"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "((#lvl > 16) * 1 + (#lvl > 31) * 1)",
                            "target_property_name": "#t_lvl_tier"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "((2 + (#lvl_tier > 0) * 3 + (#lvl_tier > 1) * 4) * #lvl + ((#lvl_tier = 0) * 7 - (#lvl_tier = 1) * 38 - (#lvl_tier = 2) * 158))",
                            "target_property_name": "#total_lvlxp_vanilla"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#total_lvlxp_vanilla)",
                            "target_property_name": "#total_lvlxp"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#total_lvlxp * (1 - #exp_progress) * 100)",
                            "target_property_name": "#cxp"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "((#cxp > 99999999) * 100000000 + (#cxp > 199999999) * 100000000 + (#cxp > 299999999) * 100000000 + (#cxp > 399999999) * 100000000 + (#cxp > 499999999) * 100000000 + (#cxp > 599999999) * 100000000 + (#cxp > 699999999) * 100000000 + (#cxp > 799999999) * 100000000 + (#cxp > 899999999) * 100000000 + (#cxp > 999999999) * 10000000)",
                            "target_property_name": "#x8"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#x8 + (#cxp - #x8 > 9999999) * 10000000 + (#cxp - #x8 > 19999999) * 10000000 + (#cxp - #x8 > 29999999) * 10000000 + (#cxp - #x8 > 39999999) * 10000000 + (#cxp - #x8 > 49999999) * 10000000 + (#cxp - #x8 > 59999999) * 10000000 + (#cxp - #x8 > 69999999) * 10000000 + (#cxp - #x8 > 79999999) * 10000000 + (#cxp - #x8 > 89999999) * 10000000)",
                            "target_property_name": "#x7"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#x7 + (#cxp - #x7 > 999999) * 1000000 + (#cxp - #x7 > 1999999) * 1000000 + (#cxp - #x7 > 2999999) * 1000000 + (#cxp - #x7 > 3999999) * 1000000 + (#cxp - #x7 > 4999999) * 1000000 + (#cxp - #x7 > 5999999) * 1000000 + (#cxp - #x7 > 6999999) * 1000000 + (#cxp - #x7 > 7999999) * 1000000 + (#cxp - #x7 > 8999999) * 1000000)",
                            "target_property_name": "#x6"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#x6 + (#cxp - #x6 > 99999) * 100000 + (#cxp - #x6 > 199999) * 100000 + (#cxp - #x6 > 299999) * 100000 + (#cxp - #x6 > 399999) * 100000 + (#cxp - #x6 > 499999) * 100000 + (#cxp - #x6 > 599999) * 100000 + (#cxp - #x6 > 699999) * 100000 + (#cxp - #x6 > 799999) * 100000 + (#cxp - #x6 > 899999) * 100000)",
                            "target_property_name": "#x5"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#x5 + (#cxp - #x5 > 9999) * 10000 + (#cxp - #x5 > 19999) * 10000 + (#cxp - #x5 > 29999) * 10000 + (#cxp - #x5 > 39999) * 10000 + (#cxp - #x5 > 49999) * 10000 + (#cxp - #x5 > 59999) * 10000 + (#cxp - #x5 > 69999) * 10000 + (#cxp - #x5 > 79999) * 10000 + (#cxp - #x5 > 89999) * 10000)",
                            "target_property_name": "#x4"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#x4 + (#cxp - #x4 > 999) * 1000 + (#cxp - #x4 > 1999) * 1000 + (#cxp - #x4 > 2999) * 1000 + (#cxp - #x4 > 3999) * 1000 + (#cxp - #x4 > 4999) * 1000 + (#cxp - #x4 > 5999) * 1000 + (#cxp - #x4 > 6999) * 1000 + (#cxp - #x4 > 7999) * 1000 + (#cxp - #x4 > 8999) * 1000)",
                            "target_property_name": "#x3"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#x3 + (#cxp - #x3 > 99) * 100 + (#cxp - #x3 > 199) * 100 + (#cxp - #x3 > 299) * 100 + (#cxp - #x3 > 399) * 100 + (#cxp - #x3 > 499) * 100 + (#cxp - #x3 > 599) * 100 + (#cxp - #x3 > 699) * 100 + (#cxp - #x3 > 799) * 100 + (#cxp - #x3 > 899) * 100)",
                            "target_property_name": "#x2"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#x2 + (#cxp - #x2 > 9) * 10 + (#cxp - #x2 > 19) * 10 + (#cxp - #x2 > 29) * 10 + (#cxp - #x2 > 39) * 10 + (#cxp - #x2 > 49) * 10 + (#cxp - #x2 > 59) * 10 + (#cxp - #x2 > 69) * 10 + (#cxp - #x2 > 79) * 10 + (#cxp - #x2 > 89) * 10)",
                            "target_property_name": "#x1"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#x1 + (#cxp - #x1 > 0) + (#cxp - #x1 > 1) + (#cxp - #x1 > 2) + (#cxp - #x1 > 3) + (#cxp - #x1 > 4) + (#cxp - #x1 > 5) + (#cxp - #x1 > 6) + (#cxp - #x1 > 7) + (#cxp - #x1 > 8))",
                            "target_property_name": "#u_cxp"
                        },
                        {
                            "binding_type": "view",
                            "source_control_name": "vanilla_xp_calc_map",
                            "source_property_name": "#total_xp_score",
                            "target_property_name": "#total_xp_score_vanilla_pre"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#total_xp_score_vanilla_pre + #u_cxp / 100)",
                            "target_property_name": "#total_xp_score_vanilla"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#total_xp_score_vanilla)",
                            "target_property_name": "#total_xp_score"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#u_cxp / 10 + (#u_cxp - ((#u_cxp / 10) * 10) > 4) * 1)",
                            "target_property_name": "#pre_cxp"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#pre_cxp / 10)",
                            "target_property_name": "#pre_e0"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#pre_cxp - #pre_e0 * 10)",
                            "target_property_name": "#pre_em1"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(('§z' + #pre_e0 + 'Z.' + #pre_em1) - 'Z.0' - 'Z')",
                            "target_property_name": "#current_lvlxp_float_one"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#total_xp_score - (#total_xp_score * 0 - 2147483647 - 2 + (#total_xp_score = -1) * 1))",
                            "target_property_name": "#total_xp_score_negative_int"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "((#total_xp_score_negative_int - #total_xp_score_negative_int / 100000 * 100000) + 83647 + (#total_xp_score = -1) * 1)",
                            "target_property_name": "#total_xp_score_middle"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(('§z' + ((#total_xp_score_negative_int / 100000) + 21475) + (#total_xp_score_middle - #total_xp_score_middle / 100000 * 100000)))",
                            "target_property_name": "#total_xp_score_unsigned_pre"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(('§z' + (#total_xp_score_unsigned_pre) + '__' + (#total_xp_score < 0) + '__' + (#total_xp_score)) - ((#total_xp_score_unsigned_pre) + '__false__') - ('__true__' + (#total_xp_score)))",
                            "target_property_name": "#total_xp_score_unsigned"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "('%hudScreen.levelHeaderAbbreviated ' + #level_number + ': §f' + #current_lvlxp_float_one + '/' + #total_lvlxp + '§r §o§7' + '[' + #total_xp_score_unsigned + ']§r')",
                            "target_property_name": "#text"
                        }
                    ]
                }
            }
        ]
    },

    // Inventory free slots counter panel
    "inventory_free_slots_counter_panel": {
        "ignored": "(not $use_zk_hud_modules:inventory_free_slots_counter)",
        "type": "image",
        "texture": "textures/ui/hud_tip_text_background",
        "size": ["100%cm + 12px", "100%cm + 6px"],
        "alpha": 0.6,
        "bindings": [
            {
                "binding_name": "#hotbar_with_xp_bar"
            },
            {
                "binding_name": "#hotbar_no_xp_bar"
            },
            {
                "binding_name": "#hotbar_visible"
            },
            {
                "binding_type": "view",
                "source_property_name": "((#hotbar_with_xp_bar or #hotbar_no_xp_bar) and #hotbar_visible)",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "stack_panel": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%c", "100%cm"],
                    "use_child_anchors": true,
                    "layer": 1,
                    "controls": [
                        {
                            "inventory_icon_panel": {
                                "type": "panel",
                                "size": [15, 13],
                                "controls": [
                                    {
                                        "inventory_icon": {
                                            "type": "image",
                                            "texture": "textures/ui/inventory_icon",
                                            "size": [19, 13],
                                            "offset": [-2, -1],
                                            "keep_ratio": true
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "inventory_free_slots_counter_label_green@zk_hud_toggleables.inventory_free_slots_counter_label": {
                                "$min": 0,
                                "$max": 24,
                                "color": "$a_color_format"
                            }
                        },
                        {
                            "inventory_free_slots_counter_label_yellow@zk_hud_toggleables.inventory_free_slots_counter_label": {
                                "$min": 24,
                                "$max": 32,
                                "color": "$e_color_format"
                            }
                        },
                        {
                            "inventory_free_slots_counter_label_red@zk_hud_toggleables.inventory_free_slots_counter_label": {
                                "$min": 32,
                                "$max": 36,
                                "color": "$c_color_format"
                            }
                        },
                        {
                            "inventory_full_label": {
                                "type": "label",
                                "text": "hudScreen.inventoryFull.warning",
                                "layer": 2,
                                "color": "$c_color_format",
                                "bindings": [
                                    {
                                        "binding_type": "view",
                                        "source_control_name": "mainhand_item_count_total_calc",
                                        "source_property_name": "(#total_free_slots_count = 36)",
                                        "target_property_name": "#visible"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Inventory free slots counter label
    "inventory_free_slots_counter_label": {
        "type": "label",
        "text": "#text",
        "shadow": true,
        "layer": 2,
        "$min|default": 0,
        "$max|default": 36,
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "mainhand_item_count_total_calc",
                "source_property_name": "('§z' + #total_free_slots_count + '/36')",
                "target_property_name": "#text"
            },
            {
                "binding_type": "view",
                "source_control_name": "mainhand_item_count_total_calc",
                "source_property_name": "(((#total_free_slots_count > $min) and (#total_free_slots_count < $max)) or (#total_free_slots_count = $min))",
                "target_property_name": "#visible"
            }
        ]
    },

    // Advanced info panel
    "advanced_info_panel": {
        "type": "stack_panel",
        "orientation": "vertical",
        "size": ["100%cm", "100%c"],
        "anchor_from": "bottom_left",
        "anchor_to": "bottom_left",
        "offset": [2, -2],
        "layer": 6,
        "controls": [
            {
                "accurate_exp_progress@zk_hud_toggleables.accurate_exp_progress": {}
            },
            {
                "accurate_exp_progress_padding@common.empty_panel": {
                    "size": [0, 2]
                }
            },
            {
                "inventory_free_slots_counter_and_tools": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%c", "100%cm"],
                    "controls": [
                        {
                            "inventory_free_slots_counter_panel@zk_hud_toggleables.inventory_free_slots_counter_panel": {}
                        },
                        {
                            "padding_middle@common.empty_panel": {
                                "size": [2, 0]
                            }
                        },
                        {
                            "clock_compass_panel@zk_hud_toggleables.clock_compass_panel": {}
                        }
                    ]
                }
            }
        ]
    },

    // Accurate exp progress
    "accurate_exp_progress": {
        "ignored": "(not $use_zk_hud_modules:accurate_exp_progress)",
        "type": "panel",
        "size": ["100%c", "100%c + 2px"],
        "bindings": [
            {
                "binding_name": "#level_number",
                "binding_type": "global"
            },
            {
                "binding_name": "#exp_progress",
                "binding_type": "global"
            },
            {
                "binding_type": "view",
                "source_property_name": "(not ((#level_number < '1') and ((1 - #exp_progress) = 0)))",
                "target_property_name": "#condition"
            },
            {
                "binding_type": "view",
                "source_control_name": "accurate_exp_progress_panel",
                "source_property_name": "#visible",
                "target_property_name": "#state"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#condition and #state)",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "accurate_exp_progress_panel@zk_hud_toggleables.accurate_exp_progress_panel": {
                    "offset": [0, 1]
                }
            }
        ]
    },

    // Clock and compass item renderer
    "clock_compass_item": {
        "type": "custom",
        "renderer": "inventory_item_renderer",
        "size": [16, 16],
        "$clock_compass_item_id|default": 0,
        "property_bag": {
            "#item_id": "$clock_compass_item_id"
        },
        "bindings": [
            {
                "binding_type": "view",
                "source_property_name": "(#item_id * 65536)",
                "target_property_name": "#item_id_aux"
            }
        ]
    },

    // Clock and compass panel
    "clock_compass_panel": {
        "type": "image",
        "texture": "textures/ui/hud_tip_text_background",
        "size": ["100%c + 8px", "100%c + 4px"],
        "alpha": 0.6,
        "bindings": [
            {
                "binding_name": "#hotbar_with_xp_bar"
            },
            {
                "binding_name": "#hotbar_no_xp_bar"
            },
            {
                "binding_name": "#hotbar_visible"
            },
            {
                "binding_type": "view",
                "source_property_name": "((#hotbar_with_xp_bar or #hotbar_no_xp_bar) and #hotbar_visible)",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "stack_panel": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%c", 16],
                    "layer": 1,
                    "controls": [
                        {
                            "compass@zk_hud_toggleables.clock_compass_item": {
                                "$clock_compass_item_id": 394
                            }
                        },
                        {
                            "clock@zk_hud_toggleables.clock_compass_item": {
                                "$clock_compass_item_id": 396
                            }
                        }
                    ]
                }
            }
        ]
    }
}

        "$slot_control|default": "zk_hud_common.inventory_data_label_calc",
        "controls": [
            {
                "header": {
                    "type": "label",
                    "text": "inventory_data: ",
                    "shadow": true
                }
            },
            {
                "inv_slot_0@$slot_control": {

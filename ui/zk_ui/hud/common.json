// ZK HUD common
{
    "namespace": "zk_hud_common",

    // Mainhand renderer grid item
    "mainhand_renderer_grid_item": {
        "type": "image",
        "texture": "textures/ui/hud_tip_text_background",
        "size": ["100%cm + 4px", "100%cm + 3px"],
        "alpha": 0.6,
        "layer": 1,
        "$stack_count_required": true,
        "$durability_bar_required": true,
        "$storage_bar_required": true,
        "bindings": [
            {
                "binding_name": "#slot_selected",
                "binding_type": "collection",
                "binding_collection_name": "$hotbar_collection_name"
            },
            {
                "binding_name": "#item_id_aux",
                "binding_type": "collection",
                "binding_collection_name": "$hotbar_collection_name"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#slot_selected and not (#item_id_aux = -1))",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "content": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "use_child_anchors": true,
                    "size": ["100%c", "100%cm"],
                    "offset": [-1, 0],
                    "controls": [
                        {
                            "durability_texts_panel": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "size": ["100%c", "100%cm"],
                                "bindings": [
                                    {
                                        "binding_name": "(not (#item_durability_total_amount = 0))",
                                        "binding_name_override": "#visible",
                                        "binding_type": "collection",
                                        "binding_collection_name": "$hotbar_collection_name"
                                    }
                                ],
                                "controls": [
                                    {
                                        "padding_left": {
                                            "type": "panel",
                                            "size": [8, 0]
                                        }
                                    },
                                    {
                                        "item_durability_calc@zk_item_durability_tool.calc": {
                                            "$current_durability_binding_name": "#item_durability_current_amount",
                                            "$current_durability_binding_type": "collection",
                                            "$current_durability_collection_name": "$hotbar_collection_name",
                                            "$total_durability_binding_name": "#item_durability_total_amount",
                                            "$total_durability_binding_type": "collection",
                                            "$total_durability_collection_name": "$hotbar_collection_name",
                                            "$cur_output_source_property": "#current_durability",
                                            "$tot_output_source_property": "#total_durability"
                                        }
                                    },
                                    {
                                        "item_durability_label": {
                                            "type": "label",
                                            "text": "#text",
                                            "color": "$item_stack_count_color",
                                            "shadow": true,
                                            "layer": 2,
                                            "bindings": [
                                                {
                                                    "binding_type": "view",
                                                    "source_control_name": "item_durability_calc",
                                                    "source_property_name": "('§z' + #current_durability + '/' + #total_durability)",
                                                    "target_property_name": "#text",
                                                    "resolve_sibling_scope": true
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "padding_right": {
                                            "type": "panel",
                                            "size": [4, 0]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "storage_weight_panel": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "size": ["100%c", "100%cm"],
                                "bindings": [
                                    {
                                        "binding_name": "(not (#item_storage_total_amount = 0))",
                                        "binding_name_override": "#visible",
                                        "binding_type": "collection",
                                        "binding_collection_name": "$hotbar_collection_name"
                                    }
                                ],
                                "controls": [
                                    {
                                        "padding_left": {
                                            "type": "panel",
                                            "size": [8, 0]
                                        }
                                    },
                                    {
                                        "item_storage_calc@zk_bundle_item_count.bundle_item_count_calc": {
                                            "$current_storage_binding_name": "#item_storage_current_amount",
                                            "$current_storage_binding_type": "collection",
                                            "$current_storage_collection_name": "$hotbar_collection_name",
                                            "$total_storage_binding_name": "#item_storage_total_amount",
                                            "$total_storage_binding_type": "collection",
                                            "$total_storage_collection_name": "$hotbar_collection_name",
                                            "$cur_output_source_property": "#current_storage",
                                            "$tot_output_source_property": "#total_storage"
                                        }
                                    },
                                    {
                                        "item_storage_label": {
                                            "type": "label",
                                            "text": "#text",
                                            "color": "$item_stack_count_color",
                                            "shadow": true,
                                            "layer": 2,
                                            "bindings": [
                                                {
                                                    "binding_type": "view",
                                                    "source_control_name": "item_storage_calc",
                                                    "source_property_name": "('§z' + #current_storage + '/' + #total_storage)",
                                                    "target_property_name": "#text",
                                                    "resolve_sibling_scope": true
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "padding_right": {
                                            "type": "panel",
                                            "size": [4, 0]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "total_item_count_text_panel": {
                                "ignored": "(not $enable_hud_modules)",
                                "type": "panel",
                                "size": ["100%cm", "100%cm"],
                                "layer": 2,
                                "bindings": [
                                    {
                                        "binding_name": "#item_durability_total_amount",
                                        "binding_type": "collection",
                                        "binding_collection_name": "$hotbar_collection_name"
                                    },
                                    {
                                        "binding_name": "#item_storage_total_amount",
                                        "binding_type": "collection",
                                        "binding_collection_name": "$hotbar_collection_name"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(#item_durability_total_amount = 0 and #item_storage_total_amount = 0)",
                                        "target_property_name": "#visible"
                                    }
                                ],
                                "controls": [
                                    {
                                        "total_item_count_text@zk_hud_common.total_item_count_text": {}
                                    },
                                    {
                                        "empty_padding": {
                                            "type": "panel",
                                            "size": [2, 0]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "hotbar_parent": {
                                "type": "panel",
                                "size": [16, 16],
                                "controls": [
                                    {
                                        "item_icon@hud.hotbar_hud_item_icon": {
                                            "layer": 3,
                                            "size": [16, 16]
                                        }
                                    },
                                    {
                                        "item_count@common.stack_count_label": {
                                            "layer": 4,
                                            "$item_collection_name": "$hotbar_collection_name",
                                            "$stack_count_collection_name": "$hotbar_collection_name",
                                            "bindings": [
                                                {
                                                    "binding_name": "#inventory_stack_count",
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "$stack_count_collection_name"
                                                },
                                                {
                                                    "ignored": "$stack_count_required",
                                                    "binding_name": "#stack_count_visible",
                                                    "binding_name_override": "#visible",
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "$stack_count_collection_name"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "item_dura@hud.item_durability": {
                                            "layer": 5
                                        }
                                    },
                                    {
                                        "item_store@hud.item_storage": {
                                            "layer": 5
                                        }
                                    },
                                    {
                                        "container_item_lock_overlay@hud.container_item_lock_overlay": {
                                            "layer": 6,
                                            "size": [16, 16]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Mainhand renderer grid
    "mainhand_renderer_grid@zk_subpack_settings.item_count_indexes_varied_settings": {
        "ignored": "($is_chainsketch_UTM or $is_modules_plus or $is_utility_ui)",
        "type": "stack_panel",
        "orientation": "horizontal",
        "size": ["100%cm", "100%cm"],
        "layer": 10,
        "$slot_control|default": "zk_hud_common.mainhand_renderer_grid_item",
        "$disable_total_item_count_indexes|default": false,
        "$hotbar_collection_name|default": "hotbar_items",
        "collection_name": "$hotbar_collection_name",
        "controls": [
            {
                "slot_0@$slot_control": {
                    "collection_index": 0
                }
            },
            {
                "slot_1@$slot_control": {
                    "collection_index": 1
                }
            },
            {
                "slot_2@$slot_control": {
                    "collection_index": 2
                }
            },
            {
                "slot_3@$slot_control": {
                    "collection_index": 3
                }
            },
            {
                "slot_4@$slot_control": {
                    "collection_index": 4
                }
            },
            {
                "slot_5@$slot_control": {
                    "collection_index": 5
                }
            },
            {
                "slot_6@$slot_control": {
                    "collection_index": 6
                }
            },
            {
                "slot_7@$slot_control": {
                    "collection_index": 7
                }
            },
            {
                "slot_8@$slot_control": {
                    "collection_index": 8
                }
            }
        ]
    },

    // Mainhand renderer
    "mainhand_renderer": {
        "ignored": "(not $use_zk_hud_modules:mainhand_renderer)",
        "type": "panel",
        "size": ["100%c", "100%c"],
        "bindings": [
            {
                "binding_name": "#hotbar_with_xp_bar"
            },
            {
                "binding_name": "#hotbar_no_xp_bar"
            },
            {
                "binding_name": "#hotbar_visible"
            },
            {
                "binding_type": "view",
                "source_property_name": "((#hotbar_with_xp_bar or #hotbar_no_xp_bar) and #hotbar_visible)",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "mainhand_renderer@zk_hud_common.mainhand_renderer_grid": {}
            }
        ]
    },

    // Mainhand item status grid item
    "mainhand_item_status_grid_item": {
        "type": "image",
        "texture": "textures/ui/hud_tip_text_background",
        "size": ["100%cm + 8px", "100%cm + 3px"],
        "alpha": 0.6,
        "layer": 1,
        "bindings": [
            {
                "binding_name": "#slot_selected",
                "binding_type": "collection",
                "binding_collection_name": "$hotbar_collection_name"
            },
            {
                "binding_name": "#item_durability_current_amount",
                "binding_type": "collection",
                "binding_collection_name": "$hotbar_collection_name"
            },
            {
                "binding_name": "#item_durability_total_amount",
                "binding_type": "collection",
                "binding_collection_name": "$hotbar_collection_name"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#slot_selected and #item_durability_current_amount < 31 and not #item_durability_total_amount = 0)",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "content_stack": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "use_child_anchors": true,
                    "size": ["100%c", "100%cm"],
                    "layer": 1,
                    "controls": [
                        {
                            "item_icon@hud.hotbar_hud_item_icon": {
                                "layer": 3,
                                "size": [24, 24]
                            }
                        },
                        {
                            "padding_middle@common.empty_panel": {
                                "size": [4, 0]
                            }
                        },
                        {
                            "low_durability_warning_text": {
                                "type": "label",
                                "text": "hudScreen.lowDurability",
                                "shadow": true,
                                "color": "$c_color_format"
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Mainhand item status grid
    "mainhand_item_status_grid@zk_subpack_settings.item_count_indexes_varied_settings": {
        "ignored": "($is_chainsketch_UTM or $is_modules_plus or $is_utility_ui)",
        "type": "stack_panel",
        "orientation": "horizontal",
        "size": ["100%cm", "100%cm"],
        "anchor_from": "bottom_right",
        "anchor_to": "bottom_right",
        "offset": [-2, -18],
        "layer": 10,
        "$slot_control|default": "zk_hud_common.mainhand_item_status_grid_item",
        "$hotbar_collection_name|default": "hotbar_items",
        "collection_name": "$hotbar_collection_name",
        "controls": [
            {
                "slot_0@$slot_control": {
                    "collection_index": 0
                }
            },
            {
                "slot_1@$slot_control": {
                    "collection_index": 1
                }
            },
            {
                "slot_2@$slot_control": {
                    "collection_index": 2
                }
            },
            {
                "slot_3@$slot_control": {
                    "collection_index": 3
                }
            },
            {
                "slot_4@$slot_control": {
                    "collection_index": 4
                }
            },
            {
                "slot_5@$slot_control": {
                    "collection_index": 5
                }
            },
            {
                "slot_6@$slot_control": {
                    "collection_index": 6
                }
            },
            {
                "slot_7@$slot_control": {
                    "collection_index": 7
                }
            },
            {
                "slot_8@$slot_control": {
                    "collection_index": 8
                }
            }
        ]
    },

    // Hud inventory data calc panels
    "hud_inventory_data_calc_panels@zk_subpack_settings.item_count_indexes_varied_settings": {
        "type": "stack_panel",
        "orientation": "vertical",
        "size": ["100%cm", "100%c"],
        "anchor_from": "bottom_left",
        "anchor_to": "bottom_left",
        "offset": [0, "200%"],
        "propagate_alpha": true,
        "alpha": 0,
        "controls": [
            {
                "inventory_data_panel_calc@zk_hud_common.inventory_data_panel_calc": {}
            },
            {
                "mainhand_item_count_total_calc@zk_hud_common.mainhand_item_count_total_calc": {
                    "ignored": "((not $use_zk_hud_modules:inventory_free_slots_counter) and (not $use_zk_hud_modules:mainhand_renderer))"
                }
            }
        ],
        "bindings": [
            {
                "binding_type": "global",
                "binding_name": "#hud_visible",
                "binding_name_override": "#visible"
            }
        ]
    },

    // Inventory data panel calc

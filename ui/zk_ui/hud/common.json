    // Inventory data label calc
    "inventory_data_label_calc": {
        "type": "label",
        "text": "#text",
        "shadow": true,
        "collection_index": "$index",
        "$separator|default": " / ",
        "$disable_total_item_count_indexes|default": false,
        "bindings": [
            {
                "binding_name": "#inventory_stack_count",
                "binding_type": "collection",
                "binding_collection_name": "$item_collection_name",
                "binding_condition": "visible"
            },
            {
                "binding_name": "#item_id_aux",
                "binding_type": "collection",
                "binding_collection_name": "$item_collection_name",
                "binding_condition": "visible"
            },
            {
                "ignored": "($index > 8 or true)",
                "binding_name": "#slot_selected",
                "binding_type": "collection",
                "binding_collection_name": "$item_collection_name",
                "binding_condition": "visible"
            },
            {
                "ignored": "($index > 8)",
                "binding_name": "#item_durability_current_amount",
                "binding_type": "collection",
                "binding_collection_name": "$item_collection_name",
                "binding_condition": "visible"
            },
            {
                "ignored": "($index > 8)",
                "binding_name": "#item_durability_total_amount",
                "binding_type": "collection",
                "binding_collection_name": "$item_collection_name",
                "binding_condition": "visible"
            },
            {
                "binding_type": "view",
                "source_property_name": "(((#inventory_stack_count * 1) + (not (#item_id_aux = -1)) * (#inventory_stack_count = '') * 1))",
                "target_property_name": "#stack_count"
            },
            {
                "binding_type": "view",
                "source_property_name": "('§z' + #stack_count + $separator)",
                "target_property_name": "#text"
            }
        ]
    },

    // Mainhand item count total calc
    "mainhand_item_count_total_calc": {
        "$disable_total_item_count_indexes|default": false,
        "type": "label",
        "text": "#text",
        "shadow": true,
        "property_bag": {
            "#disabled_value": -1
        },
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "inv_slot_0",
                "source_property_name": "#stack_count",
                "target_property_name": "#i00"
            },

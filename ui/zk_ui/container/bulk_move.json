// ZK container bulk move
{
    "namespace": "zk_container_bulk_move",

    // Always listening button
    "always_listening_button": {
        "type": "button",
        "size": "$button_size",
        "$button_size|default": [30, 25],
        "$pressed_button_name|default": "button.container_auto_place",
        "layer": 1,
        "focus_enabled": false,
        "focus_wrap_enabled": false,
        "focus_magnet_enabled": false,
        "always_listen_to_input": true,
        "tts_ignore_count": true,
        "tts_skip_message": true,
        "tts_inherit_siblings": true,
        "button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "focused"
            }
        ]
    },

    // Bulk move item
    "bulk_move_item": {
        "type": "panel",
        "size": [0, 0],
        "bindings": [
            {
                "binding_name": "#item_id_aux",
                "binding_type": "collection",
                "binding_collection_name": "$item_collection_name"
            },
            {
                "binding_type": "view",
                "source_property_name": "(not (#item_id_aux = -1))",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "button@zk_container_bulk_move.always_listening_button": {
                    "bindings": [
                        {
                            "binding_type": "collection_details",
                            "binding_collection_name": "$item_collection_name",
                            "binding_condition": "once"
                        }
                    ]
                }
            }
        ]
    },

    // Bulk move stack
    "bulk_move_stack": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "size": [0, 0],
        "collection_name": "$item_collection_name",
        "$item_collection_name|default": "",
        "$factory_name|default": "empty_factory",
        "$container_size|default": 1,
        "factory": {
            "name": "$factory_name",
            "control_name": "zk_container_bulk_move.bulk_move_item"
        },
        "property_bag": {
            "#collection_length": "$container_size"
        },
        "bindings": [
            {
                "binding_type": "view",
                "source_property_name": "#collection_length",
                "target_property_name": "#collection_length"
            }
        ]
    },

    // Bulk move inventory items
    "bulk_move_inventory_items@zk_container_bulk_move.bulk_move_stack": {
        "$item_collection_name": "inventory_items",
        "$factory_name": "factory_bulk_move_inventory_items",
        "$container_size": 27
    },

    // Bulk move hotbar items
    "bulk_move_hotbar_items@zk_container_bulk_move.bulk_move_stack": {
        "$item_collection_name": "hotbar_items",
        "$factory_name": "factory_bulk_move_hotbar_items",
        "$container_size": 9
    },

    // Bulk move container items
    "bulk_move_container_items@zk_container_bulk_move.bulk_move_stack": {
        "$item_collection_name": "container_items",
        "$factory_name": "factory_bulk_move_container_items",
        "$container_size": "$zk_item_lore_viewer:container_items_collection_length"
    },

    // Bulk move tab state
    "bulk_move_tab_state": {
        "type": "image",
        "texture": "$tab_texture",
        "size": "$tab_size",
        "$tab_size|default": [30, 25],
        "$icon_offset|default": [0, 0],
        "controls": [
            {
                "icon": {
                    "type": "image",
                    "texture": "$icon_texture",
                    "color": "$icon_color",
                    "size": [13, 13],
                    "offset": "$icon_offset"
                }
            }
        ]
    },

    // Bulk move tab
    "bulk_move_tab": {
        "type": "button",
        "size": "$tab_size",
        "$tab_size|default": [30, 25],
        "$icon_offset|default": [0, 0],
        "$icon_offset_pressed|default": [0, 1],
        "default_control": "default",
        "hover_control": "hover",
        "pressed_control": "pressed",
        "sound_name": "random.click",
        "sound_volume": 1.0,
        "$pressed_button_name|default": "button.ignore_me",
        "button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "focused"
            }
        ],
        "controls": [
            {
                "default@zk_container_bulk_move.bulk_move_tab_state": {
                    "$tab_texture": "textures/ui/TabRightBack",
                    "$icon_color": "$tab_unchecked_text_color"
                }
            },
            {
                "hover@zk_container_bulk_move.bulk_move_tab_state": {
                    "$tab_texture": "textures/ui/TabRightBackHover",
                    "$icon_color": "$tab_unchecked_hover_text_color",
                    "$hover_state": true,
                    "controls": [
                        {
                            "icon": {
                                "type": "image",
                                "texture": "$icon_texture",
                                "color": "$icon_color",
                                "size": [13, 13],
                                "offset": "$icon_offset"
                            }
                        },
                        {
                            "hover_text@zk_common.hover_text_panel": {}
                        }
                    ]
                }
            },
            {
                "pressed@zk_container_bulk_move.bulk_move_tab_state": {
                    "$tab_texture": "textures/ui/TabRightBackHover",
                    "$icon_color": "$tab_unchecked_hover_text_color",
                    "$icon_offset": "$icon_offset_pressed"
                }
            }
        ]
    },

    // Move all to container tab
    "move_to_container_tab": {
        "type": "panel",
        "size": [30, 25],
        "controls": [
            {
                "inventory_items@zk_container_bulk_move.bulk_move_inventory_items": {}
            },
            {
                "hotbar_items@zk_container_bulk_move.bulk_move_hotbar_items": {}
            },
            {
                "tab@zk_container_bulk_move.bulk_move_tab": {
                    "$icon_offset": [1, 0],
                    "$icon_offset_pressed": [1, 1],
                    "$icon_texture": "textures/zk_ui/container/move_from_icon",
                    "$hover_text": "container.moveAll.toContainer",
                    "$hover_text_anchor": "right_middle",
                    "$hover_text_offset": [-8, 2]
                }
            }
        ]
    },

    // Move all to inventory tab
    "move_to_inventory_tab": {
        "type": "panel",
        "size": [31, 25],
        "$button_size": [31, 25],
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "offset": [24, 0],
        "controls": [
            {
                "container_items@zk_container_bulk_move.bulk_move_container_items": {}
            },
            {
                "tab@zk_container_bulk_move.bulk_move_tab": {
                    "$tab_size": [31, 25],
                    "$icon_offset": [0.5, 0],
                    "$icon_offset_pressed": [0.5, 1],
                    "$icon_texture": "textures/zk_ui/container/move_to_icon",
                    "$hover_text": "container.moveAll.toInventory",
                    "$hover_text_anchor": "right_middle",
                    "$hover_text_offset": [-8, 2]
                }
            }
        ]
    },

    // Bulk move tabs
    "bulk_move_tabs": {
        "type": "panel",
        "size": [55, 25],
        "anchor_from": "top_right",
        "anchor_to": "top_left",
        "offset": [-4, 75],
        "layer": 8,
        "controls": [
            {
                "to_container@zk_container_bulk_move.move_to_container_tab": {
                    "anchor_from": "top_left",
                    "anchor_to": "top_left"
                }
            },
            {
                "to_inventory@zk_container_bulk_move.move_to_inventory_tab": {}
            }
        ]
    }
}

// ZK container item search
{
    "namespace": "zk_item_search",

    // Highlight item bindings
    "highlight_item_bindings": {
        "bindings": [
            {
                "binding_type": "collection_details",
                "binding_collection_name": "$item_collection_name"
            },
            {
                "binding_type": "view",
                "source_control_name": "invert_search_tog",
                "source_property_name": "#toggle_state",
                "target_property_name": "#invert"
            },
            {
                "binding_name": "#hover_text",
                "binding_type": "collection",
                "binding_collection_name": "$item_collection_name"
            },
            {
                "binding_type": "view",
                "source_control_name": "search_items_control",
                "source_property_name": "#item_name",
                "target_property_name": "#item_search_control"
            },
            {
                "binding_type": "view",
                "source_control_name": "item_search_tog",
                "source_property_name": "#toggle_state",
                "target_property_name": "#search_open"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#invert = ((#hover_text - #item_search_control) = #hover_text))",
                "target_property_name": "#highlight_item_mode"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#highlight_item_mode = (#item_search_control = ''))",
                "target_property_name": "#nonhighlighted_item_mode"
            },
            {
                "binding_type": "view",
                "source_property_name": "$item_action",
                "target_property_name": "#visible"
            }
        ]
    },

    // Container item utils
    "container_item_utils": {
        "type": "panel",
        "controls": [
            {
                "unhighlighted_item@zk_item_search.highlight_item_bindings": {
                    "type": "image",
                    "texture": "textures/ui/Black",
                    "alpha": 0.665,
                    "size": ["100%", "100%"],
                    "layer": 28,
                    "visible": false,
                    "$item_action": "(#nonhighlighted_item_mode and #search_open)"
                }
            },
            {
                "highlighted_item@zk_item_search.highlight_item_bindings": {
                    "type": "image",
                    "texture": "textures/ui/White",
                    "color": [0.0, 0.745, 0.0],
                    "size": ["100% - 2px", "100% - 2px"],
                    "alpha": 0.25,
                    "layer": 2,
                    "visible": false,
                    "$item_action": "(#highlight_item_mode and #search_open)"
                }
            }
        ]
    },

    // Search slot item
    "search_slot_item": {
        "type": "panel",
        "collection_index": "$id"
    },

    // Slot count search
    "slot_count_search@zk_item_search.search_slot_item": {
        "bindings": [
            {
                "binding_name": "#hover_text",
                "binding_type": "collection",
                "binding_collection_name": "$item_collection_name"
            },
            {
                "binding_type": "view",
                "source_control_name": "search_items_control",
                "source_property_name": "#item_name",
                "target_property_name": "#item_search_control"
            },
            {
                "binding_type": "view",
                "source_control_name": "invert_search_tog",
                "source_property_name": "#toggle_state",
                "target_property_name": "#invert"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#invert = ((#hover_text - #item_search_control) = #hover_text) * 1)",
                "target_property_name": "#searched"
            }
        ]
    },

    // Item count search
    "item_count_search@zk_item_search.search_slot_item": {
        "bindings": [
            {
                "binding_name": "#inventory_stack_count",
                "binding_type": "collection",
                "binding_collection_name": "$item_collection_name"
            },
            {
                "binding_name": "#item_id_aux",
                "binding_type": "collection",
                "binding_collection_name": "$item_collection_name"
            },
            {
                "binding_name": "#hover_text",
                "binding_type": "collection",
                "binding_collection_name": "$item_collection_name"
            },
            {
                "binding_type": "view",
                "source_control_name": "search_items_control",
                "source_property_name": "#item_name",
                "target_property_name": "#item_search_control"
            },
            {
                "binding_type": "view",
                "source_control_name": "invert_search_tog",
                "source_property_name": "#toggle_state",
                "target_property_name": "#invert"
            },
            {
                "binding_type": "view",
                "source_property_name": "((0 + #inventory_stack_count) + (not (#item_id_aux = -1) * (#inventory_stack_count < 2)))",
                "target_property_name": "#count"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#invert = ((#hover_text - #item_search_control) = #hover_text))",
                "target_property_name": "#highlight_item_mode"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#count * #highlight_item_mode)",
                "target_property_name": "#stack_count"
            }
        ]
    },

    // Search slot group
    "search_slot_group": {
        "type": "panel"
    },

    // Search slot control
    "search_slot_control": {
        "$ctrl": "($key + $id + '@' + $item_ctrl_name)",
        "type": "collection_panel",
        "collection_name": "$item_collection_name",
        "controls": [
            {
                "$ctrl": {}
            }
        ]
    },

    // Search slots data
    "search_slots_data": {
        "$item_collection_name|default": "container_items",
        "$item_ctrl_name|default": "unset",
        "$key|default": "unset",
        "$source_item|default": "#unset",
        "$output_name|default": "#unset",
        "$is_large_chest|default": false,
        "$amount|default": 27,
        "$source_prop|default": "(#a0 + #a1 + #a2 + #a3 + #a4 + #a5 + #a6 + #a7 + #a8 + #a9 + #a10 + #a11 + #a12 + #a13 + #a14 + #a15 + #a16 + #a17 + #a18 + #a19 + #a20 + #a21 + #a22 + #a23 + #a24 + #a25 + #a26)",

    // Item counts bind
    "item_counts_bind@zk_item_search.search_slots_data": {
        "$item_ctrl_name": "item_count_search",
        "$key": "kO66c",
        "$source_item": "#stack_count",
        "$output_name": "#ttl_item_count"
    },

    // Slot counts bind
    "slot_counts_bind@zk_item_search.search_slots_data": {
        "$item_ctrl_name": "slot_count_search",
        "$key": "xMR1Y",
        "$source_item": "#searched",
        "$output_name": "#ttl_slot_count"
    },

    // Items found panel
    "items_found_panel": {
        "type": "image",
        "texture": "textures/ui/hud_tip_text_background",
        "alpha": 0.8,
        "size": ["100%c + 10px", "100%c + 6px"],
        "anchor_from": "top_middle",
        "anchor_to": "bottom_middle",
        "offset": [0, -2],
        "controls": [
            {
                "item_counts_bind@zk_item_search.item_counts_bind": {}
            },
            {
                "slot_counts_bind@zk_item_search.slot_counts_bind": {}
            },
            {
                "text": {
                    "type": "label",
                    "text": "#text",
                    "size": ["default", 10],
                    "layer": 2,
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "item_counts_bind",
                            "source_property_name": "#ttl_item_count",
                            "target_property_name": "#ttl_item_count"
                        },
                        {
                            "binding_type": "view",
                            "source_control_name": "slot_counts_bind",
                            "source_property_name": "#ttl_slot_count",
                            "target_property_name": "#ttl_slot_count"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "('%zk.itemsFound: ' + #ttl_item_count + ' §7(' + #ttl_slot_count + ' %zk.slotsFound)')",
                            "target_property_name": "#text"
                        }
                    ]
                }
            }
        ],
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "slot_counts_bind",
                "source_property_name": "(not #ttl_slot_count = 0)",
                "target_property_name": "#visible"
            }
        ]
    },

    // Invert search icon
    "invert_search_icon": {
        "type": "panel",
        "controls": [
            {
                "icon": {
                    "type": "image",
                    "texture": "textures/zk_ui/container/invert_search_glyph",
                    "size": [10, 10],
                    "color": "$text_color"
                }
            },
            {
                "hover_text@zk_common.custom_hover_text_anims": {
                    "$hover_text": "%zk.invertSearchTip",
                    "$hover_text_anchor": "bottom_right"
                }
            }
        ]
    },

    // Item search tab state
    "item_search_tab_state": {
        "type": "image",
        "texture": "$tab_texture",
        "size": [30, 25],
        "controls": [
            {
                "icon": {
                    "type": "image",
                    "texture": "textures/ui/magnifying_glass",
                    "color": "$icon_color",
                    "size": [11, 11],
                    "offset": "$icon_offset"
                }
            }
        ]
    },

    // Item search tab
    "item_search_tab": {
        "type": "panel",
        "size": [30, 25],
        "controls": [
            {
                "item_search_tog@common.toggle": {
                    "$toggle_name": "item_search",
                    "$toggle_view_binding_name": "item_search_tog",
                    "size": [30, 25],
                    "$toggle_binding_type": "none",
                    "$unchecked_control": "zk_item_search.item_search_tab_default",
                    "$checked_control": "zk_item_search.item_search_tab_checked",
                    "$unchecked_hover_control": "zk_item_search.item_search_tab_hover",
                    "$checked_hover_control": "zk_item_search.item_search_tab_checked_hover",
                    "$unchecked_locked_control": "zk_item_search.item_search_tab_default",
                    "$checked_locked_control": "zk_item_search.item_search_tab_checked",
                    "$unchecked_locked_hover_control": "zk_item_search.item_search_tab_default",
                    "$checked_locked_hover_control": "zk_item_search.item_search_tab_checked"
                }
            }
        ]
    },

    // Item search tab default
    "item_search_tab_default@zk_item_search.item_search_tab_state": {
        "$tab_texture": "textures/ui/TabRightBack",
        "$icon_color": "$tab_unchecked_text_color",
        "$icon_offset": [1, 0]
    },

    // Item search tab hover
    "item_search_tab_hover@zk_item_search.item_search_tab_state": {
        "$tab_texture": "textures/ui/TabRightBackHover",
        "$icon_color": "$tab_unchecked_hover_text_color",
        "$icon_offset": [1, 0],
        "$hover_state": true,
        "controls": [
            {
                "icon": {
                    "type": "image",
                    "texture": "textures/ui/magnifying_glass",
                    "color": "$icon_color",
                    "size": [11, 11],
                    "offset": [1, 0]
                }
            },
            {
                "hover_text@zk_common.hover_text_panel": {
                    "$hover_text": "zk.searchBar",
                    "$hover_text_anchor": "right_middle",
                    "$hover_text_offset": [-8, 2]
                }
            }
        ]
    },

    // Item search tab checked
    "item_search_tab_checked@zk_item_search.item_search_tab_state": {
        "$tab_texture": "textures/ui/TabRightFront",
        "$icon_color": "$tab_checked_text_color",
        "$icon_offset": [1, 0]
    },

    // Item search tab checked hover
    "item_search_tab_checked_hover@zk_item_search.item_search_tab_checked": {
        "$tab_texture": "textures/ui/TabRightFrontHover",
        "$icon_color": "$tab_checked_hover_text_color",
        "$hover_state": true,
        "controls": [
            {
                "icon": {
                    "type": "image",
                    "texture": "textures/ui/magnifying_glass",
                    "color": "$icon_color",
                    "size": [11, 11],
                    "offset": [1, 0]
                }
            },
            {
                "hover_text@zk_common.hover_text_panel": {
                    "$hover_text": "zk.searchBar",
                    "$hover_text_anchor": "right_middle",
                    "$hover_text_offset": [-8, 2]
                }
            }
        ]
    },

    // Item search bar
    "item_search_bar": {
        "type": "panel",
        "size": [176, 16],
        "anchor_from": "bottom_middle",
        "anchor_to": "bottom_middle",
        "offset": [0, -4],
        "$search_count_container|default": false,
        "$is_large_chest|default": false,
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "item_search_tog",
                "source_property_name": "#toggle_state",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "bar": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%", "100%"],
                    "controls": [
                        {
                            "text_box_panel": {
                                "type": "panel",
                                "size": ["fill", "100%"],
                                "controls": [
                                    {
                                        "search_items_text_box@zk_common.custom_text_edit_box": {
                                            "max_length": 50,
                                            "layer": 1,
                                            "size": ["100%", 16],
                                            "$text_box_name": "search_items_text_box",
                                            "$text_edit_text_control": "search_items_control",
                                            "$place_holder_text": "zk.searchItems",
                                            "$text_box_font_scale_factor": 0.7,
                                            "$text_edit_box_label_offset": [15, 1],
                                            "$clear_text_box_button_name": "clear_item_search_bar_button",
                                            "focus_wrap_enabled": false,
                                            "default_focus_precedence": -2
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "invert_panel": {
                                "type": "panel",
                                "size": [16, "100%"],
                                "controls": [
                                    {
                                        "invert_search_toggle@common_toggles.light_content_toggle": {
                                            "$toggle_name": "invert_search_de",
                                            "$toggle_view_binding_name": "invert_search_tog",
                                            "$button_content": "zk_item_search.invert_search_icon",
                                            "size": ["100%y", "100%"],
                                            "anchor_from": "right_middle",
                                            "anchor_to": "right_middle"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "items_found@zk_item_search.items_found_panel": {
                    "ignored": "(not $search_count_container)"
                }
            }
        ]
    }
}

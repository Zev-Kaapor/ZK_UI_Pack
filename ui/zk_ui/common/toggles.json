// ZK toggles
{
    "namespace": "zk_toggles",

    // Back arrow toggle
    "back_arrow_toggle@zk_common.raw_toggle": {
        "$radio_toggle_group": true,
        "$unchecked_control": "zk_buttons.close_button_content_def",
        "$checked_control": "zk_buttons.close_button_content_def",
        "$unchecked_hover_control": "zk_buttons.close_button_content",
        "$checked_hover_control": "zk_buttons.close_button_content",
        "size": [15, 15],
        "$raw_toggle_size": [24, 24],
        "$button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "button.menu_select",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_cancel",
                "to_button_id": "button.menu_ok",
                "mapping_type": "global"
            },
            {
                "from_button_id": "button.menu_exit",
                "to_button_id": "button.menu_ok",
                "mapping_type": "global"
            }
        ]
    },

    // Light template toggle
    "light_template_toggle@common_toggles.light_template_toggle": {
        "$toggle_sound_name|default": "random.release",
        "$default_text_color|default": "$oreui_default_text_color",
        "$hover_text_color|default": "$oreui_default_text_color",
        "$pressed_text_color|default": "$oreui_default_text_color",
        "$locked_text_color|default": "$oreui_locked_text_color",
        "$locked_alpha": 1.0,
        "$toggle_sound_name": "random.release",
        "$unchecked_control|default": "zk_toggles.toggle_unchecked",
        "$checked_control|default": "zk_toggles.toggle_checked",
        "$unchecked_hover_control|default": "zk_toggles.toggle_unchecked_hover",
        "$checked_hover_control|default": "zk_toggles.toggle_checked_hover",
        "$unchecked_locked_control|default": "zk_toggles.toggle_locked",
        "$unchecked_locked_hover_control|default": "zk_toggles.toggle_locked",
        "$checked_locked_control|default": "zk_toggles.toggle_locked",
        "$checked_locked_hover_control|default": "zk_toggles.toggle_locked",
        "$default_texture|default": "textures/zk_ui/ore_ui/buttons/button_borderless_light",
        "$hover_texture|default": "textures/zk_ui/ore_ui/buttons/button_borderless_lighthover",
        "$pressed_no_hover_texture|default": "textures/zk_ui/ore_ui/buttons/button_borderless_lightpressed",
        "$pressed_texture|default": "textures/zk_ui/ore_ui/buttons/button_borderless_lightpressed",
        "$locked_texture|default": "textures/zk_ui/ore_ui/buttons/button_borderless_lightlocked"
    },

    // Dark template toggle
    "dark_template_toggle@common_toggles.light_template_toggle": {
        "$default_text_color|default": "$f_color_format",
        "$hover_text_color|default": "$f_color_format",
        "$pressed_text_color|default": "$f_color_format",
        "$locked_text_color|default": "$f_color_format",
        "$default_border_color": "$0_color_format",
        "$hover_border_color": "$0_color_format",
        "$locked_alpha": 1.0,
        "$toggle_sound_name": "random.release",
        "$unchecked_control|default": "zk_toggles.toggle_unchecked",
        "$checked_control|default": "zk_toggles.toggle_checked",
        "$unchecked_hover_control|default": "zk_toggles.toggle_unchecked_hover",
        "$checked_hover_control|default": "zk_toggles.toggle_checked_hover",
        "$unchecked_locked_control|default": "zk_toggles.toggle_locked",
        "$unchecked_locked_hover_control|default": "zk_toggles.toggle_locked",
        "$checked_locked_control|default": "zk_toggles.toggle_locked",
        "$checked_locked_hover_control|default": "zk_toggles.toggle_locked",
        "$default_texture|default": "textures/zk_ui/ore_ui/buttons/button_borderless_dark",
        "$hover_texture|default": "textures/zk_ui/ore_ui/buttons/button_borderless_darkhover",
        "$pressed_no_hover_texture|default": "textures/zk_ui/ore_ui/buttons/button_borderless_darkpressed",
        "$pressed_texture|default": "textures/zk_ui/ore_ui/buttons/button_borderless_darkpressed",
        "$locked_texture|default": "textures/zk_ui/ore_ui/buttons/button_borderless_darklocked"
    },

    // Light ui toggle
    "light_ui_toggle": {
        "type": "panel",
        "$toggle_view_binding_name|default": "this_toggle",
        "$template_toggle|default": "zk_toggles.light_template_toggle",
        "controls": [
            {
                "$toggle_view_binding_name@$template_toggle": {}
            }
        ]
    },

    // Dark ui toggle
    "dark_ui_toggle": {
        "type": "panel",
        "$toggle_view_binding_name|default": "this_toggle",
        "$template_toggle|default": "zk_toggles.dark_template_toggle",
        "controls": [
            {
                "$toggle_view_binding_name@$template_toggle": {}
            }
        ]
    },

    // Dark content toggle
    "dark_content_toggle@zk_toggles.dark_ui_toggle": {
        "$default_border_color": "$0_color_format",
        "$hover_border_color": "$0_color_format",
        "$button_type_panel": "common_buttons.button_content_panel",
        "$button_content|default": "common.empty_panel",
        "$button_offset|default": [0, 0]
    },

    // Light text toggle
    "light_text_toggle@zk_toggles.light_ui_toggle": {
        "$default_text_color": "$oreui_default_text_color",
        "$hover_text_color": "$oreui_default_text_color",
        "$pressed_text_color": "$oreui_default_text_color",
        "$locked_text_color": "$oreui_default_text_color",
        "$button_type_panel": "common_buttons.new_ui_binding_button_label",
        "$button_text|default": "",
        "$pressed_alpha|default": 1,
        "$button_text_binding_type|default": "none",
        "$button_text_grid_collection_name|default": "",
        "$button_binding_condition|default": "none",
        "$button_offset|default": [0, -1],
        "$button_pressed_offset|default": [0, 1]
    },

    // Light content toggle
    "light_content_toggle@zk_toggles.light_ui_toggle": {
        "$button_type_panel": "common_buttons.button_content_panel",
        "$button_content|default": "common.empty_panel",
        "$button_offset|default": [0, 0]
    },

    // Toggle unchecked
    "toggle_unchecked@common_toggles.toggle_state_panel": {
        "$new_ui_button_texture": "$default_texture",
        "$content_alpha": "$default_texture_alpha",
        "$button_image_color": "$default_texture_color",
        "$text_color": "$default_text_color",
        "$glyph_color": "$default_glyph_color",
        "$toggle_image": "$unchecked_image",
        "$border_layer": 1,
        "$border_visible": "$default_border_visible",
        "$border_color": "$default_border_color",
        "$toggle_unchecked": true,
        "$default_state": true,
        "$button_offset": [0, -1],
        "layer": 1
    },

    // Toggle checked
    "toggle_checked@common_toggles.toggle_state_panel": {
        "$new_ui_button_texture": "$pressed_texture",
        "$content_alpha": "$default_checked_texture_alpha",
        "$button_image_color": "$default_checked_texture_color",
        "$text_color": "$default_checked_text_color",
        "$glyph_color": "$default_checked_glyph_color",
        "$toggle_image": "$checked_image",
        "$border_layer": 2,
        "$border_visible": "$default_border_visible",
        "$border_color": "$default_border_color",
        "$toggle_checked": true,
        "$button_offset": [0, 1],
        "$focus_border_anchor_from": "bottom_middle",
        "$focus_border_anchor_to": "bottom_middle",
        "$pressed_state": true,
        "$focus_border_size": ["100%", "100% - 2px"],
        "layer": 2
    },

    // Toggle unchecked hover
    "toggle_unchecked_hover@common_toggles.toggle_state_panel": {
        "$new_ui_button_texture": "$hover_texture",
        "$content_alpha": "$hover_texture_alpha",
        "$button_image_color": "$hover_texture_color",
        "$text_color": "$hover_text_color",
        "$glyph_color": "$hover_glyph_color",
        "$toggle_image": "$unchecked_image",
        "$border_layer": 3,
        "$border_visible": "$default_border_visible",
        "$border_color": "$default_border_color",
        "$toggle_unchecked_hover": true,
        "$is_ore_ui_button": true,
        "$hover_state": true,
        "$button_offset": [0, -1],
        "layer": 3
    },

    // Toggle checked hover
    "toggle_checked_hover@common_toggles.toggle_state_panel": {
        "$new_ui_button_texture": "$pressed_texture",
        "$content_alpha": "$hover_checked_texture_alpha",
        "$button_image_color": "$hover_checked_texture_color",
        "$text_color": "$hover_checked_text_color",
        "$glyph_color": "$hover_checked_glyph_color",
        "$toggle_image": "$checked_image",
        "$border_layer": 4,
        "$button_offset": [0, 1],
        "$border_visible": "$default_border_visible",
        "$border_color": "$default_border_color",
        "$toggle_checked_hover": true,
        "$is_ore_ui_button": true,
        "$pressed_state": true,
        "$focus_border_size": ["100%", "100% - 2px"],
        "$focus_border_anchor_from": "bottom_middle",
        "$focus_border_anchor_to": "bottom_middle",
        "layer": 4
    },

    // Toggle locked
    "toggle_locked@common_toggles.toggle_state_panel": {
        "$new_ui_button_texture": "$locked_texture",
        "$content_alpha": "$locked_alpha",
        "$button_image_color": "$default_texture_color",
        "$text_color": "$default_text_color",
        "$glyph_color": "$default_glyph_color",
        "$toggle_image": "$unchecked_image",
        "$button_image": "common_buttons.locked_button_image",
        "$border_layer": 1,
        "$border_visible": "$default_border_visible",
        "$border_color": "$8_color_format",
        "$toggle_locked": true,
        "$default_state": true,
        "$button_offset": [0, -1],
        "layer": 1
    },

    // Text toggle default
    "text_toggle_default": {
        "type": "label",
        "text": "$text_toggle",
        "size": ["default", 10],
        "color": "$text_color_toggle",
        "alpha": "$alpha_t44",
        "propagate_alpha": true,
        "$hover|default": false,
        "controls": [
            {
                "line": {
                    "type": "image",
                    "texture": "textures/ui/White",
                    "size": ["100%", 1],
                    "anchor_from": "bottom_middle",
                    "anchor_to": "bottom_middle",
                    "color": "$line_color_toggle"
                }
            },
            {
                "hover": {
                    "ignored": "(not $hover)",
                    "type": "image",
                    "texture": "textures/ui/White",
                    "layer": -1,
                    "alpha": 0.15
                }
            }
        ]
    }
}

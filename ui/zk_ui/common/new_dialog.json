// ZK dialog
{
    "namespace": "zk_dialog",

    // Standard title label
    "standard_title_label": {
        "$use_oreui_title_style|default": false,
        "$title_font_type|default": "default",
        "$title_font_scale_factor|default": 1,
        "$title_shadow|default": true,
        "$title_size|default": ["default", "default"],
        "$title_max_size|default": ["100%", "default"],
        "$title_offset|default": [0, 0],
        "$title_binding_condition|default": "none",
        "$title_text_binding_type|default": "none",
        "variables": [
            {
                "requires": "$use_oreui_title_style",
                "$title_font_type": "MinecraftTen",
                "$title_font_scale_factor": 1.3,
                "$title_offset": [0, -1]
            }
        ],
        "type": "label",
        "text": "$title_text",
        "size": "$title_size",
        "offset": "$title_offset",
        "max_size": "$title_max_size",
        "font_type": "$title_font_type",
        "font_scale_factor": "$title_font_scale_factor",
        "shadow": "$title_shadow",
        "layer": 9,
        "bindings": [
            {
                "binding_name": "$title_text",
                "binding_name_override": "$title_text",
                "binding_type": "$title_text_binding_type",
                "binding_condition": "$title_binding_condition"
            }
        ]
    },

    // Title panel
    "title_panel": {
        "$custom_title_controls|default": "zk.empty_panel",
        "type": "panel",
        "controls": [
            {
                "common_dialogs_0@zk_dialog.standard_title_label": {
                    "ignored": "(not ($custom_title_controls = 'zk.empty_panel'))"
                }
            },
            {
                "common_dialogs_1@$custom_title_controls": {}
            }
        ]
    },

    // Close button content
    "close_button_content": {
        "$cloae_disj|default": "textures/zk_ui/ore_ui/buttons/close_button_icon",
        "$is_pressed_state|default": false,
        "$is_hover_state|default": false,
        "$size_cimg|default": [12, 12],
        "type": "panel",
        "controls": [
            {
                "cross_image": {
                    "type": "image",
                    "texture": "$cloae_disj",
                    "size": "$size_cimg",
                    "layer": 2
                }
            },
            {
                "hover": {
                    "ignored": "(not $is_hover_state)",
                    "type": "image",
                    "texture": "textures/ui/White",
                    "color": "$8_color_format"
                }
            },
            {
                "pressed": {
                    "ignored": "(not $is_pressed_state)",
                    "type": "image",
                    "texture": "textures/ui/Black",
                    "alpha": 0.25,
                    "color": "$0_color_format"
                }
            }
        ]
    },

    // Close toggle content hover
    "close_toggle_content_hover@zk_dialog.close_button_content": {
        "$is_hover_state": true
    },

    // Close toggle
    "close_toggle@zk_common.raw_toggle": {
        "$toggle_name": "$dialog_close_toggle_name",
        "$toggle_view_binding_name": "('e89c_' + $dialog_close_toggle_name)",
        "$radio_toggle_group": true,
        "$toggle_default_state": true,
        "$toggle_group_forced_index": 97,
        "$unchecked_control": "zk_dialog.close_button_content",
        "$checked_control": "zk_dialog.close_button_content",
        "$unchecked_hover_control": "zk_dialog.close_toggle_content_hover",
        "$checked_hover_control": "zk_dialog.close_toggle_content_hover",
        "$button_mappings": "$close_button_mappings_dialog"
    },

    // Close button panel
    "close_button_panel": {
        "ignored": "(not $show_close_button)",
        "type": "panel",
        "size": [24, 24],
        "anchor_from": "right_middle",
        "anchor_to": "right_middle",
        "offset": [-2, 0],
        "controls": [
            {
                "button@common.close_button": {
                    "ignored": "(not ($dialog_close_toggle_name = 'unset_close_dialog'))",
                    "$close_button_offset": [0, 0],
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "size": ["100%", "100%"],
                    "controls": [
                        {
                            "default@zk_dialog.close_button_content": {}
                        },
                        {
                            "hover@zk_dialog.close_button_content": {
                                "$is_hover_state": true
                            }
                        },
                        {
                            "pressed@zk_dialog.close_button_content": {
                                "$is_pressed_state": true
                            }
                        }
                    ],
                    "button_mappings": "$_close_button_mappings",
                    "$_close_button_mappings|default": [
                        {
                            "from_button_id": "button.menu_select",
                            "to_button_id": "$close_button_to_button_id",
                            "mapping_type": "pressed"
                        },
                        {
                            "from_button_id": "button.menu_ok",
                            "to_button_id": "$close_button_to_button_id",
                            "mapping_type": "focused"
                        }
                    ]
                }
            },
            {
                "toggle@zk_dialog.close_toggle": {}
            }
        ]
    },

    // Global dialog
    "global_dialog": {
        "$content_controls|default": "zk.empty_panel",
        "$child_footer_controls|default": "zk.empty_panel",
        "$show_close_button|default": true,
        "$use_close_toggle_button|default": false,
        "$show_search_bar|default": false,
        "$dialog_close_toggle_name|default": "unset_close_dialog",
        "type": "input_panel",
        "prevent_touch_input": true,
        "focus_enabled": false,
        "layer": 32,
        "$additional_button_panel|default": "common.empty_panel",
        "$top_button_controls|default": "zk.empty_panel",
        "$middle_button_controls|default": "zk.empty_panel",
        "$bottom_button_controls|default": "zk.empty_panel",
        "$dialig_search_bar_bindings|default": [],
        "$dialog_content_size|default": ["100% - 8px", "100% - 8px"],
        "$close_button_mappings_dialog": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "button.menu_select",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "button.menu_ok",
                "mapping_type": "focused"
            }
        ],
        "$use_scrolling_panel_oreui_style": true,
        "controls": [
            {
                "stacked": {
                    "type": "stack_panel",
                    "size": ["100%", "100%"],
                    "layer": 2,
                    "controls": [
                        {
                            "header_panel": {
                                "type": "image",
                                "texture": "textures/zk_ui/ore_ui/dialogs/dialog_background_header",
                                "size": ["100%", 28],
                                "controls": [
                                    {
                                        "additional_button_panel@$additional_button_panel": {
                                            "size": [24, 24],
                                            "anchor_from": "left_middle",
                                            "anchor_to": "left_middle",
                                            "offset": [2, 0]
                                        }
                                    },
                                    {
                                        "title_panel@zk_dialog.title_panel": {
                                            "layer": 2
                                        }
                                    },
                                    {
                                        "close_button_panel@zk_dialog.close_button_panel": {
                                            "layer": 2
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "search_bar_panel": {
                                "type": "panel",
                                "size": ["100%", "100%c"],
                                "ignored": "(not $show_search_bar)",
                                "controls": [
                                    {
                                        "search_bar@zk_common.custom_text_edit_box": {
                                            "$text_box_name": "search_items_text_box",
                                            "$text_edit_text_control": "search_items_control",
                                            "$place_holder_text": "zk.searchItems",
                                            "$text_background_default": "zk_common.edit_box_indent",
                                            "$text_background_hover": "zk_common.edit_box_indent_hover",
                                            "$clear_text_box_button_name": "clear_text_box_dialog_ctrl",
                                            "focus_wrap_enabled": false,
                                            "default_focus_precedence": -2,
                                            "size": ["100%", 16],
                                            "bindings": "$dialig_search_bar_bindings"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "body_panel": {
                                "type": "image",
                                "texture": "textures/zk_ui/ore_ui/dialogs/dialog_background",
                                "size": ["100%", "fill"],
                                "controls": [
                                    {
                                        "content@$content_controls": {
                                            "size": "$dialog_content_size",
                                            "layer": 2
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "footer_panel": {
                                "ignored": "($child_footer_controls = 'zk.empty_panel')",
                                "type": "image",
                                "texture": "textures/zk_ui/ore_ui/dialogs/dialog_background_footer",
                                "size": ["100%", "100%c + 8px"],
                                "controls": [
                                    {
                                        "footer_panel@$child_footer_controls": {}
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "border": {
                    "type": "image",
                    "texture": "textures/ui/Black",
                    "layer": -1,
                    "alpha": 0.67,
                    "size": ["100% + 2px", "100% + 2px"]
                }
            }
        ]
    }
}

// ZK sliders
{
    "namespace": "zk_sliders",

    // Slider button state
    "slider_button_state": {
        "type": "image",
        "layer": 2,
        "texture": "('textures/zk_ui/ore_ui/buttons/' + $texture_b)",
        "$hover_state|default": false,
        "controls": [
            {
                "border": {
                    "type": "image",
                    "texture": "textures/ui/slider_border",
                    "size": ["100% + 2px", "100% + 2px"],
                    "color": "$0_color_format"
                }
            },
            {
                "hover_border": {
                    "ignored": "(not $hover_state)",
                    "type": "image",
                    "texture": "textures/ui/slider_border",
                    "size": ["100% + 4px", "100% + 4px"],
                    "color": "$f_color_format",
                    "allow_clipping": false
                }
            }
        ]
    },

    // Slider button layout
    "slider_button_layout@zk_sliders.slider_button_state": {
        "$texture_b": "button_borderless_light"
    },

    // Slider button hover layout
    "slider_button_hover_layout@zk_sliders.slider_button_state": {
        "$hover_state": true,
        "$texture_b": "button_borderless_light"
    },

    // Slider button locked layout
    "slider_button_locked_layout@zk_sliders.slider_button_state": {
        "$texture_b": "button_borderless_lightlocked"
    },

    // Slider button indent layout
    "slider_button_indent_layout@zk_sliders.slider_button_state": {
        "$texture_b": "button_borderless_light"
    },

    // Slider background
    "slider_background": {
        "type": "image",
        "texture": "textures/zk_ui/ore_ui/sliders/slider_background"
    },

    // Slider progress
    "slider_progress": {
        "type": "image",
        "texture": "textures/zk_ui/ore_ui/sliders/slider_progress"
    },

    // Slider step
    "slider_step": {
        "type": "image",
        "texture": "textures/ui/slider_step_background",
        "size": [1.5, 3],
        "alpha": 0.8,
        "layer": 4,
        "offset": "$step_offset"
    },

    // Slider step hover
    "slider_step_hover@zk_sliders.slider_step": {
        "texture": "textures/ui/slider_step_background_hover"
    },

    // Slider step progress
    "slider_step_progress@zk_sliders.slider_step": {
        "texture": "textures/ui/slider_step_progress"
    },

    // Slider step progress hover
    "slider_step_progress_hover@zk_sliders.slider_step": {
        "texture": "textures/ui/slider_step_progress_hover"
    },

    // Oreui slider
    "oreui_slider@common.slider": {
        "$background_control": "zk_sliders.slider_background",
        "$progress_control": "zk_sliders.slider_progress",
        "$slider_box_layout": "zk_sliders.slider_button_layout",
        "$slider_box_hover_layout": "zk_sliders.slider_button_hover_layout",
        "$slider_box_locked_layout": "zk_sliders.slider_button_locked_layout",
        "$slider_box_indent_layout": "zk_sliders.slider_button_indent_layout",
        "$slider_box_size": [15, 15],
        "$slider_step_factory_control_ids": {
            "slider_step": "@zk_sliders.slider_step",
            "slider_step_hover": "@zk_sliders.slider_step_hover",
            "slider_step_progress": "@zk_sliders.slider_step_progress",
            "slider_step_progress_hover": "@zk_sliders.slider_step_progress_hover"
        },
        "controls": [
            {
                "slider_box@common.slider_box": {
                    "$slider_box_layout": "$slider_box_layout",
                    "$slider_box_size": "$slider_box_size",
                    "$slider_track_button": "$slider_name"
                }
            },
            {
                "slider_bar_default@common.slider_border": {
                    "$background_control|default": "common.slider_background",
                    "$progress_control|default": "common.slider_progress",
                    "$background_control_name|default": "slider_background",
                    "$progress_control_name|default": "slider_progress",
                    "$progress_clip_direction|default": "left",
                    "color": "$slider_default_border_color",
                    "size": ["100%", 7],
                    "propagate_alpha": true,
                    "property_bag": {
                        "#true": 1.0,
                        "#false": 0.5
                    },
                    "controls": [
                        {
                            "sizing_panel": {
                                "type": "panel",
                                "size": ["100% - 2px", "100% - 2px"],
                                "controls": [
                                    {
                                        "$background_control_name@$background_control": {
                                            "layer": 1
                                        }
                                    },
                                    {
                                        "$progress_control_name@$progress_control": {
                                            "layer": 3,
                                            "clip_direction": "$progress_clip_direction",
                                            "clip_pixelperfect": false
                                        }
                                    }
                                ]
                            }
                        }
                    ],
                    "bindings": [
                        {
                            "binding_type": "$slider_enabled_binding_type",
                            "binding_condition": "$slider_enabled_binding_condition",
                            "binding_collection_name": "$slider_collection_name",
                            "binding_name": "$slider_enabled_binding_name",
                            "binding_name_override": "#enabled"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "('#' + #enabled)",
                            "target_property_name": "#alpha"
                        }
                    ]
                }
            },
            {
                "slider_bar_hover@common.slider_bar_hover": {
                    "size": ["100%", 7],
                    "visible": false
                }
            }
        ]
    }
}

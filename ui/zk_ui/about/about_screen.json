// ZK about screen sections
{
    "namespace": "zk_about",

    // Section selector
    "selector_stack_panel": {
        "type": "stack_panel",
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "orientation": "vertical",
        "$default_selector_toggle_index": 0,
        "ttsSectionContainer": true,
        "controls": [
            {
                "zk_about_selector_pane": {
                    "type": "stack_panel",
                    "controls": [
                        {
                            "padding_0": {
                                "type": "panel",
                                "size": [0, 4]
                            }
                        },
                        {
                            "about_button@zk_about.about_button": {
                                "$toggle_group_forced_index": 0
                            }
                        },
                        {
                            "features_button@zk_about.features_button": {
                                "$toggle_group_forced_index": 1
                            }
                        },
                        {
                            "credits_button@zk_about.credits_button": {
                                "$toggle_group_forced_index": 2
                            }
                        },
                        {
                            "usage_button@zk_about.usage_button": {
                                "$toggle_group_forced_index": 3
                            }
                        },
                        {
                            "changelog_category@zk_about_common.topic_category": {
                                "$category": "changelog"
                            }
                        },
                        {
                            "changelog050_button@zk_about.changelog050_button": {
                                "$toggle_group_forced_index": 4
                            }
                        },
                        {
                            "changelog040_button@zk_about.changelog040_button": {
                                "$toggle_group_forced_index": 5
                            }
                        },
                        {
                            "changelog031_button@zk_about.changelog031_button": {
                                "$toggle_group_forced_index": 6
                            }
                        },
                        {
                            "changelog030_button@zk_about.changelog030_button": {
                                "$toggle_group_forced_index": 7
                            }
                        },
                        {
                            "changelog020_button@zk_about.changelog020_button": {
                                "$toggle_group_forced_index": 8
                            }
                        },
                        {
                            "changelog010_button@zk_about.changelog010_button": {
                                "$toggle_group_forced_index": 9
                            }
                        },
                        {
                            "changelog001_button@zk_about.changelog001_button": {
                                "$toggle_group_forced_index": 10
                            }
                        }
                    ]
                }
            }
        ]
    },

    // Header section titles
    "section_title_labels": {
        "type": "panel",
        "size": ["100%c", "100%c"],
        "controls": [
            {
                "about@zk_about_common.section_title": {

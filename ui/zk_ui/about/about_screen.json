    // About button
    "about_button@zk_about_common.section_toggle_button": {
        "$section_topic": "about"
    },

    // About section
    "about_section@zk_about_common.main_sections": {
        "$section_topic_control": "about",
        "controls": [
            {
                "pack_info_stack": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%", 48],
                    "controls": [
                        {
                            "pack_icon": {
                                "type": "image",
                                "texture": "textures/zk_ui/icons/about",
                                "size": [48, 48],
                                "layer": 1
                            }
                        },
                        {
                            "padding": {
                                "type": "panel",
                                "size": [6, 4]
                            }
                        },
                        {
                            "text_panel": {
                                "type": "stack_panel",
                                "orientation": "vertical",
                                "size": ["fill", "100%"],
                                "controls": [
                                    {
                                        "pad_top": {
                                            "type": "panel",
                                            "size": [0, 8]
                                        }
                                    },
                                    {
                                        "pack_name@zk_about_common.generic_label": {
                                            "localize": false,
                                            "text": "§eZK UI PACK",
                                            "font_type": "MinecraftTen",
                                            "font_size": "large"
                                        }
                                    },
                                    {
                                        "pad_version": {
                                            "type": "panel",
                                            "size": [0, 2]
                                        }
                                    },
                                    {
                                        "version_text@zk_about_common.generic_label": {
                                            "text": "zk.about.packVersion"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "padding_0": {
                    "type": "panel",
                    "size": [0, 8]
                }
            },
            {
                "label_creator@zk_about_common.generic_label": {
                    "text": "zk.about.creator"
                }
            },
            {
                "label_github@zk_about_common.generic_label": {
                    "localize": false,
                    "text": "§bGitHub§r: github.com/Zev-Kaapor/ZK_UI_Pack"
                }
            },
            {
                "padding_1": {
                    "type": "panel",
                    "size": [0, 12]
                }
            },
            {
                "label_1@$default_label": {
                    "$line": 1
                }
            },
            {
                "pad_notice": {
                    "type": "panel",
                    "size": [0, 10]
                }
            },
            {
                "label_2@$default_label": {
                    "$line": 2
                }
            },
            {
                "pad_disclaimer": {
                    "type": "panel",
                    "size": [0, 10]
                }
            },
            {
                "disclaimer_text@zk_about_common.generic_label": {
                    "text": "zk.about.disclaimer"
                }
            }
        ]
    },


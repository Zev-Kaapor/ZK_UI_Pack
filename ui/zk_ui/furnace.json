// ZK furnace
{
    "namespace": "zk_furnace",

    // F container item
    "f_container_item@zk_common.guide_container_item": {
        "controls": [
            {
                "hover_text@common.white_border_slot": {
                    "layer": 2,
                    "controls": [
                        {
                            "highlight@common.cell_image": {
                                "texture": "textures/ui/highlight_slot",
                                "size": ["100% - 2px", "100% - 2px"]
                            }
                        },
                        {
                            "text@zk_common.custom_hover_text": {
                                "$hover_text": "('%' + $item_name + '\n\n%zk.burningTime ' + $minutes_burn + '%course.edu.estimatedLength.minutesUnit ' + $seconds_burn + '%course.edu.estimatedLength.secondsUnit\n%zk.noItemsSmeltedPerFuel ' + $items_smelted)"
                            }
                        }
                    ]
                }
            },
            {
                "background_images": {
                    "type": "image",
                    "texture": "textures/ui/recipe_book_item_bg",
                    "layer": 1
                }
            },
            {
                "item_panel": {
                    "type": "panel",
                    "layer": 8,
                    "size": [16, 16],
                    "controls": [
                        {
                            "item_texture": {
                                "ignored": "$use_item_renderer",
                                "type": "image",
                                "texture": "$i_texture",
                                "$i_texture|default": "('textures/items/' + $item_texture)"
                            }
                        },
                        {
                            "item_renderer_panel": {
                                "ignored": "(not $use_item_renderer)",
                                "type": "panel",
                                "controls": [
                                    {
                                        "render@zk_common.item_renderer_off": {}
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "text_label": {
                    "ignored": "(not $show_text_label)",
                    "type": "label",
                    "text": "$text_label",
                    "color": "$item_stack_count_color",
                    "offset": "$text_label_offset",
                    "anchor_to": "$text_label_anchor",
                    "anchor_from": "$text_label_anchor",
                    "font_scale_factor": "$text_font_scale_factor",
                    "layer": 9,
                    "shadow": true
                }
            },
            {
                "additional_control@$additional_control": {}
            }
        ]
    },


// Stonecutter screen
{

    // Arrow icon
    "arrow_icon": {
        "$arrow_alpha|default": 0,
        "$arrow_controls|default": [
            {
                "quick_craft@stonecutter.quick_craft_button": {}
            }
        ],
        "alpha": "$arrow_alpha",
        "controls": "$arrow_controls",
        "variables": [
            {
                "requires": "(not $use_quick_craft_button)",
                "$arrow_alpha": 1,
                "$arrow_controls": []
            }
        ]
    },

    // Quick craft button content
    "quick_craft_button_content": {
        "type": "panel",
        "controls": [
            {
                "arrow_icon_image": {
                    "type": "image",
                    "texture": "textures/ui/arrow_large",
                    "size": [18, 12]
                }
            },
            {
                "hover_text@zk_common.hover_text_panel": {
                    "visible": true,
                    "$hover_text_panel": "zk_container_calc_panels.stonecutter_quick_craft_hover_text_panel"
                }
            }
        ]
    },

    // Quick craft button
    "quick_craft_button@common_buttons.light_content_button": {
        "size": ["100% + 4px", "100% + 4px"],
        "layer": 2,
        "property_bag": {
            "#collection_name": "stonecutter_result_items",
            "#collection_index": 0
        },
        "$button_content": "stonecutter.quick_craft_button_content",
        "$button_tts_header": "container.quickCraft",
        "$pressed_button_name": "button.container_auto_place",
        "button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "double_pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "focused"
            }
        ]
    },

    // Stonecutter screen inventory
    "right_panel": {
        "$container_item_mode_supported": true,
        "$button_ref": "zk_container_item_mode.item_button_ref",
        "$default_mode_controls": "common.container_slot_button_prototype",
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "container_item_mode_switch_panel@zk_container_item_mode.container_item_mode_switch_panel": {
                            "ignored": "$pocket_screen",
                            "$toggle_panel": "zk_container_item_mode.container_item_mode_switch_right_tab",
                            "$panel_anchor_from": "top_right",
                            "$panel_anchor_to": "top_left",
                            "$panel_offset": [-4, 0],
                            "$hover_text_anchor": "right_middle",
                            "$hover_text_offset": [-8, 2]
                        }
                    },
                    {
                        "container_item_type_switch_holder@zk_container_item_mode.container_item_type_switch_holder": {
                            "ignored": "$pocket_screen",
                            "layer": 10,
                            "$toggle_anchor_from": "bottom_right",
                            "$toggle_anchor_to": "bottom_right",
                            "$toggle_offset": [-8, -80]
                        }
                    }
                ]
            }
        ]
    },

    // Stonecutter panel
    "stonecutter_panel": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "item_search_bar@zk_item_search.item_search_bar": {
                            "ignored": "$pocket_screen",
                            "layer": 10
                        }
                    },
                    {
                        "stonecutter_item_count_calc@zk_container_calc_panels.stonecutter_item_count_calc": {
                            "visible": "(not $is_publish or $debug_mode)"
                        }
                    }
                ]
            }
        ]
    }
}
